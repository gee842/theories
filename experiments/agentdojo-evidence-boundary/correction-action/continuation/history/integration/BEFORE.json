  "seven_requirement_and_evidence_cells": [
    [
      " Explain the common foundation ",
      " Informative law conditions and connected mechanisms from organization through significance, externally grounded cognition, learning, selectors, concern and wisdom; necessity claims with explicit quantifiers "
    ],
    [
      " Ground and revise concern ",
      " An account of how another center's consequences enter evaluation, why relevant reasons withstand scrutiny, how errors and new claimants change the account, and where widening fails "
    ],
    [
      " Compose actual mechanisms ",
      " Earlier outputs genuinely supply later material, information, identity, timing, authority and resource inputs; no hidden resets or reward substitution "
    ],
    [
      " Protect futures under changing circumstances ",
      " Continued learning and effective response through target change, scarcity, replacement, lost dependence and changed power; clear limits under infeasible conditions "
    ],
    [
      " Handle plural agency and authority ",
      " Defensible standing, consent and conflict treatment; effective recourse for affected parties; justified limits on both principals and AI action; no equation of system preservation with everyone's future "
    ],
    [
      " Work in learned AI and social arrangements ",
      " Implementations with independently identified inputs and adversarial tests of generalization, oversight, manipulation, capture and replacement, compared with strong matched alternatives "
    ],
    [
      " Establish explanatory and empirical reach ",
      " Discriminating predictions and interventions in materially different systems, calibrated uncertainty, independent review, failed cases and comparison with simpler accounts "
    ]
  ]
}
