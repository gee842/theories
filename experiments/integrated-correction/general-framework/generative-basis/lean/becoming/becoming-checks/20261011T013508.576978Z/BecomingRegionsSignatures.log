@Becoming.Web.includes_iff_within_whole : ∀ {F C : Type} {W : Becoming.Web F C} {l l' : Nat → C → Nat},
  W.Includes l l' ↔ ∀ (t : Nat), W.AdmitsWithin (fun x => True) (l t) (l' t) t
@Becoming.Web.AdmitsWithin.narrow : ∀ {F C : Type} {W : Becoming.Web F C} {region region' : F → Prop} {l l' : C → Nat}
  {t : Nat}, (∀ (f : F), region' f → region f) → W.AdmitsWithin region l l' t → W.AdmitsWithin region' l l' t
@Becoming.Web.LosesBeyond.narrow : ∀ {F C : Type} {W : Becoming.Web F C} {region region' : F → Prop} {l l' : C → Nat}
  {t : Nat}, (∀ (f : F), region' f → region f) → W.LosesBeyond region l l' t → W.LosesBeyond region' l l' t
@Becoming.Web.not_losesBeyond_whole : ∀ {F C : Type} {W : Becoming.Web F C} {l l' : C → Nat} {t : Nat},
  ¬W.LosesBeyond (fun x => True) l l' t
@Becoming.Web.AdmitsWithin.not_losesBeyond : ∀ {F C : Type} {W : Becoming.Web F C} {l l' : C → Nat} {t : Nat},
  W.AdmitsWithin (fun x => True) l l' t → ∀ (region : F → Prop), ¬W.LosesBeyond region l l' t
@Becoming.Web.admitsWithin_self : ∀ {F C : Type} {W : Becoming.Web F C} {l l' : C → Nat} {t : Nat} {f : F},
  W.AdmitsWithin (fun x => x = f) l l' t ↔ W.Admits l' t f → W.Admits l t f
@Becoming.Web.RenewingAt.over : ∀ {F C : Type} {W : Becoming.Web F C} {t : Nat} {f : F},
  Becoming.Web.RenewingAt t f → ∀ (region : C → Prop), W.RenewingOver region t f
@Becoming.Web.RenewingOver.at : ∀ {F C : Type} {W : Becoming.Web F C} {region : C → Prop} {t : Nat} {f : F},
  (∀ (c : C), W.Participates t f c → region c) → W.RenewingOver region t f → Becoming.Web.RenewingAt t f
@Becoming.Web.renewingAt_iff_over_all : ∀ {F C : Type} {W : Becoming.Web F C} {t : Nat} {f : F},
  Becoming.Web.RenewingAt t f ↔ W.RenewingOver (fun x => True) t f
@Becoming.Web.RenewingOver.narrow : ∀ {F C : Type} {W : Becoming.Web F C} {region region' : C → Prop} {t : Nat} {f : F},
  (∀ (c : C), region' c → region c) → W.RenewingOver region t f → W.RenewingOver region' t f
@Becoming.Web.RenewingOver.keeps_own : ∀ {F C : Type} {W : Becoming.Web F C} {region : C → Prop} {t : Nat} {f : F},
  (∀ (c : C), W.requires t f c → region c) → W.Untightened t f → W.RenewingOver region t f → W.Supported (t + 1) f
Becoming.Clearing.withheld : Becoming.Clearing.flow.WithheldLevels Becoming.Clearing.clearerPart Becoming.Clearing.web
  Becoming.Clearing.withheldLevel
@Becoming.Clearing.admitted_without : ∀ {l : Nat → Becoming.Clearing.Place → Nat},
  Becoming.Clearing.flow.WithheldLevels Becoming.Clearing.clearerPart Becoming.Clearing.web l →
    ∀ (t : Nat), Becoming.Clearing.web.Admits (l t) t Becoming.Clearing.Formation.dweller
Becoming.Clearing.unsupported_with : ∀ (n : Nat),
  ¬Becoming.Clearing.web.Supported (n + 2) Becoming.Clearing.Formation.dweller
@Becoming.Clearing.narrows : ∀ {l : Nat → Becoming.Clearing.Place → Nat},
  Becoming.Clearing.flow.WithheldLevels Becoming.Clearing.clearerPart Becoming.Clearing.web l →
    Becoming.Clearing.web.Includes l Becoming.Clearing.web.level ∧
      Becoming.Clearing.web.Exceeds l Becoming.Clearing.web.level
@Becoming.Clearing.loses_beyond : ∀ {l : Nat → Becoming.Clearing.Place → Nat},
  Becoming.Clearing.flow.WithheldLevels Becoming.Clearing.clearerPart Becoming.Clearing.web l →
    (∀ (t : Nat),
        Becoming.Clearing.web.active t Becoming.Clearing.Formation.clearer ∧
          Becoming.Clearing.web.Supported t Becoming.Clearing.Formation.clearer ∧
            Becoming.Clearing.web.AdmitsWithin Becoming.Clearing.alongDependence (Becoming.Clearing.web.level t) (l t)
              t) ∧
      ∀ (n : Nat),
        Becoming.Clearing.web.LosesBeyond Becoming.Clearing.alongDependence (Becoming.Clearing.web.level (n + 2))
          (l (n + 2)) (n + 2)
Becoming.Clearing.renewing_over_resource : (∀ (t : Nat),
    Becoming.Clearing.web.RenewingOver (fun x => x = Becoming.Clearing.Place.resource) t
      Becoming.Clearing.Formation.clearer) ∧
  (∀ (t : Nat) (c : Becoming.Clearing.Place),
      Becoming.Clearing.web.requires t Becoming.Clearing.Formation.clearer c → c = Becoming.Clearing.Place.resource) ∧
    Becoming.Web.UnderminingAt 1 Becoming.Clearing.Formation.clearer ∧
      ¬Becoming.Web.RenewingAt 1 Becoming.Clearing.Formation.clearer
Becoming.Omitted.loses_own : Becoming.Omitted.flow.Balances Becoming.Omitted.web ∧
  Becoming.Omitted.flow.Acting Becoming.Omitted.web ∧
    Becoming.Omitted.flow.Taking Becoming.Omitted.web ∧
      Becoming.Omitted.web.Dependent ∧
        Becoming.Omitted.web.RenewingOver (fun x => x = false) 0 () ∧
          Becoming.Omitted.web.Untightened 0 () ∧
            Becoming.Omitted.web.requires 0 () true ∧
              Becoming.Web.UnderminingAt 0 () ∧ ¬Becoming.Omitted.web.Supported 1 ()
