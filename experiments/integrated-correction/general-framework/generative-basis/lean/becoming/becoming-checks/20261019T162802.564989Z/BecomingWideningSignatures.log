@Becoming.Widening.orbit_of_fixed : ∀ {f : Nat → Nat} {v : Nat},
  f v = v → ∀ (n : Nat), (Becoming.Law.run f v).state n = v
@Becoming.Widening.stays_from_fixed : ∀ {f : Nat → Nat} {d k : Nat},
  f ((Becoming.Law.run f d).state k) = (Becoming.Law.run f d).state k →
    ∀ {n : Nat}, k ≤ n → (Becoming.Law.run f d).state n = (Becoming.Law.run f d).state k
@Becoming.Widening.eq_zero_of_add_le : ∀ {a b : Nat}, a + b ≤ b → a = 0
@Becoming.Widening.sub_eq_zero_of_le : ∀ {n m : Nat}, n ≤ m → n - m = 0
@Becoming.Widening.sub_pos_of_lt : ∀ {a b : Nat}, a < b → 0 < b - a
Becoming.Widening.one_pow : ∀ (n : Nat), 1 ^ n = 1
@Becoming.Widening.kept_of_identity : ∀ {f : Nat → Nat},
  (∀ (x : Nat), f x = x) → ∀ (d n : Nat), (Becoming.Law.run f d).state n = d
@Becoming.Widening.returnMap_of_identity : ∀ {links : List (Nat → Nat)},
  (∀ (g : Nat → Nat), g ∈ links → ∀ (x : Nat), g x = x) → ∀ (x : Nat), Becoming.Widening.returnMap links x = x
@Becoming.Widening.loop_kept : ∀ {links : List (Nat → Nat)},
  (∀ (g : Nat → Nat), g ∈ links → ∀ (x : Nat), g x = x) →
    ∀ (d n : Nat), (Becoming.Law.run (Becoming.Widening.returnMap links) d).state n = d
@Becoming.Widening.returnMap_ge : ∀ {links : List (Nat → Nat)},
  (∀ (g : Nat → Nat), g ∈ links → ∀ (x : Nat), x ≤ g x) → ∀ (x : Nat), x ≤ Becoming.Widening.returnMap links x
@Becoming.Widening.orbit_ge_of_ge : ∀ {f : Nat → Nat},
  (∀ (x : Nat), x ≤ f x) → ∀ (d n : Nat), d ≤ (Becoming.Law.run f d).state n
@Becoming.Widening.never_closes_of_no_less : ∀ {links : List (Nat → Nat)},
  (∀ (g : Nat → Nat), g ∈ links → ∀ (x : Nat), x ≤ g x) →
    ∀ (d n : Nat), d ≤ (Becoming.Law.run (Becoming.Widening.returnMap links) d).state n
@Becoming.Widening.below_of_falls : ∀ {f : Nat → Nat} {d n : Nat}, (Becoming.Law.run f d).state n < d → ∃ y, f y < y
@Becoming.Widening.link_below_of_below : ∀ {links : List (Nat → Nat)} {x : Nat},
  Becoming.Widening.returnMap links x < x → ∃ g, g ∈ links ∧ ∃ y, g y < y
@Becoming.Widening.closing_needs_less : ∀ {links : List (Nat → Nat)} {d n : Nat},
  (Becoming.Law.run (Becoming.Widening.returnMap links) d).state n < d → ∃ g, g ∈ links ∧ ∃ x, g x < x
@Becoming.Widening.difference_variant : ∀ {f : Nat → Nat},
  (∀ (x : Nat), 0 < x → f x < x) →
    ∀ (d : Nat), Becoming.Lasting.Variant (Becoming.Lasting.determined f) (fun x => True) (fun x => x = 0) d id
@Becoming.Widening.closes_within : ∀ {f : Nat → Nat},
  f 0 = 0 →
    (∀ (x : Nat), 0 < x → f x < x) →
      ∀ (d : Nat), (Becoming.Law.run f d).state d = 0 ∧ ∀ (n : Nat), d ≤ n → (Becoming.Law.run f d).state n = 0
@Becoming.Widening.orbit_sub_const : ∀ {f : Nat → Nat} {c : Nat},
  (∀ (x : Nat), f x = x - c) → ∀ (d n : Nat), (Becoming.Law.run f d).state n = d - n * c
@Becoming.Widening.sub_const_closes : ∀ {f : Nat → Nat} {c d n : Nat},
  (∀ (x : Nat), f x = x - c) → d ≤ n * c → (Becoming.Law.run f d).state n = 0
@Becoming.Widening.sub_const_open : ∀ {f : Nat → Nat} {c d n : Nat},
  (∀ (x : Nat), f x = x - c) → n * c < d → 0 < (Becoming.Law.run f d).state n
Becoming.Widening.closes_within_exact : Nat.pred 0 = 0 ∧
  (∀ (x : Nat), 0 < x → x.pred < x) ∧ ∀ (d n : Nat), n < d → 0 < (Becoming.Law.run Nat.pred d).state n
@Becoming.Widening.last_positive : ∀ {f : Nat → Nat} {d : Nat},
  0 < d →
    ∀ {n : Nat},
      (Becoming.Law.run f d).state n = 0 →
        ∃ k, 0 < (Becoming.Law.run f d).state k ∧ (Becoming.Law.run f d).state (k + 1) = 0
@Becoming.Widening.closing_merges : ∀ {f : Nat → Nat} {d n : Nat},
  f 0 = 0 → (Becoming.Law.run f d).state n = 0 → 0 < d → Becoming.Law.Merges f
@Becoming.Widening.closing_not_lossless : ∀ {f : Nat → Nat} {d n : Nat},
  f 0 = 0 → (Becoming.Law.run f d).state n = 0 → 0 < d → ¬Becoming.Law.Lossless f
@Becoming.Widening.returnMap_zero : ∀ {links : List (Nat → Nat)},
  (∀ (g : Nat → Nat), g ∈ links → g 0 = 0) → Becoming.Widening.returnMap links 0 = 0
@Becoming.Widening.returnMap_cut : ∀ {c : Nat → Nat},
  (∀ (x : Nat), c x = 0) →
    ∀ (pre : List (Nat → Nat)) {post : List (Nat → Nat)},
      (∀ (g : Nat → Nat), g ∈ post → g 0 = 0) → ∀ (x : Nat), Becoming.Widening.returnMap (pre ++ c :: post) x = 0
@Becoming.Widening.cut_closes : ∀ {c : Nat → Nat},
  (∀ (x : Nat), c x = 0) →
    ∀ (pre : List (Nat → Nat)) {post : List (Nat → Nat)},
      (∀ (g : Nat → Nat), g ∈ post → g 0 = 0) →
        ∀ (d n : Nat), (Becoming.Law.run (Becoming.Widening.returnMap (pre ++ c :: post)) d).state (n + 1) = 0
Becoming.Widening.cut_reopened : ∀ (d n : Nat),
  (Becoming.Law.run (Becoming.Widening.returnMap [fun x => 0, Nat.succ]) d).state (n + 1) = 1
@Becoming.Widening.never_rises : ∀ {f : Nat → Nat},
  (∀ (x y : Nat), x ≤ y → f x ≤ f y) →
    ∀ {d : Nat}, f d ≤ d → ∀ (n : Nat), (Becoming.Law.run f d).state (n + 1) ≤ (Becoming.Law.run f d).state n
@Becoming.Widening.never_falls : ∀ {f : Nat → Nat},
  (∀ (x y : Nat), x ≤ y → f x ≤ f y) →
    ∀ {d : Nat}, d ≤ f d → ∀ (n : Nat), (Becoming.Law.run f d).state n ≤ (Becoming.Law.run f d).state (n + 1)
@Becoming.Widening.settled_or_fallen : ∀ {f : Nat → Nat},
  (∀ (x y : Nat), x ≤ y → f x ≤ f y) →
    ∀ {d : Nat},
      f d ≤ d →
        ∀ (n : Nat),
          (∃ k, k ≤ n ∧ f ((Becoming.Law.run f d).state k) = (Becoming.Law.run f d).state k) ∨
            (Becoming.Law.run f d).state n + n ≤ d
@Becoming.Widening.settles_within : ∀ {f : Nat → Nat},
  (∀ (x y : Nat), x ≤ y → f x ≤ f y) →
    ∀ {d : Nat},
      f d ≤ d →
        ∃ k,
          k ≤ d ∧
            f ((Becoming.Law.run f d).state k) = (Becoming.Law.run f d).state k ∧
              ∀ (n : Nat), k ≤ n → (Becoming.Law.run f d).state n = (Becoming.Law.run f d).state k
Becoming.Widening.settles_within_exact : (∀ (x y : Nat), x ≤ y → x.pred ≤ y.pred) ∧
  (∀ (d : Nat), d.pred ≤ d) ∧
    ∀ (d n : Nat), n < d → ((Becoming.Law.run Nat.pred d).state n).pred ≠ (Becoming.Law.run Nat.pred d).state n
@Becoming.Widening.returnMap_doubles : ∀ {g : Nat → Nat} {gs : List (Nat → Nat)},
  (∀ (h : Nat → Nat), h ∈ g :: gs → ∀ (x : Nat), x + x ≤ h x) →
    ∀ (x : Nat), x + x ≤ Becoming.Widening.returnMap (g :: gs) x
Becoming.Widening.two_pow_succ_mul : ∀ (n d : Nat), 2 ^ (n + 1) * d = 2 ^ n * d + 2 ^ n * d
@Becoming.Widening.runs_away : ∀ {g : Nat → Nat} {gs : List (Nat → Nat)},
  (∀ (h : Nat → Nat), h ∈ g :: gs → ∀ (x : Nat), x + x ≤ h x) →
    ∀ (d n : Nat), 2 ^ n * d ≤ (Becoming.Law.run (Becoming.Widening.returnMap (g :: gs)) d).state n
@Becoming.Widening.lt_two_pow_mul : ∀ {d : Nat}, 0 < d → ∀ (n : Nat), n < 2 ^ n * d
@Becoming.Widening.runs_away_unbounded : ∀ {g : Nat → Nat} {gs : List (Nat → Nat)},
  (∀ (h : Nat → Nat), h ∈ g :: gs → ∀ (x : Nat), x + x ≤ h x) →
    ∀ {d : Nat}, 0 < d → ∀ (B : Nat), ∃ n, B < (Becoming.Law.run (Becoming.Widening.returnMap (g :: gs)) d).state n
Becoming.Widening.orbit_doubling : ∀ (d n : Nat),
  (Becoming.Law.run (Becoming.Widening.returnMap [fun x => x + x]) d).state n = 2 ^ n * d
Becoming.Widening.doubling_exact : (∀ (h : Nat → Nat), h ∈ [fun x => x + x] → ∀ (x : Nat), x + x ≤ h x) ∧
  ∀ (d n : Nat), (Becoming.Law.run (Becoming.Widening.returnMap [fun x => x + x]) d).state n = 2 ^ n * d
Becoming.Widening.empty_loop_kept : ∀ (d n : Nat), (Becoming.Law.run (Becoming.Widening.returnMap []) d).state n = d
Becoming.Widening.returnMap_scaling : ∀ (as : List Nat) (x : Nat),
  Becoming.Widening.returnMap (Becoming.Widening.scaling as) x = Becoming.Widening.strength as * x
Becoming.Widening.orbit_scaling : ∀ (as : List Nat) (d n : Nat),
  (Becoming.Law.run (Becoming.Widening.returnMap (Becoming.Widening.scaling as)) d).state n =
    Becoming.Widening.strength as ^ n * d
Becoming.Widening.whole_strengths : ∀ (as : List Nat) (d : Nat),
  (Becoming.Widening.strength as = 0 →
      ∀ (n : Nat),
        (Becoming.Law.run (Becoming.Widening.returnMap (Becoming.Widening.scaling as)) d).state (n + 1) = 0) ∧
    (Becoming.Widening.strength as = 1 →
        ∀ (n : Nat), (Becoming.Law.run (Becoming.Widening.returnMap (Becoming.Widening.scaling as)) d).state n = d) ∧
      (2 ≤ Becoming.Widening.strength as →
        0 < d →
          ∀ (B : Nat),
            ∃ n, B < (Becoming.Law.run (Becoming.Widening.returnMap (Becoming.Widening.scaling as)) d).state n)
Becoming.Widening.nothing_between : ∀ (as : List Nat) (d n : Nat),
  (Becoming.Law.run (Becoming.Widening.returnMap (Becoming.Widening.scaling as)) d).state (n + 1) = 0 ∨
    (Becoming.Law.run (Becoming.Widening.returnMap (Becoming.Widening.scaling as)) d).state n ≤
      (Becoming.Law.run (Becoming.Widening.returnMap (Becoming.Widening.scaling as)) d).state (n + 1)
Becoming.Widening.gradual_needs_another_link : (∀ (as : List Nat) (d n : Nat),
    ¬(0 < (Becoming.Law.run (Becoming.Widening.returnMap (Becoming.Widening.scaling as)) d).state (n + 1) ∧
        (Becoming.Law.run (Becoming.Widening.returnMap (Becoming.Widening.scaling as)) d).state (n + 1) <
          (Becoming.Law.run (Becoming.Widening.returnMap (Becoming.Widening.scaling as)) d).state n)) ∧
  0 < (Becoming.Law.run (Becoming.Widening.returnMap [fun x => x - 1]) 2).state 1 ∧
    (Becoming.Law.run (Becoming.Widening.returnMap [fun x => x - 1]) 2).state 1 <
      (Becoming.Law.run (Becoming.Widening.returnMap [fun x => x - 1]) 2).state 0
