  {W W' : Becoming.Web F C} {obs : F → C → Prop} {select : (Nat → C → Nat) → Prop} {f : F},
  (∀ (t : Nat) (g : F) (c : C),
      Becoming.WithinClosure (L.RegisteredFromEither W L' obs) f g → W.Registers obs g c → L.BalancesOn W [c] t) →
    (∀ (t : Nat) (g : F) (c : C),
        Becoming.WithinClosure (L.RegisteredFromEither W L' obs) f g → W.Registers obs g c → L'.BalancesOn W' [c] t) →
      (∀ (t : Nat), L.present t = L'.present t) →
        (∀ (g : F),
            Becoming.WithinClosure (L.RegisteredFromEither W L' obs) f g →
              ∀ (c : C), W.Registers obs g c → W.level 0 c = W'.level 0 c) →
          (∀ (h : F),
              Becoming.WithinClosure (L.RegisteredFromEither W L' obs) f h →
                ∀ (t : Nat),
                  W.RegistersAlikeUpTo obs h W.level W'.level t →
                    ∀ (g : F) (c : C),
                      Becoming.WithinClosure (L.RegisteredFromEither W L' obs) f g →
                        W.Registers obs g c → L.take t h c = L'.take t h c ∧ L.give t h c = L'.give t h c) →
            ∀ {g : F},
