@Becoming.frame_classification_robust_iff_of_em : ∀ {S A C G N : Type} (F : Becoming.Frame S A C),
  (∀ (p : Prop), Becoming.Decided p) →
    ∀ (g : S → G → Prop) (f : S → N → Prop) (a b : S),
      (∀ (q : N → Prop), ClassificationRobustJudgment.compared F.realized g f q a b) ↔
        PracticalJudgment.Included (f b) (f a) ∧ PracticalJudgment.Better F.realized (ConcernExtension.extend g f) a b
@Becoming.extension_classification_robust : ∀ {S A C G N : Type} (F : Becoming.Frame S A C) (living : C → Prop)
  (g : S → G → Prop) (f : S → N → Prop) {a b : S},
  Becoming.Extension F living b a →
    PracticalJudgment.Included (f b) (f a) →
      ∀ (q : N → Prop), ClassificationRobustJudgment.compared F.realized g f q a b
@Becoming.extension_classification_robust_iff : ∀ {S A C G N : Type} (F : Becoming.Frame S A C) (living : C → Prop)
  (g : S → G → Prop) (f : S → N → Prop) {a b : S},
  Becoming.Extension F living b a →
    ((∀ (q : N → Prop), ClassificationRobustJudgment.compared F.realized g f q a b) ↔
      PracticalJudgment.Included (f b) (f a))
