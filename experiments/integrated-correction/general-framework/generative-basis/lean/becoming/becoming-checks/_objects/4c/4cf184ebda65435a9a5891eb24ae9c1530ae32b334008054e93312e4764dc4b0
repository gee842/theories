Becoming.mul_assoc_nat : ∀ (a b c : Nat), a * b * c = a * (b * c)
@Becoming.le_offspringCount : ∀ {α : Type} {kids : α → List α} {a : Nat} {ps : List α},
  (∀ (p : α), p ∈ ps → a ≤ (kids p).length) → ps.length * a ≤ Becoming.offspringCount ps kids
@Becoming.offspringCount_le : ∀ {α : Type} {kids : α → List α} {b : Nat} {ps : List α},
  (∀ (p : α), p ∈ ps → (kids p).length ≤ b) → Becoming.offspringCount ps kids ≤ ps.length * b
@Becoming.share_not_lower : ∀ {α : Type} {kids : α → List α} {ms es : List α} {a b : Nat},
  (∀ (p : α), p ∈ ms → a ≤ (kids p).length) →
    (∀ (p : α), p ∈ es → (kids p).length ≤ b) →
      b ≤ a → ms.length * Becoming.offspringCount es kids ≤ Becoming.offspringCount ms kids * es.length
@Becoming.share_rises : ∀ {α : Type} {kids : α → List α} {ms es : List α} {a b : Nat},
  (∀ (p : α), p ∈ ms → a ≤ (kids p).length) →
    (∀ (p : α), p ∈ es → (kids p).length ≤ b) →
      b < a →
        0 < ms.length →
          0 < es.length → ms.length * Becoming.offspringCount es kids < Becoming.offspringCount ms kids * es.length
@Becoming.Flow.descent_needs_unrun : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X} {stand : Nat → List X},
  W.StandingCensus stand →
    (∀ (N : Nat), ∃ t, N ≤ t ∧ ∃ x g, L.DescendsAt W t x g) → ∀ (N : Nat), ∃ t, N ≤ t ∧ ¬L.RunsDown W t
@Becoming.Flow.descent_exhausted : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X} {stand : Nat → List X},
  W.StandingCensus stand →
    ∀ {T : Nat}, (∀ (t : Nat), T ≤ t → L.RunsDown W t) → ¬∀ (N : Nat), ∃ t, N ≤ t ∧ ∃ x g, L.DescendsAt W t x g
@Becoming.Law.reform_reabsorbed : ∀ {S : Type u_1} {R : Type u_2} {next : S × R → S × R},
  (∀ (x x' : S) (g : R), next (x, g) = next (x', g)) →
    ∀ (x x' : S) (g : R) (n : Nat), Becoming.Law.orbit next (x, g) (n + 1) = Becoming.Law.orbit next (x', g) (n + 1)
Becoming.Captured.byRule : ∀ (x x' g : Bool), Becoming.Captured.next (x, g) = Becoming.Captured.next (x', g)
Becoming.Captured.state_reform_returns : ∀ (g : Bool) (n : Nat),
  Becoming.Law.orbit Becoming.Captured.next (!g, g) (n + 1) = (g, g) ∧
    Becoming.Law.orbit Becoming.Captured.next (g, g) (n + 1) = (g, g)
Becoming.Captured.rule_reform_changes : ∀ (g : Bool) (n : Nat),
  Becoming.Law.orbit Becoming.Captured.next (g, !g) (n + 1) = (!g, !g)
