@Becoming.Web.interaction_sustenance : ∀ {X Pos : Type} {W : Becoming.Web X X} {own sig : Pos → X × Nat → Prop},
  (W.interaction own sig).Connected → (W.sustenance own sig).Connected
@Becoming.Web.LivesOn.active : ∀ {X : Type} {W : Becoming.Web X X},
  W.Dependent → ∀ {e e' : X × Nat}, W.LivesOn e e' → W.Embodied e'.fst → W.active e.snd e.fst → W.active e.snd e'.fst
@Becoming.Web.living_on_reaches : ∀ {X Pos : Type} {W : Becoming.Web X X} {own sig : Pos → X × Nat → Prop},
  Becoming.Neutral (W.sustenance own sig).transmits →
    ∀ {p : Pos} {e d : X × Nat},
      W.LivesOn e d → (W.sustenance own sig).sig p e → (W.sustenance own sig).living d → (W.sustenance own sig).sig p d
@Becoming.Web.lived_on_reaches : ∀ {X Pos : Type} {W : Becoming.Web X X} {own sig : Pos → X × Nat → Prop},
  Becoming.Neutral (W.sustenance own sig).transmits →
    ∀ {p : Pos} {e d : X × Nat},
      W.LivesOn e d → (W.sustenance own sig).sig p d → (W.sustenance own sig).living e → (W.sustenance own sig).sig p e
@Becoming.Flow.interaction_descent : ∀ {X Pos : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X}
  {own sig : Pos → X × Nat → Prop}, (W.interaction own sig).Connected → (L.descent W own sig).Connected
@Becoming.Flow.descent_reaches : ∀ {X Pos : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X}
  {own sig : Pos → X × Nat → Prop},
  Becoming.Neutral (L.descent W own sig).transmits →
    ∀ {p : Pos} {x g : X},
      L.Descends W x g →
        ∀ {t s : Nat},
          (L.descent W own sig).sig p (g, t) → (L.descent W own sig).living (x, s) → (L.descent W own sig).sig p (x, s)
@Becoming.Flow.ancestry_reaches : ∀ {X Pos : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X}
  {own sig : Pos → X × Nat → Prop},
  Becoming.Neutral (L.descent W own sig).transmits →
    ∀ {p : Pos} {x g : X},
      L.Descends W x g →
        ∀ {t s : Nat},
          (L.descent W own sig).sig p (x, s) → (L.descent W own sig).living (g, t) → (L.descent W own sig).sig p (g, t)
@Becoming.Web.Embodied.descends : ∀ {X : Type} {W : Becoming.Web X X} {L : Becoming.Flow X X},
  L.Balances W →
    L.Acting W → ∀ {x : X}, W.Embodied x → ∀ {t : Nat}, W.Arises t x → ∃ g, W.active t g ∧ g ≠ x ∧ L.Descends W x g
@Becoming.Web.arisen_reached : ∀ {X Pos : Type} {W : Becoming.Web X X} {L : Becoming.Flow X X}
  {own sig : Pos → X × Nat → Prop},
  L.Balances W →
    L.Acting W →
      Becoming.Neutral (L.descent W own sig).transmits →
        ∀ {x : X},
          W.Embodied x →
            ∀ {t : Nat},
              W.Arises t x →
                ∃ g,
                  W.active t g ∧
                    g ≠ x ∧
                      ∀ (p : Pos) (s s' : Nat),
                        (L.descent W own sig).sig p (g, s) →
                          (L.descent W own sig).living (x, s') → (L.descent W own sig).sig p (x, s')
Becoming.Brood.birth_next : ∀ (t : Nat), Becoming.Brood.birth (t + 1) t = 1
Becoming.Brood.descends : ∀ (t : Nat), Becoming.Brood.flow.Descends Becoming.Brood.web (t + 1) t
@Becoming.Brood.alive_of_stands : ∀ {Pos : Type} (own sig : Pos → Nat × Nat → Prop) {e : Nat × Nat},
  0 < Becoming.Brood.standing e.fst e.snd → (Becoming.Brood.flow.descent Becoming.Brood.web own sig).living e
@Becoming.Brood.self_alive : ∀ {Pos : Type} (own sig : Pos → Nat × Nat → Prop) (t : Nat),
  (Becoming.Brood.flow.descent Becoming.Brood.web own sig).living (t, t)
@Becoming.Brood.down : ∀ {Pos : Type} (own sig : Pos → Nat × Nat → Prop) (x s : Nat),
  (Becoming.Brood.flow.descent Becoming.Brood.web own sig).living (x, s) →
    Becoming.Reach (Becoming.Brood.flow.descent Becoming.Brood.web own sig).relations (x, s) (0, 0)
@Becoming.Brood.up : ∀ {Pos : Type} (own sig : Pos → Nat × Nat → Prop) (y s : Nat),
  (Becoming.Brood.flow.descent Becoming.Brood.web own sig).living (y, s) →
    Becoming.Reach (Becoming.Brood.flow.descent Becoming.Brood.web own sig).relations (0, 0) (y, s)
@Becoming.Brood.descent_connected : ∀ {Pos : Type} (own sig : Pos → Nat × Nat → Prop),
  (Becoming.Brood.flow.descent Becoming.Brood.web own sig).Connected
@Becoming.Brood.participates : ∀ {t x c : Nat}, Becoming.Brood.web.Participates t x c → c = x
@Becoming.Brood.not_coparticipating : ∀ {Pos : Type} (own sig : Pos → Nat × Nat → Prop),
  ¬(Becoming.Brood.web.valuation own sig).Connected
@Becoming.Brood.not_interacting : ∀ {Pos : Type} (own sig : Pos → Nat × Nat → Prop),
  ¬(Becoming.Brood.web.interaction own sig).Connected
@Becoming.Brood.descended : ∀ {Pos : Type} (own sig : Pos → Nat × Nat → Prop) (p₀ : Pos),
  (Becoming.Brood.flow.descent Becoming.Brood.web own sig).Connected ∧
    ¬(Becoming.Brood.web.valuation own sig).Connected ∧
      ¬(Becoming.Brood.web.interaction own sig).Connected ∧
        ((Becoming.Brood.flow.descent Becoming.Brood.web own sig).Significant ↔
          (Becoming.Brood.flow.descent Becoming.Brood.web own sig).Grounds)
@Becoming.Mutualism.apart_sustenance_connected : ∀ {Pos : Type}
  (own sig : Pos → Becoming.Mutualism.Relatum × Nat → Prop), (Becoming.Mutualism.apart.sustenance own sig).Connected
Becoming.Mutualism.other_other : ∀ (x : Becoming.Mutualism.Relatum),
  Becoming.Mutualism.other (Becoming.Mutualism.other x) = x
@Becoming.Mutualism.relabel_sustenance : ∀ {Pos : Type} (own sig : Pos → Becoming.Mutualism.Relatum × Nat → Prop),
  (((Becoming.Mutualism.apart.relabel Becoming.Mutualism.other).valuation own sig).Connected ↔
      (Becoming.Mutualism.apart.valuation own sig).Connected) ∧
    (((Becoming.Mutualism.apart.relabel Becoming.Mutualism.other).interaction own sig).Connected ↔
        (Becoming.Mutualism.apart.interaction own sig).Connected) ∧
      (Becoming.Mutualism.apart.sustenance own sig).Connected ∧
        ¬((Becoming.Mutualism.apart.relabel Becoming.Mutualism.other).sustenance own sig).Connected
Becoming.Provisioned.descends : Becoming.Provisioned.flow.Descends Becoming.Provisioned.web
    Becoming.Provisioned.Relatum.seed Becoming.Provisioned.Relatum.parent ∧
  Becoming.Provisioned.web.Arises 1 Becoming.Provisioned.Relatum.seed ∧
    Becoming.Provisioned.flow.given 1 Becoming.Provisioned.Relatum.seed = 0
