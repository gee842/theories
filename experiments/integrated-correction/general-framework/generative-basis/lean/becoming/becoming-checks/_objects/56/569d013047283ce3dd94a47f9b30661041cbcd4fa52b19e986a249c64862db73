@Becoming.Flow.inward_iff_not_fed : ∀ {F C : Type} {L : Becoming.Flow F C} [DecidableEq C] {ds : List C} {t : Nat},
  L.Inward ds t ↔ ¬L.FedFromBeyond ds t
@Becoming.Flow.fed_of_not_inward : ∀ {F C : Type} {L : Becoming.Flow F C} [DecidableEq C] {ds : List C} {N : Nat},
