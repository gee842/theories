@Becoming.Flow.fed_from_beyond : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} [DecidableEq C],
  L.Balances W →
    L.Dissipative →
      ∀ {ds : List C},
        Becoming.Distinct ds →
          ∀ {T₀ : Nat},
            (∀ (t : Nat), T₀ ≤ t → L.Around ds t) →
              (∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < L.takers ds t) → ∀ (N : Nat), ¬∀ (t : Nat), N ≤ t → ¬L.FedFromBeyond ds t
@Becoming.Flow.rising_fed_from_beyond : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} [DecidableEq C],
  L.Balances W →
    L.Dissipative →
      ∀ {ds : List C},
        Becoming.Distinct ds →
          ∀ {T₀ : Nat},
            (∀ (t : Nat), T₀ ≤ t → L.Around ds t) →
              (∀ (N : Nat), ∃ t c, N ≤ t ∧ c ∈ ds ∧ W.Rises t c) →
                ∀ (N : Nat), ¬∀ (t : Nat), N ≤ t → ¬L.FedFromBeyond ds t
@Becoming.Flow.joint_keeps : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W → ∀ {t : Nat} {c : C}, L.WithinJoint t c → W.level t c ≤ W.level (t + 1) c
@Becoming.Flow.excess_lowers : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W → ∀ {t : Nat} {c : C}, L.given t c < L.taken t c → W.level (t + 1) c + 1 ≤ W.level t c
@Becoming.Flow.excess_bounded : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    ∀ {c : C} {T : Nat} (n : Nat),
      (∀ (k : Nat), k < n → L.given (T + k) c < L.taken (T + k) c) → W.level (T + n) c + n ≤ W.level T c
@Becoming.Flow.stays_below : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {c : C} {m : Nat},
          (∀ (t : Nat) (f : F), f ∈ L.present t → 0 < L.give t f c → W.requires t f c ∧ m ≤ W.need t f c) →
            ∀ {T : Nat}, W.level T c < m → ∀ (n : Nat), W.level (T + n) c < m
@Becoming.Flow.ends_below : ∀ {F C : Type} {W : Becoming.Web F C},
  W.Dependent →
    ∀ {c : C} {m T : Nat},
      (∀ (n : Nat), W.level (T + n) c < m) →
        ∀ (n : Nat) (g : F), W.requires (T + n) g c → m ≤ W.need (T + n) g c → ¬W.active (T + n) g
@Becoming.Flow.joint_excess_ends : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {c : C} {m : Nat},
          (∀ (t : Nat) (f : F), f ∈ L.present t → 0 < L.give t f c → W.requires t f c ∧ m ≤ W.need t f c) →
            ∀ {T n : Nat},
              (∀ (k : Nat), k < n → L.given (T + k) c < L.taken (T + k) c) →
                W.level T c < n + m →
                  ∀ (k : Nat) (g : F), W.requires (T + n + k) g c → m ≤ W.need (T + n + k) g c → ¬W.active (T + n + k) g
@Becoming.Web.generation_fed_from_beyond : ∀ {X : Type} {W : Becoming.Web X X} {L : Becoming.Flow X X} [DecidableEq X],
  L.Balances W →
    L.Dissipative →
      ∀ {ds : List X},
        Becoming.Distinct ds →
          ∀ {T₀ : Nat},
            (∀ (t : Nat), T₀ ≤ t → L.Around ds t) →
              (∀ (N : Nat), ∃ t x, N ≤ t ∧ x ∈ ds ∧ W.Embodied x ∧ W.Arises t x) →
                ∀ (N : Nat), ¬∀ (t : Nat), N ≤ t → ¬L.FedFromBeyond ds t
