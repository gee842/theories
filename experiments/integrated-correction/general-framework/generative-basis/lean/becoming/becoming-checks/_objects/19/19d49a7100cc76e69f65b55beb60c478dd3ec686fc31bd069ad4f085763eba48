  L.Balances W →
    L.Dissipative →
      ∀ {ds : List X},
        Becoming.Distinct ds →
          (∀ (N : Nat), ∃ t x, N ≤ t ∧ x ∈ ds ∧ W.Embodied x ∧ W.Arises t x) →
            ∀ (T : Nat), ¬∀ (t : Nat), T ≤ t → L.ClosedAt ds t
