  L.Balances W →
    ∀ {cs : List X},
      (∀ (N : Nat), ∃ t x, N ≤ t ∧ x ∈ cs ∧ W.Embodied x ∧ W.Arises t x) →
        ∀ (T : Nat), ¬∀ (t : Nat), T ≤ t → L.replenishment cs t = 0
@Becoming.Web.Embodied.arising_lowers : ∀ {X : Type} {W : Becoming.Web X X} {L : Becoming.Flow X X},
  L.Balances W →
    L.Dissipative →
      ∀ {ds : List X},
        Becoming.Distinct ds →
          ∀ {t : Nat},
            L.ClosedAt ds t → ∀ {x : X}, W.Embodied x → x ∈ ds → W.Arises t x → W.stock ds (t + 1) < W.stock ds t
