  (∀ (a b c : V), rel a b → rel b c → rel a c) →
    (∀ (a b : V), rel a b → rel (g a) (g b)) →
      ∀ {R : S → Prop} {q : S → V},
        (∀ (x : S) (a : A), adm a → R x → rel (q (f x a)) (g (q x))) →
          ∀ {θ : V} {k : Nat} {x : S} {a : A},
