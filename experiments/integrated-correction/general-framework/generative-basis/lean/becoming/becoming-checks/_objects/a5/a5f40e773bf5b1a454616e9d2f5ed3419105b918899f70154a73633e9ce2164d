@Becoming.ceasing_step : ∀ {p : Nat → Prop} [DecidablePred p] {T t : Nat},
  T ≤ t → p T → ¬p t → ∃ s, T ≤ s ∧ s < t ∧ p s ∧ ¬p (s + 1)
Becoming.Substitution.web_dependent : ∀ (L : RelationalRenewal.Law), (Becoming.Substitution.web L).Dependent
Becoming.Substitution.persists_consuming : ∀ (L : RelationalRenewal.Law),
  0 < L.needG →
    0 < L.needF →
      L.needF ≤ L.needG →
        L.needF ≤ L.start →
          (∀ (t : Nat), L.renew + L.contrib t < L.draw t) →
            (Becoming.Substitution.web L).Dependent ∧
              (∀ (t : Nat), (Becoming.Substitution.web L).active t RelationalRenewal.Law.Part.focal) ∧
                (∃ s,
                    (Becoming.Substitution.web L).Dissolves s RelationalRenewal.Law.Part.focal
                        Becoming.Substitution.Source.shared ∧
                      (Becoming.Substitution.web L).Forms s RelationalRenewal.Law.Part.focal
                        Becoming.Substitution.Source.alternative) ∧
                  (Becoming.Substitution.web L).ConsumingIn RelationalRenewal.Law.Part.focal ∧
                    ∃ T,
                      ∀ (t : Nat), T ≤ t → ¬(Becoming.Substitution.web L).active t RelationalRenewal.Law.Part.sustaining
Becoming.Substitution.extracting_persists_consuming : (Becoming.Substitution.web
      Becoming.Substitution.extracting).Dependent ∧
  (∀ (t : Nat),
      (Becoming.Substitution.web Becoming.Substitution.extracting).active t RelationalRenewal.Law.Part.focal) ∧
    (∃ s,
        (Becoming.Substitution.web Becoming.Substitution.extracting).Dissolves s RelationalRenewal.Law.Part.focal
            Becoming.Substitution.Source.shared ∧
          (Becoming.Substitution.web Becoming.Substitution.extracting).Forms s RelationalRenewal.Law.Part.focal
            Becoming.Substitution.Source.alternative) ∧
      (Becoming.Substitution.web Becoming.Substitution.extracting).ConsumingIn RelationalRenewal.Law.Part.focal ∧
        ∃ T,
          ∀ (t : Nat),
            T ≤ t →
              ¬(Becoming.Substitution.web Becoming.Substitution.extracting).active t
                  RelationalRenewal.Law.Part.sustaining
Becoming.Substitution.extracting_low : ∀ (n : Nat), Becoming.Substitution.extracting.level (n + 3) = 0
Becoming.Substitution.stepwise_credits_substitution : (Becoming.Substitution.web
        Becoming.Substitution.extracting).ConsumingIn
    RelationalRenewal.Law.Part.focal ∧
  (∀ (t : Nat),
      t ≠ 2 →
        (Becoming.Substitution.web Becoming.Substitution.extracting).active t RelationalRenewal.Law.Part.focal ∧
          ¬Becoming.Web.UnderminingAt t RelationalRenewal.Law.Part.focal) ∧
    Becoming.Web.UnderminingAt 2 RelationalRenewal.Law.Part.focal
