@Becoming.Readout.reading_single_iff : ∀ {S : Type u_1} {K : Type u_2} {V : Type u_3} {π : S → K} {f : S → V},
  Becoming.Readout.SingleValued (Becoming.Readout.Reading π f) ↔ Becoming.Learning.Lumped π f
@Becoming.Readout.lumped_of_decodes : ∀ {S : Type u_1} {K : Type u_2} {V : Type u_3} {π : S → K} {f : S → V}
  {g : K → V}, Becoming.Readout.Decodes π f g → Becoming.Learning.Lumped π f
@Becoming.Readout.decodes_iff_of_section : ∀ {S : Type u_1} {K : Type u_2} {V : Type u_3} {π : S → K} {f : S → V}
  (sec : K → S), (∀ (k : K), π (sec k) = k) → ((∃ g, Becoming.Readout.Decodes π f g) ↔ Becoming.Learning.Lumped π f)
@Becoming.Readout.decoder_pair_iff : ∀ {S : Type u_1} {K : Type u_2} {V : Type u_3} {π : S → K} {f : S → V} {s s' : S},
  π s = π s' → ((∃ g, g (π s) = f s ∧ g (π s') = f s') ↔ f s = f s')
@Becoming.Readout.no_restore : ∀ {S : Type u_1} {K : Type u_2} {π : S → K} {s s' : S},
  π s = π s' → s ≠ s' → ¬∃ restore, restore (π s) = s ∧ restore (π s') = s'
@Becoming.Readout.law_through_iff : ∀ {S : Type u_1} {K : Type u_2} {A : Type u_3} (next : S → A → S) (π : S → K),
  (∃ Q, Becoming.Determined Q ∧ Becoming.FactorsThrough (Becoming.Assurance.ofMap next) π Q) ↔
    ∀ (s s' : S) (a : A), π s = π s' → π (next s a) = π (next s' a)
@Becoming.Readout.foldl_semiconj : ∀ {S : Type u_1} {K : Type u_2} {A : Type u_3} (next : S → A → S) (π : S → K)
  (reduced : K → A → K),
  (∀ (s : S) (a : A), π (next s a) = reduced (π s) a) →
    ∀ (plan : List A) (s : S), π (List.foldl next s plan) = List.foldl reduced (π s) plan
