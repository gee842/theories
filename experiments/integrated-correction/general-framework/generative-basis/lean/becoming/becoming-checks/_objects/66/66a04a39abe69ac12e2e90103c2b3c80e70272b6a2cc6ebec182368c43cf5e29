Becoming.RepairComparison.fragile_focal_keeps_backbone : (Becoming.RepairComparison.frame true).realized
  (Becoming.RepairComparison.finalState true Becoming.RepairComparison.Repair.focal)
  Becoming.RepairComparison.Claim.backbone
Becoming.RepairComparison.fragile_three_not_matching : ¬(Becoming.RepairComparison.frame true).StrictLossMatch
    Becoming.RepairComparison.sameEpisode
    (Becoming.RepairComparison.finalState true Becoming.RepairComparison.Repair.three)
    (Becoming.RepairComparison.finalState true Becoming.RepairComparison.Repair.focal)
