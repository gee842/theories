Becoming.Dawn.never_ceases : ∀ (t f : Nat), ¬Becoming.Dawn.web.Ceases t f
Becoming.Dawn.rises : ∀ (t : Nat), Becoming.Dawn.web.Rises t ()
Becoming.Dawn.never_falls : ∀ (t : Nat), ¬Becoming.Dawn.web.Falls t ()
Becoming.Dusk.ceasing : ∀ (N : Nat), ∃ t f, N ≤ t ∧ Becoming.Dusk.web.Ceases t f
Becoming.Dusk.nothing_arises : ∀ (t f : Nat), ¬Becoming.Dusk.web.Arises t f
