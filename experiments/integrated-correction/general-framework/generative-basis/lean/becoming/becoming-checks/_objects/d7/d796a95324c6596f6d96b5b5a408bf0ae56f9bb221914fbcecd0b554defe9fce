@Becoming.Readout.reading_single_iff : ∀ {S : Type u_1} {K : Type u_2} {V : Type u_3} {π : S → K} {f : S → V},
  Becoming.Readout.SingleValued (Becoming.Readout.Reading π f) ↔ Becoming.Learning.Lumped π f
@Becoming.Readout.lumped_of_decodes : ∀ {S : Type u_1} {K : Type u_2} {V : Type u_3} {π : S → K} {f : S → V}
  {g : K → V}, Becoming.Readout.Decodes π f g → Becoming.Learning.Lumped π f
@Becoming.Readout.decodes_iff_of_section : ∀ {S : Type u_1} {K : Type u_2} {V : Type u_3} {π : S → K} {f : S → V}
  (sec : K → S), (∀ (k : K), π (sec k) = k) → ((∃ g, Becoming.Readout.Decodes π f g) ↔ Becoming.Learning.Lumped π f)
@Becoming.Readout.decoder_pair_iff : ∀ {S : Type u_1} {K : Type u_2} {V : Type u_3} {π : S → K} {f : S → V} {s s' : S},
  π s = π s' → ((∃ g, g (π s) = f s ∧ g (π s') = f s') ↔ f s = f s')
@Becoming.Readout.no_restore : ∀ {S : Type u_1} {K : Type u_2} {π : S → K} {s s' : S},
  π s = π s' → s ≠ s' → ¬∃ restore, restore (π s) = s ∧ restore (π s') = s'
@Becoming.Readout.law_through_iff : ∀ {S : Type u_1} {K : Type u_2} {A : Type u_3} (next : S → A → S) (π : S → K),
  (∃ Q, Becoming.Determined Q ∧ Becoming.FactorsThrough (Becoming.Assurance.ofMap next) π Q) ↔
    ∀ (s s' : S) (a : A), π s = π s' → π (next s a) = π (next s' a)
@Becoming.Readout.foldl_semiconj : ∀ {S : Type u_1} {K : Type u_2} {A : Type u_3} (next : S → A → S) (π : S → K)
  (reduced : K → A → K),
  (∀ (s : S) (a : A), π (next s a) = reduced (π s) a) →
    ∀ (plan : List A) (s : S), π (List.foldl next s plan) = List.foldl reduced (π s) plan
@Becoming.Readout.image_feasible : ∀ {S : Type u_1} {K : Type u_2} {A : Type u_3} {P : Generative.Process S A}
  {π : S → K} {s : S} {word : List A},
  Generative.Feasible P s word → Generative.Feasible (Becoming.Readout.image P π) (π s) word
@Becoming.Readout.feasible_of_image : ∀ {S : Type u_1} {K : Type u_2} {A : Type u_3} {P : Generative.Process S A}
  {π : S → K},
  (∀ (s s' : S), π s = π s' → Becoming.Readout.SameFutures P s s') →
    ∀ {s : S} {word : List A},
      Generative.Feasible (Becoming.Readout.image P π) (π s) word → Generative.Feasible P s word
@Becoming.Readout.futures_through_iff : ∀ {S : Type u_1} {K : Type u_2} {A : Type u_3} {P : Generative.Process S A}
  {π : S → K},
  (∀ (s : S) (word : List A),
      Generative.Feasible (Becoming.Readout.image P π) (π s) word ↔ Generative.Feasible P s word) ↔
    ∀ (s s' : S), π s = π s' → Becoming.Readout.SameFutures P s s'
@Becoming.Readout.commonWitness_or_covered : ∀ {D : Type} [DecidableEq D] (a b roster : List D),
  Becoming.Readout.CommonWitness roster a b ∨ ∀ (d : D), d ∈ roster → ¬d ∈ b → d ∈ a
@Becoming.Readout.pick_of : ∀ {p : Prop}, p → ∀ (d : Decidable p) (y x : Bool), Becoming.Readout.pick d y x = y
@Becoming.Readout.pick_of_not : ∀ {p : Prop}, ¬p → ∀ (d : Decidable p) (y x : Bool), Becoming.Readout.pick d y x = x
@Becoming.Readout.no_common_report_iff : ∀ {D : Type} [DecidableEq D] {roster a b : List D} {x y : Bool},
  x ≠ y →
    ((∀ (report : D → Bool),
        Becoming.Readout.Explains roster a x report → ¬Becoming.Readout.Explains roster b y report) ↔
      Becoming.Readout.CommonWitness roster a b)
@Becoming.Readout.no_common_report_envelopes_iff : ∀ {D : Type} [DecidableEq D] {roster : List D}
  {fa fb : List (List D)} {x y : Bool},
  x ≠ y →
    ((∀ (report : D → Bool),
        (∃ a, a ∈ fa ∧ Becoming.Readout.Explains roster a x report) →
          ¬∃ b, b ∈ fb ∧ Becoming.Readout.Explains roster b y report) ↔
      ∀ (a : List D), a ∈ fa → ∀ (b : List D), b ∈ fb → Becoming.Readout.CommonWitness roster a b)
