@Becoming.Flow.Balances.threshold_blind : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {obs : F → C → Prop} [DecidableEq C] {L' : Becoming.Flow F C} {W' : Becoming.Web F C} {g : F} {c : C} {d : Nat},
  L.Balances W →
    L'.Balances W' →
      (∀ (t : Nat) (e : C), W.requires t g e ↔ W'.requires t g e) →
        (∀ (t : Nat) (e : C), W.need t g e = W'.need t g e) →
          W.DependsOn g c →
            ¬obs g c →
              W'.level 0 c = W.level 0 c + d →
                (∀ (e : C), W.Registers obs g e → e ≠ c → W.level 0 e = W'.level 0 e) →
                  L.RespondsThrough W L' W' obs g →
                    ∀ (t : Nat),
                      (∀ (s : Nat), s < t → W.Supported s g) →
                        W'.level t c = W.level t c + d ∧
                          (∀ (e : C), W.Registers obs g e → e ≠ c → W.level t e = W'.level t e) ∧
                            ∀ (s : Nat), s < t → W.RegistersAlike obs g W.level W'.level s
