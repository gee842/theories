  (sig : Pos → Nat → F → Prop) (formation : Q → F) (step : Q → Nat) (s : S) (c : Q),
  M.relevance living sig formation step s c ↔
    (M.inventory living).generative c ∧ (M.inventory living).realized s c ∧ ∀ (p : Pos), sig p (step c) (formation c)
