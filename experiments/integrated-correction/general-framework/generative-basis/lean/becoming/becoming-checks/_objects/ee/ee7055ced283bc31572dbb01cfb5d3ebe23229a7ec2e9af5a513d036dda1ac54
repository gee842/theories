  (F : Becoming.Frame S A C) (G : Becoming.Frame S' A C) (q : S → S'),
  (∀ (s : S) (a : A) (r : S'), G.P.step (q s) a r → ∃ t, F.P.step s a t ∧ q t = r) →
    (∀ (s : S) (c : C), G.realized (q s) c → F.realized s c) →
      ∀ (root : S),
        JointContinuationClassification.PreservesJointBundles (G.continuations (q root)) (F.continuations root)
@Becoming.commonResponse_is_robust : ∀ {S R : Type} {A : Type u_1} (P : Generative.Process S A)
