@Becoming.guarantees_iff_completes : ∀ {S A : Type} (P : Generative.Process S A) (s : S) (a : A) (goal : S → Prop),
  PracticalReach.Guarantees (fun a t => P.step s a t) a goal ↔
    Generative.InquirySufficiency.Completes P (fun x x_1 x_2 => True) goal s [a]
@Becoming.liveStep_iff_enabled : ∀ {S A : Type} (step : S → A → S → Prop) (s : S) (a : A),
