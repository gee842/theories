Becoming.Identification.residue : ∀ (p n : Nat), ∃ r k, r ≤ p ∧ n = r + (p + 1) * k
@Becoming.Identification.periodic_whole : ∀ {O : Type u_1} {x : Nat → O} {p : Nat},
  (∀ (n : Nat), x (n + (p + 1)) = x n) → ∀ (r k : Nat), x (r + (p + 1) * k) = x r
@Becoming.Identification.period_extends : ∀ {O : Type u_1} {x : Nat → O} {p Q : Nat},
  (∀ (n : Nat), x (n + (p + 1)) = x n) → (∀ (n : Nat), n < p → x (n + Q) = x n) → ∀ (n : Nat), x (n + Q) = x n
@Becoming.Identification.lassos_agree : ∀ {O : Type u_1} {o o' : Nat → O} {i q i' q' : Nat},
  Becoming.Learning.Lasso o i q →
    Becoming.Learning.Lasso o' i' q' → (∀ (n : Nat), n < i + q + 1 + (i' + q') → o n = o' n) → ∀ (n : Nat), o n = o' n
@Becoming.Identification.below_upto : ∀ {P : Nat → Prop},
  (∀ (m : Nat), (∀ (n : Nat), n < m → P n) → P m) → ∀ (m n : Nat), n < m → P n
@Becoming.Identification.below_all : ∀ {P : Nat → Prop},
  (∀ (m : Nat), (∀ (n : Nat), n < m → P n) → P m) → ∀ (n : Nat), P n
@Becoming.Identification.lassoPos_early : ∀ {i q : Nat} (n : Nat),
  n ≤ i + q → Becoming.Law.orbit (Becoming.Learning.lassoNext i q) 0 n = n
@Becoming.Identification.lassoPos_period : ∀ {i q : Nat} (d : Nat),
  Becoming.Law.orbit (Becoming.Learning.lassoNext i q) 0 (i + d + (q + 1)) =
    Becoming.Law.orbit (Becoming.Learning.lassoNext i q) 0 (i + d)
@Becoming.Identification.statesBelow_mono : ∀ {O : Type u_1} {o : Nat → O} {L N : Nat},
  Becoming.StatesBelow o L → L ≤ N → Becoming.StatesBelow o N
@Becoming.Identification.statesBelow_iff_lasso : ∀ {O : Type u_1} {o : Nat → O} {N : Nat},
  Becoming.StatesBelow o N ↔ ∃ i q, i + q + 1 ≤ N ∧ Becoming.Learning.Lasso o i q
@Becoming.Identification.statesBelow_pos : ∀ {O : Type u_1} {o : Nat → O} {N : Nat}, Becoming.StatesBelow o N → 0 < N
@Becoming.Identification.le_twice_less_one : ∀ {N : Nat}, 0 < N → N ≤ N + N - 1
@Becoming.Identification.bounded_agree : ∀ {O : Type u_1} {o o' : Nat → O} {N N' : Nat},
  Becoming.StatesBelow o N →
    Becoming.StatesBelow o' N' → (∀ (n : Nat), n < N + N' - 1 → o n = o' n) → ∀ (n : Nat), o n = o' n
@Becoming.Identification.record_eq_iff : ∀ {O : Type u_1} {o o' : Nat → O} {T : Nat},
  Becoming.Learning.record o T = Becoming.Learning.record o' T ↔ ∀ (n : Nat), n < T → o n = o' n
@Becoming.Identification.record_fixes : ∀ {O : Type u_1} {o o' : Nat → O} {N N' : Nat},
  Becoming.StatesBelow o N →
    Becoming.StatesBelow o' N' →
      Becoming.Learning.record o (N + N' - 1) = Becoming.Learning.record o' (N + N' - 1) → ∀ (n : Nat), o n = o' n
@Becoming.Identification.record_short : ∀ {O : Type u_1} {x y : O},
  x ≠ y →
    ∀ (T : Nat),
      ∃ o o',
        Becoming.StatesBelow o 1 ∧
          Becoming.StatesBelow o' (T + 1) ∧ Becoming.Learning.record o T = Becoming.Learning.record o' T ∧ o T ≠ o' T
@Becoming.Identification.record_short_twice : ∀ {O : Type u_1} {x y : O},
  x ≠ y →
    ∀ (M : Nat),
      ∃ o o',
        Becoming.StatesBelow o (M + 2) ∧
          Becoming.StatesBelow o' (M + 2) ∧
            Becoming.Learning.record o (M + M + 2) = Becoming.Learning.record o' (M + M + 2) ∧
              o (M + M + 2) ≠ o' (M + M + 2)
@Becoming.Identification.statesBelow_shift : ∀ {O : Type u_1} {o : Nat → O} {N : Nat},
  Becoming.StatesBelow o N → ∀ (t : Nat), Becoming.StatesBelow (fun n => o (t + n)) N
@Becoming.Identification.sameAhead_iff_below : ∀ {O : Type u_1} {o : Nat → O} {N : Nat},
  Becoming.StatesBelow o N →
    ∀ {t t' : Nat}, Becoming.SameAhead o t t' ↔ ∀ (n : Nat), n < N + N - 1 → o (t + n) = o (t' + n)
@Becoming.Identification.lasso_of_fits : ∀ {O : Type u_1} {o : Nat → O} {N i q : Nat},
  Becoming.StatesBelow o N →
    i + q + 1 ≤ N →
      (∀ (u : Nat), i ≤ u → u + (q + 1) < N + N - 1 → o (u + (q + 1)) = o u) → Becoming.Learning.Lasso o i q
@Becoming.Identification.fits_of_unrefuted : ∀ {O : Type u_1} [DecidableEq O] {o : Nat → O} {i q T : Nat},
  (∀ (t : Nat), t < T → ¬Becoming.Learning.RefutedAt (Becoming.Learning.lasso (i, q)) o t) →
    ∀ (u : Nat), i ≤ u → u + (q + 1) < T → o (u + (q + 1)) = o u
@Becoming.Identification.bounded_induction : ∀ {O : Type u_1} [DecidableEq O] {o : Nat → O} {N i q : Nat},
  Becoming.StatesBelow o N →
    i + q + 1 ≤ N →
      (∀ (t : Nat), t < N + N - 1 → ¬Becoming.Learning.RefutedAt (Becoming.Learning.lasso (i, q)) o t) →
        Becoming.Learning.Holds (Becoming.Learning.lasso (i, q)) o
@Becoming.Identification.bounded_hypothesis : ∀ {O : Type u_1} {o : Nat → O} {N : Nat},
  Becoming.StatesBelow o N → ∃ i q, i + q + 1 ≤ N ∧ Becoming.Learning.Holds (Becoming.Learning.lasso (i, q)) o
@Becoming.Identification.borneOut_record_iff : ∀ {O : Type u_1} {pred : List O → Option O} {o : Nat → O} {T : Nat},
  Becoming.Identification.BorneOut pred (Becoming.Learning.record o T) ↔
    ∀ (t : Nat), t < T → ¬Becoming.Learning.RefutedAt pred o t
@Becoming.Identification.mem_column : ∀ {i q Q : Nat}, q < Q → (i, q) ∈ Becoming.Identification.column i Q
@Becoming.Identification.mem_grid : ∀ {i q Q : Nat},
  q < Q → ∀ {I : Nat}, i < I → (i, q) ∈ Becoming.Identification.grid Q I
@Becoming.Identification.firstFit_sound : ∀ {α : Type} {p : α → Prop} {dec : (a : α) → Decidable (p a)} {l : List α}
  {a : α}, Becoming.Identification.firstFit p dec l = some a → p a
@Becoming.Identification.firstFit_found : ∀ {α : Type} {p : α → Prop} {dec : (a : α) → Decidable (p a)} {l : List α}
  {a : α}, a ∈ l → p a → ∃ b, Becoming.Identification.firstFit p dec l = some b
@Becoming.Identification.knowing_right : ∀ {O : Type u_1} [inst : DecidableEq O] {o : Nat → O} {N t : Nat},
  Becoming.StatesBelow o N →
    N + N - 1 ≤ t → Becoming.Identification.knowing N (Becoming.Learning.record o t) = some (o t)
@Becoming.Identification.knowing_holds : ∀ {O : Type u_1} [inst : DecidableEq O] {o : Nat → O} {N : Nat},
  Becoming.StatesBelow o N → Becoming.Learning.Holds (Becoming.Identification.knowing N) o
@Becoming.Identification.knowing_earliest : ∀ {O : Type u_1} {x y : O},
  x ≠ y →
    ∀ (pred : List O → Option O) (M : Nat),
      ¬∀ (o : Nat → O),
          Becoming.StatesBelow o (M + 2) →
            Becoming.Learning.Holds pred o ∧ ∃ w, pred (Becoming.Learning.record o (M + M + 2)) = some w
Becoming.Identification.denial_derived : ∀ (t : Nat),
  3 ≤ t →
    Becoming.Identification.knowing 2 (Becoming.Learning.record Becoming.Denial.register t) =
      some (Becoming.Denial.register t)
@Becoming.Identification.answer_exceeds_bound : ∀ {O : Type u_1} [inst : DecidableEq O] {other : O → O},
  (∀ (v : O), other v ≠ v) →
    ∀ (x : O) (N : Nat),
      ¬Becoming.StatesBelow (Becoming.Learning.diagonal (Becoming.Identification.knowing N) other x) N
@Becoming.Identification.unrefuted_persists : ∀ {O : Type u_1} [DecidableEq O] {o : Nat → O} {N a b s : Nat},
  Becoming.StatesBelow o N →
    a + b + 1 ≤ N →
      a ≤ s →
        (∀ (t : Nat), s ≤ t → t < s + (N + N - 1) → ¬Becoming.Learning.RefutedAt (Becoming.Learning.lasso (a, b)) o t) →
          ∀ (t : Nat), s ≤ t → ¬Becoming.Learning.RefutedAt (Becoming.Learning.lasso (a, b)) o t
@Becoming.Identification.learner_rests : ∀ {O : Type u_1} [inst : DecidableEq O] {o : Nat → O} {N : Nat},
  Becoming.StatesBelow o N →
    ∀ (t : Nat),
      N + (N + N - 1) * Becoming.Learning.tri N ≤ t →
        Becoming.Learning.learner Becoming.Learning.lassos (Becoming.Learning.record o t) = some (o t)
@Becoming.Identification.rests_of_lasso : ∀ {O : Type u_1} [inst : DecidableEq O] {o : Nat → O} {i q : Nat},
  Becoming.Learning.Lasso o i q →
    ∃ T,
      ∀ (t : Nat),
        T ≤ t → Becoming.Learning.learner Becoming.Learning.lassos (Becoming.Learning.record o t) = some (o t)
@Becoming.Identification.held_learner_rests : ∀ {O : Type u_1} [inst : DecidableEq O] {S : Type u_2} {next : S → S}
  {s : S} {l : List S},
  (∀ (n : Nat), Becoming.Law.orbit next s n ∈ l) →
    ∀ (reg : S → O) (t : Nat),
      l.length + (l.length + l.length - 1) * Becoming.Learning.tri l.length ≤ t →
        Becoming.Learning.learner Becoming.Learning.lassos
            (Becoming.Learning.record (fun n => reg (Becoming.Law.orbit next s n)) t) =
          some (reg (Becoming.Law.orbit next s t))
@Becoming.Law.orbit_held : ∀ {S : Type u_1} {next : S → S} {l : List S},
  (∀ (s : S), s ∈ l → next s ∈ l) → ∀ {s : S}, s ∈ l → ∀ (n : Nat), Becoming.Law.orbit next s n ∈ l
@Becoming.Law.statesBelow_held : ∀ {S : Type u_1} {R : Type u_2} {next : S → S} {l : List S},
  (∀ (s : S), s ∈ l → next s ∈ l) →
    ∀ {s : S}, s ∈ l → ∀ (o : S → R), Becoming.StatesBelow (fun n => o (Becoming.Law.orbit next s n)) l.length
@Becoming.Law.sameFuture_iff_below : ∀ {S : Type u_1} {R : Type u_2} {next : S → S} {o : S → R} {l : List S},
  (∀ (s : S), s ∈ l → next s ∈ l) →
    ∀ {s s' : S},
      s ∈ l →
        s' ∈ l →
          (Becoming.Law.SameFuture next o s s' ↔
            ∀ (n : Nat),
              n < l.length + l.length - 1 → o (Becoming.Law.orbit next s n) = o (Becoming.Law.orbit next s' n))
@Becoming.Law.name_makesSense : ∀ {S : Type u_1} {R : Type u_2} {next : S → S} {o : S → R} {l : List S},
  (∀ (s : S), s ∈ l) →
    Becoming.MakesSense (Becoming.Law.registered next o) (Becoming.Law.name next o (l.length + l.length - 1))
@Becoming.Law.name_carries : ∀ {S : Type u_1} {R : Type u_2} {next : S → S} {o : S → R} {l : List S},
  (∀ (s : S), s ∈ l) →
    ∃ Q,
      Becoming.Determined Q ∧
        Becoming.FactorsThrough (Becoming.Law.process next) (Becoming.Law.name next o (l.length + l.length - 1)) Q
