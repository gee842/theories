@Becoming.LearnableRuns.prefix_eq : ∀ {S : Type u_1} {R : Type u_2} {next : S → S} (reg : S → R)
  (r : Becoming.Run (Becoming.Law.process next)) (t : Nat),
  Becoming.Learning.prefixOf (Becoming.LearnableRuns.course reg r) t =
    Becoming.Learning.prefixOf (Becoming.Learnable.course next reg (r.state 0)) t
@Becoming.LearnableRuns.restsFrom_iff : ∀ {S : Type u_1} {R : Type u_2} {V : Type u_3} {next : S → S} {reg : S → R}
  {val : S → V} {pred : List R → Option V} (r : Becoming.Run (Becoming.Law.process next)) (T : Nat),
  Becoming.LearnableRuns.RestsFrom reg val pred r T ↔ Becoming.Learnable.RestsFrom next reg val pred (r.state 0) T
@Becoming.LearnableRuns.rests_iff : ∀ {S : Type u_1} {R : Type u_2} {V : Type u_3} {next : S → S} {reg : S → R}
  {val : S → V} {pred : List R → Option V} (r : Becoming.Run (Becoming.Law.process next)),
  Becoming.LearnableRuns.Rests reg val pred r ↔ Becoming.Learnable.Rests next reg val pred (r.state 0)
@Becoming.LearnableRuns.course_same : ∀ {S : Type u_1} {R : Type u_2} {next : S → S} {reg : S → R}
  {r r' : Becoming.Run (Becoming.Law.process next)},
  Becoming.Alike (Becoming.Law.frameBy next reg) (Becoming.Law.frameBy next reg) (r.state 0) (r'.state 0) →
    ∀ (n : Nat), reg (r.state n) = reg (r'.state n)
@Becoming.LearnableRuns.prefixes_same : ∀ {S : Type u_1} {R : Type u_2} {next : S → S} {reg : S → R}
  {r r' : Becoming.Run (Becoming.Law.process next)},
  Becoming.Alike (Becoming.Law.frameBy next reg) (Becoming.Law.frameBy next reg) (r.state 0) (r'.state 0) →
    ∀ (t : Nat),
      Becoming.Learning.prefixOf (Becoming.LearnableRuns.course reg r) t =
        Becoming.Learning.prefixOf (Becoming.LearnableRuns.course reg r') t
@Becoming.LearnableRuns.agree_of_rests_both : ∀ {S : Type u_1} {R : Type u_2} {V : Type u_3} {next : S → S}
  {reg : S → R} {val : S → V} {pred : List R → Option V} {r r' : Becoming.Run (Becoming.Law.process next)},
  Becoming.Alike (Becoming.Law.frameBy next reg) (Becoming.Law.frameBy next reg) (r.state 0) (r'.state 0) →
    ∀ {T T' : Nat},
      Becoming.LearnableRuns.RestsFrom reg val pred r T →
        Becoming.LearnableRuns.RestsFrom reg val pred r' T' →
          ∀ (t : Nat), T + T' ≤ t → val (r.state t) = val (r'.state t)
@Becoming.LearnableRuns.not_rests_on_both : ∀ {S : Type u_1} {R : Type u_2} {V : Type u_3} {next : S → S} {reg : S → R}
  {val : S → V} (pred : List R → Option V) {r r' : Becoming.Run (Becoming.Law.process next)},
  Becoming.Alike (Becoming.Law.frameBy next reg) (Becoming.Law.frameBy next reg) (r.state 0) (r'.state 0) →
    (∀ (T : Nat), ∃ t, T ≤ t ∧ val (r.state t) ≠ val (r'.state t)) →
      ¬(Becoming.LearnableRuns.Rests reg val pred r ∧ Becoming.LearnableRuns.Rests reg val pred r')
@Becoming.LearnableRuns.rests_through : ∀ {S : Type u_1} {R : Type u_2} {V : Type u_3} [inst : DecidableEq R]
  {next : S → S} (r : Becoming.Run (Becoming.Law.process next)) {l : List S},
  (∀ (n : Nat), r.state n ∈ l) →
    ∀ {reg : S → R} {val : S → V} {g : R → V},
      (∀ (s : S), val s = g (reg s)) →
        Becoming.LearnableRuns.RestsFrom reg val
          (fun x => Option.map g (Becoming.Learning.byElimination Becoming.Learning.lassos x)) r
          (l.length + (l.length + l.length - 1) * Becoming.Learning.tri l.length)
@Becoming.LearnableRuns.learnable_iff : ∀ {S : Type} {R : Type u_1} {V : Type u_2} [DecidableEq R] {next : S → S}
  {reg : S → R} {val : S → V} {l : List S},
  (∀ (s : S), s ∈ l) →
    ((∃ pred, ∀ (r : Becoming.Run (Becoming.Law.process next)), Becoming.LearnableRuns.Rests reg val pred r) ↔
      ∀ (r r' : Becoming.Run (Becoming.Law.process next)),
        Becoming.Alike (Becoming.Law.frameBy next reg) (Becoming.Law.frameBy next reg) (r.state 0) (r'.state 0) →
          ∃ T, ∀ (t : Nat), T ≤ t → val (r.state t) = val (r'.state t))
@Becoming.LearnableRuns.still_learnable_iff_lumped : ∀ {S : Type} {R : Type u_1} {V : Type u_2} [DecidableEq R]
  {next : S → S},
  (∀ (s : S), next s = s) →
    ∀ {reg : S → R} {val : S → V} {l : List S},
      (∀ (s : S), s ∈ l) →
        ((∃ pred, ∀ (r : Becoming.Run (Becoming.Law.process next)), Becoming.LearnableRuns.Rests reg val pred r) ↔
          Becoming.Learning.Lumped reg val)
