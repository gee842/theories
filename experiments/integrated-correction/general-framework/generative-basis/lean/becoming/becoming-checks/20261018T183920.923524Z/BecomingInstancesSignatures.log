@Becoming.Instances.assured_iff_completes : ∀ {S : Type u_1} {A : Type u_2} (P : Generative.Process S A) (Q : S → Prop)
  (plan : List A) (s : S),
  Generative.ContextualWisdom.Assured P plan Q s ↔
    Generative.InquirySufficiency.Completes P Becoming.Assurance.free Q s plan
Becoming.Instances.routes_eq : Generative.WisdomResponseStructure.routes =
  Becoming.Assurance.ofMap Generative.WisdomResponseStructure.advance
Becoming.Instances.routes_assured_iff : ∀ (m a : Fin 3),
  Generative.ContextualWisdom.Assured Generative.WisdomResponseStructure.routes [a]
      Generative.WisdomResponseStructure.Reached (m, false) ↔
    a ≠ m
Becoming.Instances.regulation_assured_iff : ∀ (n : Nat) (a : Generative.ContextualWisdom.Move) (Q : Nat → Prop),
  Generative.ContextualWisdom.Assured Generative.ContextualWisdom.regulation [a] Q n ↔
    Q (Generative.ContextualWisdom.update n a)
Becoming.Instances.chunks_eq : ∀
  (r : Generative.AcquiredSegmentation.Sound → Generative.AcquiredSegmentation.Sound → Bool)
  (xs : List Generative.AcquiredSegmentation.Sound),
  Generative.AcquiredSegmentation.chunks r xs = Becoming.Segmentation.chunks r xs
@Becoming.Instances.flatten_eq_join : ∀ {α : Type u_1} (L : List (List α)), L.flatten = Becoming.Segmentation.join L
Becoming.Instances.encode_eq : ∀ (ws : List Bool),
  Generative.AcquiredSegmentation.encode ws = Becoming.Segmentation.encode Generative.AcquiredSegmentation.word ws
Becoming.Instances.spelled : Becoming.Segmentation.Spelled Generative.AcquiredSegmentation.word
  Becoming.Instances.wordFirst Becoming.Instances.wordRest
Becoming.Instances.two_word_iff : ∀
  (r : Generative.AcquiredSegmentation.Sound → Generative.AcquiredSegmentation.Sound → Bool),
  (∀ (ws : List Bool),
      Generative.AcquiredSegmentation.chunks r (Generative.AcquiredSegmentation.encode ws) =
        List.map Generative.AcquiredSegmentation.word ws) ↔
    r Generative.AcquiredSegmentation.Sound.a Generative.AcquiredSegmentation.Sound.b = true ∧
      r Generative.AcquiredSegmentation.Sound.c Generative.AcquiredSegmentation.Sound.d = true ∧
        r Generative.AcquiredSegmentation.Sound.b Generative.AcquiredSegmentation.Sound.a = false ∧
          r Generative.AcquiredSegmentation.Sound.b Generative.AcquiredSegmentation.Sound.c = false ∧
            r Generative.AcquiredSegmentation.Sound.d Generative.AcquiredSegmentation.Sound.a = false ∧
              r Generative.AcquiredSegmentation.Sound.d Generative.AcquiredSegmentation.Sound.c = false
Becoming.Instances.ideal_two_word : ∀ (ws : List Bool),
  Generative.AcquiredSegmentation.chunks Generative.AcquiredSegmentation.idealBond
      (Generative.AcquiredSegmentation.encode ws) =
    List.map Generative.AcquiredSegmentation.word ws
Becoming.Instances.diagonal_no_decoder : ¬∃ decode,
    decode (Generative.OperativeCoherence.diagonal Generative.OperativeCoherence.coherent) =
        Generative.OperativeCoherence.plusMass Generative.OperativeCoherence.coherent ∧
      decode (Generative.OperativeCoherence.diagonal Generative.OperativeCoherence.degraded) =
        Generative.OperativeCoherence.plusMass Generative.OperativeCoherence.degraded
Becoming.Instances.dephase_no_restore : ¬∃ restore,
    restore (Generative.OperativeCoherence.dephase Generative.OperativeCoherence.prepared) =
        Generative.OperativeCoherence.prepared ∧
      restore (Generative.OperativeCoherence.dephase Generative.OperativeCoherence.coherent) =
        Generative.OperativeCoherence.coherent
Becoming.Instances.local_pair_no_update : ¬∃ update,
    update (Generative.RelationalReduction.localStates Generative.RelationalReduction.joined) =
        Generative.OperativeCoherence.controlDensity
          (Generative.OperativeCoherence.recordBranch Generative.RelationalReduction.joined) ∧
      update (Generative.RelationalReduction.localStates Generative.RelationalReduction.changed) =
        Generative.OperativeCoherence.controlDensity
          (Generative.OperativeCoherence.recordBranch Generative.RelationalReduction.changed)
Becoming.Instances.local_pair_carries_no_law : ¬∃ Q,
    Becoming.Determined Q ∧
      Becoming.FactorsThrough (Becoming.Assurance.ofMap Generative.RelationalReduction.next)
        Generative.RelationalReduction.localStates Q
@Becoming.Instances.evolve_eq_foldl : ∀ {S : Type u_1} {A : Type u_2} (next : S → A → S) (s : S) (word : List A),
  SystemsOrganization.evolve next s word = List.foldl next s word
@Becoming.Instances.ite_some : ∀ {β : Type u_1} {c : Prop} {d : Decidable c} {x t : β},
  (if c then some x else none) = some t → x = t
Becoming.Instances.process_eq : OrganizationalRuleInheritance.process =
  Becoming.Assurance.ofPartial OrganizationalRuleInheritance.step
Becoming.Instances.run_eq : ∀ (s : OrganizationalRuleInheritance.State) (es : List OrganizationalRuleInheritance.Event),
  OrganizationalRuleInheritance.run s es = Becoming.Assurance.runPartial OrganizationalRuleInheritance.step s es
@Becoming.Instances.trace_iff_run : ∀ {s t : OrganizationalRuleInheritance.State}
  {es : List OrganizationalRuleInheritance.Event},
  Generative.Trace OrganizationalRuleInheritance.process s es t ↔ OrganizationalRuleInheritance.run s es = some t
Becoming.Instances.rule_kept : Becoming.Gated.KeptBy OrganizationalRuleInheritance.process Becoming.Instances.adopts
  OrganizationalRuleInheritance.State.rule
@Becoming.Instances.rule_inherited : ∀ {s t : OrganizationalRuleInheritance.State}
  {es : List OrganizationalRuleInheritance.Event},
  Generative.Trace OrganizationalRuleInheritance.process s es t →
    (∀ (e : OrganizationalRuleInheritance.Event), e ∈ es → Becoming.Instances.adopts e = false) → t.rule = s.rule
@Becoming.Instances.rule_change_located : ∀ {s t : OrganizationalRuleInheritance.State}
  {es : List OrganizationalRuleInheritance.Event},
  Generative.Trace OrganizationalRuleInheritance.process s es t →
    t.rule ≠ s.rule →
      ∃ pre e post m m',
        es = pre ++ e :: post ∧
          Generative.Trace OrganizationalRuleInheritance.process s pre m ∧
            m.rule = s.rule ∧
              OrganizationalRuleInheritance.step m e = some m' ∧
                Becoming.Instances.adopts e = true ∧
                  m'.rule ≠ m.rule ∧ Generative.Trace OrganizationalRuleInheritance.process m' post t
