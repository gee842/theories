@Becoming.length_append : ∀ {α : Type} (p q : List α), (p ++ q).length = p.length + q.length
@Becoming.mem_cons_cases : ∀ {α : Type} {a b : α} {q : List α}, b ∈ a :: q → b = a ∨ b ∈ q
@Becoming.mem_map_of : ∀ {α β : Type} {g : α → β} {a : α} {l : List α}, a ∈ l → g a ∈ List.map g l
@Becoming.mem_of_map : ∀ {α β : Type} {g : α → β},
  (∀ (a b : α), g a = g b → a = b) → ∀ {a : α} {l : List α}, g a ∈ List.map g l → a ∈ l
@Becoming.distinct_map : ∀ {α β : Type} {g : α → β},
  (∀ (a b : α), g a = g b → a = b) → ∀ {l : List α}, Becoming.Distinct l → Becoming.Distinct (List.map g l)
@Becoming.mem_remove : ∀ {α : Type} {a b : α}, ¬b = a → ∀ {p q : List α}, b ∈ p ++ a :: q → b ∈ p ++ q
@Becoming.length_le_of_matched : ∀ {α β : Type} {S : α → β → Prop} {l : List α} {m : List β},
  Becoming.Distinct l →
    (∀ (a : α), a ∈ l → ∃ b, b ∈ m ∧ S a b) →
      (∀ (a a' : α) (b : β), a ∈ l → a' ∈ l → S a b → S a' b → a = a') → l.length ≤ m.length
@Becoming.length_le_of_sub : ∀ {α : Type} {l m : List α},
  Becoming.Distinct l → (∀ (a : α), a ∈ l → a ∈ m) → l.length ≤ m.length
@Becoming.count_le_of_sub : ∀ {α : Type} {q : α → Nat} {l m : List α},
  Becoming.Distinct l → (∀ (a : α), a ∈ l → 0 < q a → a ∈ m) → Becoming.count l q ≤ m.length
@Becoming.search : ∀ {α : Type} {p : α → Prop} [decide : (a : α) → Decidable (p a)] (l : List α),
  (∃ a, a ∈ l ∧ ¬p a) ∨ ∀ (a : α), a ∈ l → p a
@Becoming.rises_between : ∀ {q : Nat → Nat} {N T : Nat}, N ≤ T → q N < q T → ∃ t, N ≤ t ∧ t < T ∧ q t < q (t + 1)
@Becoming.Web.arises_of_more : ∀ {F C : Type} (W : Becoming.Web F C) [(t : Nat) → (f : F) → Decidable (W.active t f)]
  {t : Nat} {before after : List F},
  (∀ (f : F), W.active t f → f ∈ before) →
    Becoming.Distinct after →
      (∀ (f : F), f ∈ after → W.active (t + 1) f) → before.length < after.length → ∃ f, f ∈ after ∧ W.Arises t f
@Becoming.Web.unceasing_of_growth : ∀ {F C : Type} (W : Becoming.Web F C)
  [(t : Nat) → (f : F) → Decidable (W.active t f)] {alive : Nat → List F},
  W.Census alive → (∀ (N K : Nat), ∃ t, N ≤ t ∧ K < (alive t).length) → W.Unceasing
@Becoming.Web.arises_or_kept : ∀ {F C : Type} (W : Becoming.Web F C) [(t : Nat) → (f : F) → Decidable (W.active t f)]
  {alive : Nat → List F},
  W.Census alive → ∀ {N T : Nat}, N ≤ T → (∃ t f, N ≤ t ∧ W.Arises t f) ∨ ∀ (f : F), W.active T f → W.active N f
@Becoming.Web.arises_or_fewer : ∀ {F C : Type} (W : Becoming.Web F C) [(t : Nat) → (f : F) → Decidable (W.active t f)]
  {alive : Nat → List F},
  W.Census alive →
    ∀ {N T : Nat},
      N ≤ T → ∀ {f : F}, W.Ceases T f → (∃ t g, N ≤ t ∧ W.Arises t g) ∨ (alive (T + 1)).length < (alive N).length
@Becoming.Web.arises_within : ∀ {F C : Type} (W : Becoming.Web F C) [(t : Nat) → (f : F) → Decidable (W.active t f)]
  {alive : Nat → List F},
  W.Census alive →
    (∀ (N : Nat), ∃ t f, N ≤ t ∧ W.Ceases t f) → ∀ (k N : Nat), (alive N).length ≤ k → ∃ t f, N ≤ t ∧ W.Arises t f
@Becoming.Web.arising_of_ceasing : ∀ {F C : Type} (W : Becoming.Web F C)
  [(t : Nat) → (f : F) → Decidable (W.active t f)] {alive : Nat → List F},
  W.Census alive → (∀ (N : Nat), ∃ t f, N ≤ t ∧ W.Ceases t f) → W.Unceasing
@Becoming.Web.ceases_or_kept : ∀ {F C : Type} (W : Becoming.Web F C) [(t : Nat) → (f : F) → Decidable (W.active t f)]
  {alive : Nat → List F},
  W.Census alive → ∀ {N T : Nat}, N ≤ T → (∃ t f, N ≤ t ∧ W.Ceases t f) ∨ ∀ (f : F), W.active N f → W.active T f
@Becoming.Web.ceases_or_more : ∀ {F C : Type} (W : Becoming.Web F C) [(t : Nat) → (f : F) → Decidable (W.active t f)]
  {alive : Nat → List F},
  W.Census alive →
    ∀ {N T : Nat},
      N ≤ T → ∀ {f : F}, W.Arises T f → (∃ t g, N ≤ t ∧ W.Ceases t g) ∨ (alive N).length < (alive (T + 1)).length
@Becoming.Web.ceases_within : ∀ {F C : Type} (W : Becoming.Web F C) [(t : Nat) → (f : F) → Decidable (W.active t f)]
  {alive : Nat → List F},
  W.Census alive →
    ∀ {B : Nat},
      (∀ (t : Nat), (alive t).length ≤ B) →
        W.Unceasing → ∀ (k N : Nat), B ≤ (alive N).length + k → ∃ t f, N ≤ t ∧ W.Ceases t f
@Becoming.Web.ceasing_of_arising : ∀ {F C : Type} (W : Becoming.Web F C)
  [(t : Nat) → (f : F) → Decidable (W.active t f)] {alive : Nat → List F},
  W.Census alive →
    ∀ {B : Nat}, (∀ (t : Nat), (alive t).length ≤ B) → W.Unceasing → ∀ (N : Nat), ∃ t f, N ≤ t ∧ W.Ceases t f
@Becoming.Web.unceasing_iff_bounded : ∀ {F C : Type} (W : Becoming.Web F C)
  [(t : Nat) → (f : F) → Decidable (W.active t f)] {alive : Nat → List F},
  W.Census alive →
    ∀ {B : Nat}, (∀ (t : Nat), (alive t).length ≤ B) → (W.Unceasing ↔ ∀ (N : Nat), ∃ t f, N ≤ t ∧ W.Ceases t f)
@Becoming.Flow.More.grows : ∀ {F C : Type} {W : Becoming.Web F C} {L : Becoming.Flow F C} {cs : List C}
  {alive : Nat → List F},
  W.Census alive →
    (∀ (t : Nat), Becoming.Distinct (L.present t)) →
      L.Taking W → L.More cs → ∀ (N K : Nat), ∃ t, N ≤ t ∧ K < (alive t).length
@Becoming.Flow.More.unceasing : ∀ {F C : Type} {W : Becoming.Web F C} [(t : Nat) → (f : F) → Decidable (W.active t f)]
  {L : Becoming.Flow F C} {cs : List C} {alive : Nat → List F},
  W.Census alive → (∀ (t : Nat), Becoming.Distinct (L.present t)) → L.Taking W → L.More cs → W.Unceasing
Becoming.Garden.distinct : ∀ (t : Nat), Becoming.Distinct (Becoming.Garden.present t)
Becoming.Garden.listed : ∀ (t : Nat) (f : Becoming.Garden.Kind × Nat), f.snd < t → f ∈ Becoming.Garden.present t
Becoming.Garden.census : Becoming.Garden.web.Census Becoming.Garden.present
Becoming.Garden.counted : Becoming.Garden.web.Census Becoming.Garden.present ∧
  (∀ (t : Nat), Becoming.Distinct (Becoming.Garden.flow.present t)) ∧
    Becoming.Garden.flow.Taking Becoming.Garden.web ∧ Becoming.Garden.flow.More [()]
Becoming.Cycle.distinct : ∀ (t : Nat), Becoming.Distinct (Becoming.Cycle.present t)
Becoming.Cycle.listed : ∀ (t n : Nat), n < t → n ∈ Becoming.Cycle.present t
Becoming.Cycle.census : Becoming.Cycle.web.Census Becoming.Cycle.present
Becoming.Cycle.counted : Becoming.Cycle.web.Census Becoming.Cycle.present ∧
  (∀ (t : Nat), Becoming.Distinct (Becoming.Cycle.flow.present t)) ∧
    Becoming.Cycle.flow.Taking Becoming.Cycle.web ∧ Becoming.Cycle.flow.More [()]
Becoming.Bloom.pair : Becoming.Distinct [Becoming.Bloom.Formation.sun, Becoming.Bloom.Formation.bloom]
Becoming.Bloom.census : Becoming.Bloom.web.Census Becoming.Bloom.alive
Becoming.Bloom.counted : Becoming.Bloom.web.Census Becoming.Bloom.alive ∧
  (∀ (t : Nat), Becoming.Distinct (Becoming.Bloom.flow.present t)) ∧
    Becoming.Bloom.flow.Taking Becoming.Bloom.web ∧ Becoming.Bloom.web.Unceasing ∧ ¬Becoming.Bloom.flow.More [()]
Becoming.Dormant.more_without_arising : Becoming.Garden.flow.Balances Becoming.Dormant.web ∧
  Becoming.Garden.flow.Acting Becoming.Dormant.web ∧
    Becoming.Garden.flow.Taking Becoming.Dormant.web ∧
      Becoming.Garden.flow.Capacity [()] 1 ∧
        Becoming.Dormant.web.Dependent ∧
          Becoming.Garden.flow.More [()] ∧
            ∀ (t : Nat) (f : Becoming.Garden.Kind × Nat), ¬Becoming.Dormant.web.Arises t f
Becoming.Repeated.ones : ∀ (n : Nat), (Becoming.total (Becoming.Repeated.rep n) fun x => 1) = n
Becoming.Repeated.census : Becoming.Repeated.web.Census fun x => [()]
Becoming.Repeated.more_without_arising : (Becoming.Repeated.web.Census fun x => [()]) ∧
  Becoming.Repeated.flow.Balances Becoming.Repeated.web ∧
    Becoming.Repeated.flow.Acting Becoming.Repeated.web ∧
      Becoming.Repeated.flow.Taking Becoming.Repeated.web ∧
        Becoming.Repeated.flow.More [()] ∧
          (¬∀ (t : Nat), Becoming.Distinct (Becoming.Repeated.flow.present t)) ∧
            ∀ (t : Nat) (f : Unit), ¬Becoming.Repeated.web.Arises t f
@Becoming.Inactive.ones : ∀ {q : Nat → Nat},
  q 0 = 0 → (∀ (m : Nat), q (m + 1) = 1) → ∀ (n : Nat), Becoming.total (Becoming.Inactive.present n) q = n
Becoming.Inactive.gives : ∀ (t n : Nat),
  (Becoming.total (Becoming.Inactive.present n) fun m => Becoming.Inactive.flow.give t m ()) = t
Becoming.Inactive.present_le : ∀ (n m : Nat), m ∈ Becoming.Inactive.present n → m ≤ n
Becoming.Inactive.distinct : ∀ (n : Nat), Becoming.Distinct (Becoming.Inactive.present n)
Becoming.Inactive.more_without_arising : Becoming.Inactive.flow.Balances Becoming.Inactive.web ∧
  Becoming.Inactive.flow.Acting Becoming.Inactive.web ∧
    Becoming.Inactive.web.Census Becoming.Inactive.alive ∧
      (∀ (t : Nat), Becoming.Distinct (Becoming.Inactive.flow.present t)) ∧
        Becoming.Inactive.flow.More [()] ∧
          ¬Becoming.Inactive.flow.Taking Becoming.Inactive.web ∧ ∀ (t f : Nat), ¬Becoming.Inactive.web.Arises t f
Becoming.Crowd.drawing_without_taking : Becoming.Crowd.flow.Balances Becoming.Cycle.web ∧
  Becoming.Crowd.flow.Acting Becoming.Cycle.web ∧
    Becoming.Crowd.flow.Taking Becoming.Cycle.web ∧
      Becoming.Cycle.web.Dependent ∧
        (∀ (K : Nat),
            ∃ T,
              ∀ (t : Nat),
                T ≤ t →
                  ∀ (n : Nat),
                    n < K →
                      Becoming.Cycle.web.active t n ∧
                        Becoming.Cycle.web.requires t n () ∧ Becoming.Cycle.web.draws t n ()) ∧
          ¬Becoming.Crowd.flow.More [()]
