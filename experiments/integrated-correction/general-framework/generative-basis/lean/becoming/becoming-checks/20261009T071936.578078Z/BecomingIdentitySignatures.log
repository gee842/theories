  Becoming.odd t = true → Becoming.TideFlip.flipped.Arises t Becoming.Tide.Formation.moon
Becoming.TideFlip.naming_meets_premises : (∀ (t : Nat) (f : Becoming.Tide.Formation), ¬Becoming.Tide.still.Arises t f) ∧
  ¬Becoming.TideFlip.flip.KeepsActive Becoming.Tide.still ∧
    Becoming.TideFlip.flipped.Dependent ∧
      Becoming.TideFlip.flipped.RenewedBy Becoming.TideFlip.renews ∧
        (Becoming.TideFlip.flipped.Depletes [()] fun t => ∃ x, Becoming.TideFlip.flipped.Arises t x) ∧
          Becoming.TideFlip.flipped.Unceasing ∧
            ∀ (T : Nat),
              ¬∀ (t : Nat),
                  T ≤ t →
                    ∀ (x : Becoming.Tide.Formation),
                      ¬Becoming.TideFlip.flipped.Regenerating Becoming.TideFlip.renews [()] t x
