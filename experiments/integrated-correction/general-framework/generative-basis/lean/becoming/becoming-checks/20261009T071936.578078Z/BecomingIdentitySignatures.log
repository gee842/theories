    σ.back.KeepsTenure (W.reidentify σ) →
      ∀ (t : Nat) (x : F'), Becoming.Web.UnderminingAt t x ↔ Becoming.Web.UnderminingAt t (σ.old t x)
@Becoming.Web.arisesFrom_self : ∀ {F C : Type} (W : Becoming.Web F C) (t : Nat) (f : F),
  W.ArisesFrom (fun x g f => g = f) t f ↔ W.Arises t f
@Becoming.Web.unceasingFrom_self : ∀ {F C : Type} (W : Becoming.Web F C),
  (W.UnceasingFrom fun x g f => g = f) ↔ W.Unceasing
@Becoming.Web.arisesFrom_of_more : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop},
  W.NoSplit R →
    ∀ {t : Nat} [(f : F) → Decidable (W.Continues R t f)] {before after : List F},
      (∀ (f : F), W.active t f → f ∈ before) →
        Becoming.Distinct after →
          (∀ (f : F), f ∈ after → W.active (t + 1) f) →
            before.length < after.length → ∃ f, f ∈ after ∧ W.ArisesFrom R t f
@Becoming.Web.unceasingFrom_of_growth : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop},
  W.NoSplit R →
    ∀ [(t : Nat) → (f : F) → Decidable (W.Continues R t f)] {alive : Nat → List F},
      W.Census alive → (∀ (N K : Nat), ∃ t, N ≤ t ∧ K < (alive t).length) → W.UnceasingFrom R
@Becoming.Flow.More.unceasingFrom : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop}
  [(t : Nat) → (f : F) → Decidable (W.Continues R t f)] {L : Becoming.Flow F C} {cs : List C} {alive : Nat → List F},
  W.Census alive →
    (∀ (t : Nat), Becoming.Distinct (L.present t)) → L.Taking W → L.More cs → W.NoSplit R → W.UnceasingFrom R
@Becoming.Web.continuation_reidentify : ∀ {F F' C : Type} (W : Becoming.Web F C) (σ : Becoming.Reidentify F F'),
  W.NoSplit σ.continuation ∧
    ∀ (t : Nat) (f : F), W.ArisesFrom σ.continuation t f ↔ (W.reidentify σ).Arises t (σ.new (t + 1) f)
@Becoming.turn_turn : ∀ {F : Type} {swap : F → F},
  (∀ (f : F), swap (swap f) = f) → ∀ (b : Bool) (f : F), Becoming.turn swap b (Becoming.turn swap b f) = f
@Becoming.turn_fixed : ∀ {F : Type} {swap : F → F} {f : F}, swap f = f → ∀ (b : Bool), Becoming.turn swap b f = f
Becoming.Turnover.swap_swap : ∀ (f : Becoming.Turnover.Formation), Becoming.Turnover.swap (Becoming.Turnover.swap f) = f
@Becoming.Turnover.pool_late : ∀ {t : Nat}, 1 ≤ t → Becoming.Turnover.pool t = 1
Becoming.Turnover.pool_not_renewed : ¬Becoming.Turnover.web.Renewed Becoming.Turnover.Condition.pool
