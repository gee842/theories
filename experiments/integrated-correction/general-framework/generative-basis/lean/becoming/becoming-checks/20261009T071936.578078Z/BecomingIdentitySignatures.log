    Becoming.Merge.merges 1 (Becoming.Garden.Kind.renewer, 0) (Becoming.Garden.Kind.renewer, 0) ∧
      Becoming.Merge.merges 1 (Becoming.Garden.Kind.grower, 0) (Becoming.Garden.Kind.renewer, 0) ∧
        Becoming.Garden.web.active 2 (Becoming.Garden.Kind.renewer, 0) ∧
          (Becoming.Garden.Kind.renewer, 0) ≠ (Becoming.Garden.Kind.grower, 0) ∧
