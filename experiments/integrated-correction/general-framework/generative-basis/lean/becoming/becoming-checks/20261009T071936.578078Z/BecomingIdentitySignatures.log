    ¬Becoming.Turnover.web.requires 0 (Becoming.turn Becoming.Turnover.swap (!b) f) Becoming.Turnover.Condition.pool
Becoming.Turnover.identified : Becoming.Turnover.web.Dependent ∧
  Becoming.Turnover.web.RenewingIn Becoming.Turnover.Formation.keeper ∧
    Becoming.Turnover.web.ConsumingIn Becoming.Turnover.Formation.drawer ∧
      (∀ (t : Nat), Becoming.Web.UnderminingAt t Becoming.Turnover.Formation.drawer) ∧
        (∀ (t : Nat) (f : Becoming.Turnover.Formation) (c : Becoming.Turnover.Condition),
            ¬Becoming.Turnover.web.Forms t f c) ∧
          ¬Becoming.Turnover.web.Unceasing
Becoming.Turnover.reidentified : Becoming.Turnover.turned.Dependent ∧
  (∀ (x : Becoming.Turnover.Formation), ¬Becoming.Turnover.turned.RenewingIn x) ∧
    Becoming.Turnover.turned.ConsumingIn Becoming.Turnover.Formation.drawer ∧
      Becoming.Turnover.turned.ConsumingIn Becoming.Turnover.Formation.idle ∧
        (∀ (t : Nat) (x : Becoming.Turnover.Formation), 1 ≤ t → ¬Becoming.Web.UnderminingAt t x) ∧
          Becoming.Turnover.turned.Dissolves 0 Becoming.Turnover.Formation.keeper Becoming.Turnover.Condition.spring ∧
            Becoming.Turnover.turned.Forms 0 Becoming.Turnover.Formation.keeper Becoming.Turnover.Condition.pool ∧
              Becoming.Turnover.turned.Unceasing ∧
                ¬Becoming.Turnover.turned.Depletes
                    [Becoming.Turnover.Condition.pool, Becoming.Turnover.Condition.spring] fun t =>
                    ∃ x, Becoming.Turnover.turned.Arises t x
Becoming.TideFlip.swap_swap : ∀ (f : Becoming.Tide.Formation), Becoming.TideFlip.swap (Becoming.TideFlip.swap f) = f
Becoming.TideFlip.tide_changes : ∀ (t : Nat),
  Becoming.Tide.tide t < Becoming.Tide.tide (t + 1) ∨ Becoming.Tide.tide (t + 1) < Becoming.Tide.tide t
