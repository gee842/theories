@Becoming.DerivationScopeProcesses.relative_on_scope : ∀ {S A R Index : Type} {k : Nat} {P : Generative.Process S A}
  {sense : S → A → S → Fin k} {response : R → List A} {B : S → Prop}
  {policy : Generative.InquirySufficiency.Policy A R k} {basis : Index → InquiryRoot.Formula S},
  (∀ (i : Index), InquiryRoot.Necessary (Becoming.Scope P sense response B policy) (basis i)) →
    ∀ {context : List (InquiryRoot.Formula S)} {p : InquiryRoot.Formula S},
      InquiryRoot.Derives basis context p →
        ∀ (t : S), Becoming.Scope P sense response B policy t → InquiryRoot.Holds context t → p t
@Becoming.DerivationScopeProcesses.discharged_on_scope : ∀ {S A R Index : Type} {k : Nat} {P : Generative.Process S A}
  {sense : S → A → S → Fin k} {response : R → List A} {B : S → Prop}
  {policy : Generative.InquirySufficiency.Policy A R k} {basis : Index → InquiryRoot.Formula S},
  (∀ (i : Index), InquiryRoot.Necessary (Becoming.Scope P sense response B policy) (basis i)) →
    ∀ {context : List (InquiryRoot.Formula S)} {p : InquiryRoot.Formula S},
      (∀ (q : InquiryRoot.Formula S),
          q ∈ context → InquiryRoot.Necessary (Becoming.Scope P sense response B policy) q) →
        InquiryRoot.Derives basis context p → InquiryRoot.Necessary (Becoming.Scope P sense response B policy) p
@Becoming.DerivationScopeProcesses.lemma_extension_on_scope : ∀ {S A R Index : Type} {k : Nat}
  {P : Generative.Process S A} {sense : S → A → S → Fin k} {response : R → List A} {B : S → Prop}
  {policy : Generative.InquirySufficiency.Policy A R k} {basis : Index → InquiryRoot.Formula S},
  (∀ (i : Index), InquiryRoot.Necessary (Becoming.Scope P sense response B policy) (basis i)) →
    ∀ {lemma : InquiryRoot.Formula S},
      InquiryRoot.Derives basis [] lemma →
        ∀ (p : InquiryRoot.Formula S),
          InquiryRoot.Derives (InquiryRoot.addDerived basis lemma) [] p →
            InquiryRoot.Necessary (Becoming.Scope P sense response B policy) p
@Becoming.DerivationScopeProcesses.countermodel_on_scope : ∀ {S A R Index : Type} {k : Nat} {P : Generative.Process S A}
  {sense : S → A → S → Fin k} {response : R → List A} {B : S → Prop}
  {policy : Generative.InquirySufficiency.Policy A R k} {basis : Index → InquiryRoot.Formula S},
  (∀ (i : Index), InquiryRoot.Necessary (Becoming.Scope P sense response B policy) (basis i)) →
    ∀ {p : InquiryRoot.Formula S},
      (∃ t, Becoming.Scope P sense response B policy t ∧ ¬p t) → ¬InquiryRoot.Derives basis [] p
