Becoming.Commons.prefix_does_not_decide : ∀ (h : Nat),
  ∃ renewing consuming,
    Becoming.Run.AgreeUpTo h renewing consuming ∧
      (∀ (t : Nat), t < h → consuming.act t = 2) ∧
        (∀ (t : Nat),
            t < h →
              Becoming.Web.RenewingAt t Becoming.Commons.Formation.focal ∧
                Becoming.Web.RenewingAt t Becoming.Commons.Formation.focal) ∧
          (Becoming.Commons.conditions.dependence.along renewing).RenewingIn Becoming.Commons.Formation.focal ∧
            (Becoming.Commons.conditions.dependence.along consuming).ConsumingIn Becoming.Commons.Formation.focal
Becoming.Commons.finite_reading_credits_consumption : ∀ (h : Nat)
  (reading : Becoming.Run Becoming.Commons.process → Prop),
  (∀ (r r' : Becoming.Run Becoming.Commons.process), Becoming.Run.AgreeUpTo h r r' → reading r → reading r') →
    (∀ (r : Becoming.Run Becoming.Commons.process),
        (Becoming.Commons.conditions.dependence.along r).RenewingIn Becoming.Commons.Formation.focal → reading r) →
      ∃ r, (Becoming.Commons.conditions.dependence.along r).ConsumingIn Becoming.Commons.Formation.focal ∧ reading r
