    ∀ {t k f : Nat},
      Becoming.BindingQueue.exchange n T t = 0 →
        0 < (Becoming.BindingQueue.flow n c T E).take t f k ∨ 0 < (Becoming.BindingQueue.flow n c T E).give t f k →
          k ∈ Becoming.EnclosedQueue.span n c a t
@Becoming.BindingQueue.closed : ∀ {n c a : Nat → Nat} {T E : Nat},
  Becoming.Tally n c a →
    ∀ {t : Nat},
      Becoming.BindingQueue.exchange n T t = 0 →
        (Becoming.BindingQueue.flow n c T E).ClosedAt (Becoming.EnclosedQueue.span n c a t) t
@Becoming.BindingQueue.not_closed : ∀ {n c : Nat → Nat} {T E t : Nat},
  0 < n t → ¬t = T → ∀ (cs : List Nat), ¬(Becoming.BindingQueue.flow n c T E).ClosedAt cs t
Becoming.World.bindingQueue_census : ∀ (n c : Nat → Nat) (T E : Nat),
  (Becoming.World.bindingQueue n c T E).web.Census (Becoming.Queue.line n c)
Becoming.World.bindingQueue_embodied : ∀ (n c : Nat → Nat) (T E : Nat), (Becoming.World.bindingQueue n c T E).Embodied
Becoming.World.bindingQueue_balanced : ∀ (n c : Nat → Nat) (T E : Nat), (Becoming.World.bindingQueue n c T E).Balanced
@Becoming.World.bindingQueue_acting : ∀ {n c a : Nat → Nat} {T E : Nat},
  Becoming.Tally n c a → (∀ (t : Nat), 0 < a t → 0 < n t) → (Becoming.World.bindingQueue n c T E).Acting
@Becoming.World.bindingQueue_taking : ∀ {n c a : Nat → Nat} {T E : Nat},
  Becoming.Tally n c a → (∀ (t : Nat), 0 < a t → 0 < n t) → (Becoming.World.bindingQueue n c T E).Taking
@Becoming.World.bindingQueue_exceeds : ∀ {n c a : Nat → Nat} {T E : Nat},
  Becoming.Tally n c a →
    ∀ {t : Nat},
      t = T →
        0 < n t →
          a t < E →
            ∀ (f : Nat),
              Becoming.total (Becoming.EnclosedQueue.span n c a t)
                    ((Becoming.World.bindingQueue n c T E).flow.give t f) +
                  1 ≤
                Becoming.total (Becoming.EnclosedQueue.span n c a t)
                  ((Becoming.World.bindingQueue n c T E).flow.take t f)
@Becoming.World.bindingQueue_dissipative : ∀ {n c a : Nat → Nat} {T E : Nat},
  Becoming.Tally n c a → (∀ (t : Nat), 0 < a t → 0 < n t) → a T < E → (Becoming.World.bindingQueue n c T E).Dissipative
@Becoming.World.bindingQueue_premised : ∀ {n c a : Nat → Nat} {T E : Nat},
  Becoming.Tally n c a → (∀ (t : Nat), 0 < a t → 0 < n t) → a T < E → (Becoming.World.bindingQueue n c T E).Premised
@Becoming.World.bindingQueue_binds : ∀ {n c a : Nat → Nat} {T E : Nat},
  Becoming.Tally n c a →
    (∀ (t : Nat), 0 < a t → 0 < n t) → a T < E → 0 < a T → (Becoming.World.bindingQueue n c T E).Binds
@Becoming.World.binding_counting : ∀ {Q : (Nat → Nat) → (Nat → Nat) → (Nat → Nat) → Prop},
  Becoming.Pointwise Q →
    ((∀ (n c a : Nat → Nat), Becoming.Tally n c a → (∀ (t : Nat), 0 < a t → 0 < n t) → (∃ t, 0 < a t) → Q n c a) ↔
      ∀ (w : Becoming.World) [inst : (t : Nat) → (x : w.Relatum) → Decidable (w.web.active t x)],
        w.Premised → w.Binds → w.CountsObey Q)
Becoming.World.binding_contingent : (Becoming.World.hatch.Premised ∧
    Becoming.World.hatch.Binds ∧ ¬Becoming.World.hatch.ArisingRecurs) ∧
  (Becoming.World.bindingQueue (fun x => 1) (fun x => 1) 0 2).Premised ∧
    (Becoming.World.bindingQueue (fun x => 1) (fun x => 1) 0 2).Binds ∧
      (Becoming.World.bindingQueue (fun x => 1) (fun x => 1) 0 2).ArisingRecurs ∧
        (Becoming.World.bindingQueue (fun x => 1) (fun x => 1) 0 2).CeasingRecurs
