@Becoming.pos_of_sign : ∀ {n : Nat}, 0 < Becoming.sign n → 0 < n
@Becoming.sign_pos : ∀ {n : Nat}, 0 < n → 0 < Becoming.sign n
@Becoming.eq_zero_of_not_pos : ∀ {n : Nat}, ¬0 < n → n = 0
@Becoming.le_total_of_mem : ∀ {α : Type} {q : α → Nat} {a : α} {as : List α}, a ∈ as → q a ≤ Becoming.total as q
@Becoming.total_eq_zero : ∀ {α : Type} {q : α → Nat} {as : List α},
  (∀ (a : α), a ∈ as → q a = 0) → Becoming.total as q = 0
@Becoming.total_le_at : ∀ {α : Type} {q : α → Nat} {a : α},
  (∀ (b : α), 0 < q b → b = a) → ∀ {as : List α}, Becoming.Distinct as → Becoming.total as q ≤ q a
@Becoming.Flow.DissipatesOn.replenishment_takers : ∀ {F C : Type} {L : Becoming.Flow F C} {cs : List C} {t : Nat},
  L.DissipatesOn cs t → L.replenishment cs t + L.takers cs t ≤ L.uptake cs t
@Becoming.Flow.DissipatesOn.takes_of_gives : ∀ {F C : Type} {L : Becoming.Flow F C} {cs : List C} {t : Nat},
  L.DissipatesOn cs t →
    ∀ {f : F}, f ∈ L.present t → 0 < Becoming.total cs (L.give t f) → 0 < Becoming.total cs (L.take t f)
@Becoming.Flow.Balances.runs_down : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W → ∀ {cs : List C} {t : Nat}, L.DissipatesOn cs t → W.stock cs (t + 1) + L.takers cs t ≤ W.stock cs t
@Becoming.Flow.Balances.takers_within : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    ∀ {cs : List C} (S N : Nat),
      (∀ (t : Nat), S ≤ t → L.DissipatesOn cs t) →
        W.stock cs (S + N) + Becoming.total (Becoming.steps S N) (L.takers cs) ≤ W.stock cs S
@Becoming.Flow.Balances.taking_ceases : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    ∀ {cs : List C} {T : Nat}, (∀ (t : Nat), T ≤ t → L.DissipatesOn cs t) → ¬∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < L.takers cs t
@Becoming.Flow.takers_pos_of_sub : ∀ {F C : Type} {L : Becoming.Flow F C} {cs ds : List C},
  (∀ (c : C), c ∈ cs → c ∈ ds) → ∀ {t : Nat}, 0 < L.takers cs t → 0 < L.takers ds t
@Becoming.Flow.Dissipative.opens : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    L.Dissipative →
      ∀ {cs ds : List C},
        Becoming.Distinct ds →
          (∀ (c : C), c ∈ cs → c ∈ ds) →
            (∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < L.takers cs t) → ∀ (T : Nat), ¬∀ (t : Nat), T ≤ t → L.ClosedAt ds t
@Becoming.Flow.Dissipative.finite_ceases : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    L.Dissipative →
      ∀ {all : List C},
        Becoming.Distinct all → (∀ (c : C), c ∈ all) → ∀ (cs : List C), ¬∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < L.takers cs t
@Becoming.Flow.More.takers_recur : ∀ {F C : Type} {L : Becoming.Flow F C} {cs : List C},
  L.More cs → ∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < L.takers cs t
@Becoming.Flow.takers_recur_of_arising : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {cs : List C},
  (∀ (N : Nat), ∃ t f, N ≤ t ∧ L.ArisesTaking W cs t f) → ∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < L.takers cs t
@Becoming.Flow.More.opens : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    L.Dissipative →
      ∀ {cs ds : List C},
        Becoming.Distinct ds →
          (∀ (c : C), c ∈ cs → c ∈ ds) → L.More cs → ∀ (T : Nat), ¬∀ (t : Nat), T ≤ t → L.ClosedAt ds t
@Becoming.Flow.opens_of_arising : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    L.Dissipative →
      ∀ {cs ds : List C},
        Becoming.Distinct ds →
          (∀ (c : C), c ∈ cs → c ∈ ds) →
            (∀ (N : Nat), ∃ t f, N ≤ t ∧ L.ArisesTaking W cs t f) → ∀ (T : Nat), ¬∀ (t : Nat), T ≤ t → L.ClosedAt ds t
Becoming.Frontier.burns : ∀ (n t : Nat),
  Becoming.Frontier.unburnt n (t + 1) + Becoming.Frontier.burning n t = Becoming.Frontier.unburnt n t
Becoming.Frontier.burning_self : ∀ (n : Nat), Becoming.Frontier.burning n n = 1
Becoming.Frontier.burning_at : ∀ (n t : Nat), 0 < Becoming.Frontier.burning n t → n = t
Becoming.Frontier.growers_take : ∀ (t n : Nat),
  (Becoming.total (Becoming.Frontier.growers n) fun f =>
      Becoming.Frontier.flow.take t f Becoming.Frontier.Condition.pool) =
    n
Becoming.Frontier.growers_give : ∀ (t : Nat) (c : Becoming.Frontier.Condition) (n : Nat),
  (Becoming.total (Becoming.Frontier.growers n) fun f => Becoming.Frontier.flow.give t f c) = 0
Becoming.Frontier.growers_take_fuel : ∀ (t m n : Nat),
  (Becoming.total (Becoming.Frontier.growers n) fun f =>
      Becoming.Frontier.flow.take t f (Becoming.Frontier.Condition.fuel m)) =
    0
Becoming.Frontier.balances : Becoming.Frontier.flow.Balances Becoming.Frontier.web
Becoming.Frontier.dissipative : Becoming.Frontier.flow.Dissipative
Becoming.Frontier.takers_pool : ∀ (t : Nat), Becoming.Frontier.flow.takers [Becoming.Frontier.Condition.pool] t = t
Becoming.Frontier.more : Becoming.Frontier.flow.More [Becoming.Frontier.Condition.pool]
@Becoming.Frontier.frontier : ∀ {ds : List Becoming.Frontier.Condition},
  Becoming.Distinct ds →
    Becoming.Frontier.Condition.pool ∈ ds → ∀ (T : Nat), ¬∀ (t : Nat), T ≤ t → Becoming.Frontier.flow.ClosedAt ds t
