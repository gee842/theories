@Becoming.Flow.not_inward_of_fed : ∀ {F C : Type} {L : Becoming.Flow F C} {ds : List C} {t : Nat},
  L.FedFromBeyond ds t → ¬L.Inward ds t
@Becoming.Flow.inward_of_not_fed : ∀ {F C : Type} {L : Becoming.Flow F C} [DecidableEq C] {ds : List C} {t : Nat},
  ¬L.FedFromBeyond ds t → L.Inward ds t
@Becoming.Flow.inward_iff_not_fed : ∀ {F C : Type} {L : Becoming.Flow F C} [DecidableEq C] {ds : List C} {t : Nat},
  L.Inward ds t ↔ ¬L.FedFromBeyond ds t
@Becoming.Flow.fed_of_not_inward : ∀ {F C : Type} {L : Becoming.Flow F C} [DecidableEq C] {ds : List C} {N : Nat},
  (¬∀ (t : Nat), N ≤ t → L.Inward ds t) → ¬∀ (t : Nat), N ≤ t → ¬L.FedFromBeyond ds t
@Becoming.Flow.fed_from_beyond_from : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} [DecidableEq C]
  {ds : List C},
  Becoming.Distinct ds →
    ∀ {T₀ : Nat},
      (∀ (t : Nat), T₀ ≤ t → L.Around ds t) →
        (∀ (t : Nat), T₀ ≤ t → L.BalancesOn W ds t) →
          (∀ (t : Nat), T₀ ≤ t → ∀ (es : List C), Becoming.Distinct es → L.ClosedAt es t → L.DissipatesOn es t) →
            (∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < L.takers ds t) → ∀ (N : Nat), ¬∀ (t : Nat), N ≤ t → ¬L.FedFromBeyond ds t
@Becoming.Flow.rising_fed_from_beyond_from : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  [DecidableEq C] {ds : List C},
  Becoming.Distinct ds →
    ∀ {T₀ : Nat},
      (∀ (t : Nat), T₀ ≤ t → L.Around ds t) →
        (∀ (t : Nat), T₀ ≤ t → L.BalancesOn W ds t) →
          (∀ (t : Nat), T₀ ≤ t → ∀ (es : List C), Becoming.Distinct es → L.ClosedAt es t → L.DissipatesOn es t) →
            (∀ (N : Nat), ∃ t c, N ≤ t ∧ c ∈ ds ∧ W.Rises t c) →
              ∀ (N : Nat), ¬∀ (t : Nat), N ≤ t → ¬L.FedFromBeyond ds t
@Becoming.Flow.fed_from_beyond : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} [DecidableEq C],
  L.Balances W →
    L.Dissipative →
      ∀ {ds : List C},
        Becoming.Distinct ds →
          ∀ {T₀ : Nat},
            (∀ (t : Nat), T₀ ≤ t → L.Around ds t) →
              (∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < L.takers ds t) → ∀ (N : Nat), ¬∀ (t : Nat), N ≤ t → ¬L.FedFromBeyond ds t
@Becoming.Flow.rising_fed_from_beyond : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} [DecidableEq C],
  L.Balances W →
    L.Dissipative →
      ∀ {ds : List C},
        Becoming.Distinct ds →
          ∀ {T₀ : Nat},
            (∀ (t : Nat), T₀ ≤ t → L.Around ds t) →
              (∀ (N : Nat), ∃ t c, N ≤ t ∧ c ∈ ds ∧ W.Rises t c) →
                ∀ (N : Nat), ¬∀ (t : Nat), N ≤ t → ¬L.FedFromBeyond ds t
@Becoming.Flow.joint_keeps_at : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat} {c : C},
  L.BalancesOn W [c] t → L.WithinJoint t c → W.level t c ≤ W.level (t + 1) c
@Becoming.Flow.joint_keeps : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W → ∀ {t : Nat} {c : C}, L.WithinJoint t c → W.level t c ≤ W.level (t + 1) c
@Becoming.Flow.excess_lowers_at : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat} {c : C},
  L.BalancesOn W [c] t → L.given t c < L.taken t c → W.level (t + 1) c + 1 ≤ W.level t c
@Becoming.Flow.excess_lowers : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W → ∀ {t : Nat} {c : C}, L.given t c < L.taken t c → W.level (t + 1) c + 1 ≤ W.level t c
@Becoming.Flow.excess_bounded_at : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {c : C} {T : Nat}
  (n : Nat),
  (∀ (k : Nat), k < n → L.BalancesOn W [c] (T + k)) →
    (∀ (k : Nat), k < n → L.given (T + k) c < L.taken (T + k) c) → W.level (T + n) c + n ≤ W.level T c
@Becoming.Flow.excess_bounded : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    ∀ {c : C} {T : Nat} (n : Nat),
      (∀ (k : Nat), k < n → L.given (T + k) c < L.taken (T + k) c) → W.level (T + n) c + n ≤ W.level T c
@Becoming.Flow.net_give_raises_at : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat} {c : C},
  L.BalancesOn W [c] t → L.taken t c < L.given t c → W.level t c + 1 ≤ W.level (t + 1) c
@Becoming.Flow.net_give_bounded_at : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {c : C} {T : Nat}
  (n : Nat),
  (∀ (k : Nat), k < n → L.BalancesOn W [c] (T + k)) →
    (∀ (k : Nat), k < n → W.level T c ≤ W.level (T + k) c → L.taken (T + k) c < L.given (T + k) c) →
      W.level T c + n ≤ W.level (T + n) c
@Becoming.Flow.restores_at : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {c : C} {m T : Nat},
  (∀ (k : Nat), k < m - W.level T c → L.BalancesOn W [c] (T + k)) →
    (∀ (k : Nat), k < m - W.level T c → W.level T c ≤ W.level (T + k) c → L.taken (T + k) c < L.given (T + k) c) →
      m ≤ W.level (T + (m - W.level T c)) c
@Becoming.Flow.restores : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    ∀ {c : C} {m T : Nat},
      (∀ (k : Nat), k < m - W.level T c → W.level T c ≤ W.level (T + k) c → L.taken (T + k) c < L.given (T + k) c) →
        m ≤ W.level (T + (m - W.level T c)) c
@Becoming.Flow.stays_below_at : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {c : C} {m T : Nat},
  W.level T c < m →
    ∀ (n : Nat),
      (∀ (k : Nat), k < n → L.BalancesOn W [c] (T + k)) →
        (∀ (k : Nat) (f : F),
            k < n → f ∈ L.present (T + k) → 0 < L.give (T + k) f c → W.requires (T + k) f c ∧ m ≤ W.need (T + k) f c) →
          (∀ (k : Nat), k < n → L.GiversSupported W (T + k) c) → W.level (T + n) c < m
@Becoming.Flow.stays_below : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {c : C} {m : Nat},
          (∀ (t : Nat) (f : F), f ∈ L.present t → 0 < L.give t f c → W.requires t f c ∧ m ≤ W.need t f c) →
            ∀ {T : Nat}, W.level T c < m → ∀ (n : Nat), W.level (T + n) c < m
@Becoming.Flow.ends_below_at : ∀ {F C : Type} {W : Becoming.Web F C} {c : C} {m t : Nat} {g : F},
  (W.active t g → W.Supported t g) → W.level t c < m → W.requires t g c → m ≤ W.need t g c → ¬W.active t g
@Becoming.Flow.ends_below : ∀ {F C : Type} {W : Becoming.Web F C},
  W.Dependent →
    ∀ {c : C} {m T : Nat},
      (∀ (n : Nat), W.level (T + n) c < m) →
        ∀ (n : Nat) (g : F), W.requires (T + n) g c → m ≤ W.need (T + n) g c → ¬W.active (T + n) g
@Becoming.Flow.joint_excess_ends_at : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {c : C}
  {m T n k : Nat} {g : F},
  (∀ (j : Nat), j < n + k → L.BalancesOn W [c] (T + j)) →
    (∀ (j : Nat) (f : F),
        j < n + k → f ∈ L.present (T + j) → 0 < L.give (T + j) f c → W.requires (T + j) f c ∧ m ≤ W.need (T + j) f c) →
      (∀ (j : Nat), j < n + k → L.GiversSupported W (T + j) c) →
        (∀ (j : Nat), j < n → L.given (T + j) c < L.taken (T + j) c) →
          W.level T c < n + m →
            (W.active (T + n + k) g → W.Supported (T + n + k) g) →
              W.requires (T + n + k) g c → m ≤ W.need (T + n + k) g c → ¬W.active (T + n + k) g
@Becoming.Flow.joint_excess_ends : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {c : C} {m : Nat},
          (∀ (t : Nat) (f : F), f ∈ L.present t → 0 < L.give t f c → W.requires t f c ∧ m ≤ W.need t f c) →
            ∀ {T n : Nat},
              (∀ (k : Nat), k < n → L.given (T + k) c < L.taken (T + k) c) →
                W.level T c < n + m →
                  ∀ (k : Nat) (g : F), W.requires (T + n + k) g c → m ≤ W.need (T + n + k) g c → ¬W.active (T + n + k) g
@Becoming.Web.embodiedArising_fed_from_beyond : ∀ {X : Type} {W : Becoming.Web X X} {L : Becoming.Flow X X}
  [DecidableEq X],
  L.Balances W →
    L.Dissipative →
      ∀ {ds : List X},
        Becoming.Distinct ds →
          ∀ {T₀ : Nat},
            (∀ (t : Nat), T₀ ≤ t → L.Around ds t) →
              (∀ (N : Nat), ∃ t x, N ≤ t ∧ x ∈ ds ∧ W.Embodied x ∧ W.Arises t x) →
                ∀ (N : Nat), ¬∀ (t : Nat), N ≤ t → ¬L.FedFromBeyond ds t
