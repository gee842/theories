Becoming.Amounts.whole_times_one : ∀ (n : Nat), Becoming.Amounts.whole.times n 1 = n
Becoming.Amounts.whole_within : ∀ (a : Nat), ¬Becoming.Amounts.whole.le (Becoming.Amounts.whole.times (a + 1) 1) a
Becoming.Amounts.whole_archimedean : Becoming.Amounts.whole.Archimedean
@Becoming.Amounts.whole_losing_steps : ∀ {s d : Nat → Nat} {T : Nat},
  (∀ (t : Nat), T ≤ t → s (t + 1) + d t ≤ s t) →
    ∀ {f : Nat → Nat},
      T ≤ f 0 → (∀ (i : Nat), f i < f (i + 1)) → ∀ (k : Nat), (∀ (i : Nat), i < k → 1 ≤ d (f i)) → k ≤ s T
