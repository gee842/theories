  (∀ (t : Nat), T ≤ t → M.le (M.add (s (t + 1)) (d t)) (s t)) → ∀ (t : Nat), T ≤ t → M.le (s (t + 1)) (s t)
@Becoming.Amounts.large_losses_from : ∀ {A : Type} {M : Becoming.Amounts A} {s d : Nat → A} {ε : A} {T : Nat},
  (∀ (t : Nat), T ≤ t → M.le (M.add (s (t + 1)) (d t)) (s t)) →
    ∀ {f : Nat → Nat},
      T ≤ f 0 →
        (∀ (i : Nat), f i < f (i + 1)) →
          ∀ (k : Nat),
            (∀ (i : Nat), i < k → M.le ε (d (f i))) → ∃ u, T ≤ u ∧ u ≤ f k ∧ M.le (M.add (s u) (M.times k ε)) (s T)
@Becoming.Amounts.large_losses_within : ∀ {A : Type} {M : Becoming.Amounts A} {s d : Nat → A} {ε : A} {T : Nat},
  (∀ (t : Nat), T ≤ t → M.le (M.add (s (t + 1)) (d t)) (s t)) →
    ∀ {f : Nat → Nat},
      T ≤ f 0 →
        (∀ (i : Nat), f i < f (i + 1)) → ∀ (k : Nat), (∀ (i : Nat), i < k → M.le ε (d (f i))) → M.le (M.times k ε) (s T)
@Becoming.Amounts.few_large_losses : ∀ {A : Type} {M : Becoming.Amounts A} {s d : Nat → A} {ε : A} {T m : Nat},
  (∀ (t : Nat), T ≤ t → M.le (M.add (s (t + 1)) (d t)) (s t)) →
    ¬M.le (M.times m ε) (s T) → ¬∃ f, T ≤ f 0 ∧ (∀ (i : Nat), f i < f (i + 1)) ∧ ∀ (i : Nat), i < m → M.le ε (d (f i))
