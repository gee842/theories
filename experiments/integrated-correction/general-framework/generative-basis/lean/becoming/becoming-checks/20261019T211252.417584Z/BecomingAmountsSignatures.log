@Becoming.Amounts.add_le_add_left : ∀ {A : Type} {M : Becoming.Amounts A} {a b : A} (c : A),
  M.le a b → M.le (M.add c a) (M.add c b)
@Becoming.Amounts.le_add_right : ∀ {A : Type} {M : Becoming.Amounts A} (a b : A), M.le a (M.add a b)
@Becoming.Amounts.le_add_left : ∀ {A : Type} {M : Becoming.Amounts A} (a b : A), M.le a (M.add b a)
@Becoming.Amounts.add_swap : ∀ {A : Type} {M : Becoming.Amounts A} (x y z : A),
  M.add x (M.add y z) = M.add (M.add x z) y
@Becoming.Amounts.times_le : ∀ {A : Type} {M : Becoming.Amounts A} {a b : A},
  M.le a b → ∀ (m : Nat), M.le (M.times m a) (M.times m b)
@Becoming.Amounts.still_le : ∀ {A : Type} {M : Becoming.Amounts A} {s : Nat → A} {T : Nat},
  (∀ (t : Nat), T ≤ t → ¬¬M.le (s (t + 1)) (s t)) → ∀ (k u : Nat), T ≤ u → ¬¬M.le (s (u + k)) (s u)
@Becoming.Amounts.losses_within : ∀ {A : Type} {M : Becoming.Amounts A} {s d : Nat → A} {T : Nat} (n : Nat),
  (∀ (t : Nat), T ≤ t → t < T + n → M.le (M.add (s (t + 1)) (d t)) (s t)) → M.le (M.add (s (T + n)) (M.sum d T n)) (s T)
@Becoming.Amounts.loses_times : ∀ {A : Type} {M : Becoming.Amounts A} {s : Nat → A} {ε : A} {P : Nat → Prop} {T : Nat},
  (∀ (t : Nat), T ≤ t → ¬¬M.le (s (t + 1)) (s t)) →
    (∀ (t : Nat), T ≤ t → P t → ¬¬M.le (M.add (s (t + 1)) ε) (s t)) →
      (∀ (N : Nat), T ≤ N → ¬¬∃ t, N ≤ t ∧ P t) → ∀ (m : Nat), ¬¬∃ u, T ≤ u ∧ M.le (M.add (s u) (M.times m ε)) (s T)
@Becoming.Amounts.rests_unrefuted : ∀ {A : Type} {M : Becoming.Amounts A} {s : Nat → A} {ε : A} {P : Nat → Prop}
  {T m : Nat},
  (∀ (t : Nat), T ≤ t → ¬¬M.le (s (t + 1)) (s t)) →
    (∀ (t : Nat), T ≤ t → P t → ¬¬M.le (M.add (s (t + 1)) ε) (s t)) →
      ¬M.le (M.times m ε) (s T) → ¬∀ (N : Nat), T ≤ N → ¬¬∃ t, N ≤ t ∧ P t
@Becoming.Amounts.rests : ∀ {A : Type} {M : Becoming.Amounts A} {s : Nat → A} {ε : A} {P : Nat → Prop} {T m : Nat},
  (∀ (t : Nat), T ≤ t → M.le (s (t + 1)) (s t)) →
    (∀ (t : Nat), T ≤ t → P t → M.le (M.add (s (t + 1)) ε) (s t)) →
      ¬M.le (M.times m ε) (s T) → ¬∀ (N : Nat), ∃ t, N ≤ t ∧ P t
@Becoming.Amounts.rests_of_archimedean : ∀ {A : Type} {M : Becoming.Amounts A},
  M.Archimedean →
    ∀ {s : Nat → A} {ε : A} {P : Nat → Prop} {T : Nat},
      ¬M.le ε M.zero →
        (∀ (t : Nat), T ≤ t → M.le (s (t + 1)) (s t)) →
          (∀ (t : Nat), T ≤ t → P t → M.le (M.add (s (t + 1)) ε) (s t)) → ¬∀ (N : Nat), ∃ t, N ≤ t ∧ P t
@Becoming.Amounts.family_still : ∀ {A : Type} {M : Becoming.Amounts A} {s u r : Nat → A} {T : Nat},
  (∀ (t : Nat), T ≤ t → M.le (M.add (s (t + 1)) (u t)) (M.add (s t) (r t))) →
    (∀ (t : Nat), T ≤ t → M.le (r t) (u t)) → ∀ (t : Nat), T ≤ t → M.le (s (t + 1)) (s t)
@Becoming.Amounts.family_loses : ∀ {A : Type} {M : Becoming.Amounts A} {s u r : Nat → A} {ε : A} {P : Nat → Prop}
  {T : Nat},
  (∀ (t : Nat), T ≤ t → M.le (M.add (s (t + 1)) (u t)) (M.add (s t) (r t))) →
    (∀ (t : Nat), T ≤ t → P t → M.le (M.add (r t) ε) (u t)) →
      ∀ (t : Nat), T ≤ t → P t → M.le (M.add (s (t + 1)) ε) (s t)
@Becoming.Amounts.family_rests : ∀ {A : Type} {M : Becoming.Amounts A} {s u r : Nat → A} {ε : A} {P : Nat → Prop}
  {T m : Nat},
  (∀ (t : Nat), T ≤ t → M.le (M.add (s (t + 1)) (u t)) (M.add (s t) (r t))) →
    (∀ (t : Nat), T ≤ t → M.le (r t) (u t)) →
      (∀ (t : Nat), T ≤ t → P t → M.le (M.add (r t) ε) (u t)) →
        ¬M.le (M.times m ε) (s T) → ¬∀ (N : Nat), ∃ t, N ≤ t ∧ P t
