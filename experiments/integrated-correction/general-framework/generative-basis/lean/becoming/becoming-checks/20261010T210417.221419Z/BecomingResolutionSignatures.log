  L.BalancesAt r W →
    L.Dissipative →
      ∀ {cs : List C},
        Becoming.Distinct cs →
          ∀ {T : Nat},
            (∀ (t : Nat), T ≤ t → L.ClosedAt cs t) →
              R T = 1 →
                (∀ (t : Nat), T ≤ t → R (t + 1) = r t * R t) →
                  (∀ (t : Nat), T ≤ t → 0 < r t) →
                    ∀ (q n : Nat),
                      (Becoming.total (Becoming.steps T n) fun u =>
                          Becoming.mark (Becoming.LosesQuantum r R (W.stock cs) q u)) ≤
                        q * W.stock cs T
