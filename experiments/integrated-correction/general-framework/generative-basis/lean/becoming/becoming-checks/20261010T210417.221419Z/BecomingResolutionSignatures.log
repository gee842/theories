@Becoming.units_pos : ∀ {r R : Nat → Nat} {T : Nat},
  R T = 1 → (∀ (t : Nat), T ≤ t → R (t + 1) = r t * R t) → (∀ (t : Nat), T ≤ t → 0 < r t) → ∀ {t : Nat}, T ≤ t → 0 < R t
@Becoming.losses_invariant : ∀ {r R s k : Nat → Nat} {q T : Nat},
  R T = 1 →
    (∀ (t : Nat), T ≤ t → R (t + 1) = r t * R t) →
      (∀ (t : Nat), T ≤ t → q * s (t + 1) + k t * R (t + 1) ≤ q * (r t * s t)) →
        ∀ (n : Nat), q * s (T + n) + Becoming.total (Becoming.steps T n) k * R (T + n) ≤ q * s T * R (T + n)
@Becoming.losses_bound : ∀ {r R s k : Nat → Nat} {q T : Nat},
  R T = 1 →
    (∀ (t : Nat), T ≤ t → R (t + 1) = r t * R t) →
      (∀ (t : Nat), T ≤ t → 0 < r t) →
        (∀ (t : Nat), T ≤ t → q * s (t + 1) + k t * R (t + 1) ≤ q * (r t * s t)) →
          ∀ (n : Nat), Becoming.total (Becoming.steps T n) k ≤ q * s T
@Becoming.unbounded_of_recurring : ∀ {k : Nat → Nat} {T : Nat},
  (∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < k t) → ∀ (m : Nat), ∃ n, m ≤ Becoming.total (Becoming.steps T n) k
@Becoming.bounded_not_recurring : ∀ {k : Nat → Nat} {T B : Nat},
  (∀ (n : Nat), Becoming.total (Becoming.steps T n) k ≤ B) → ¬∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < k t
@Becoming.quantum_step : ∀ {r R s : Nat → Nat} {q t : Nat},
  s (t + 1) ≤ r t * s t → q * s (t + 1) + Becoming.mark (Becoming.LosesQuantum r R s q t) * R (t + 1) ≤ q * (r t * s t)
@Becoming.quantum_bound : ∀ {r R s : Nat → Nat} {q T : Nat},
  R T = 1 →
    (∀ (t : Nat), T ≤ t → R (t + 1) = r t * R t) →
      (∀ (t : Nat), T ≤ t → 0 < r t) →
        (∀ (t : Nat), T ≤ t → s (t + 1) ≤ r t * s t) →
          ∀ (n : Nat),
            (Becoming.total (Becoming.steps T n) fun u => Becoming.mark (Becoming.LosesQuantum r R s q u)) ≤ q * s T
@Becoming.quantum_not_recurring : ∀ {r R s : Nat → Nat} {q T : Nat},
  R T = 1 →
    (∀ (t : Nat), T ≤ t → R (t + 1) = r t * R t) →
      (∀ (t : Nat), T ≤ t → 0 < r t) →
        (∀ (t : Nat), T ≤ t → s (t + 1) ≤ r t * s t) → ¬∀ (N : Nat), ∃ t, N ≤ t ∧ Becoming.LosesQuantum r R s q t
