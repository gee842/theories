Becoming.sign_le : ∀ (n : Nat), Becoming.sign n ≤ n
Becoming.sign_le_one : ∀ (n : Nat), Becoming.sign n ≤ 1
@Becoming.le_mul_sign : ∀ {g : Nat} (n : Nat), n ≤ g → n ≤ g * Becoming.sign n
@Becoming.total_le : ∀ {α : Type} {p q : α → Nat} (as : List α),
  (∀ (a : α), a ∈ as → p a ≤ q a) → Becoming.total as p ≤ Becoming.total as q
@Becoming.total_add : ∀ {α : Type} (p q : α → Nat) (as : List α),
  (Becoming.total as fun a => p a + q a) = Becoming.total as p + Becoming.total as q
@Becoming.total_zero : ∀ {α : Type} (as : List α), (Becoming.total as fun x => 0) = 0
@Becoming.total_mul : ∀ {α : Type} (g : Nat) (q : α → Nat) (as : List α),
  (Becoming.total as fun a => g * q a) = g * Becoming.total as q
@Becoming.total_swap : ∀ {α β : Type} (q : α → β → Nat) (bs : List β) (as : List α),
  (Becoming.total as fun a => Becoming.total bs (q a)) = Becoming.total bs fun b => Becoming.total as fun a => q a b
@Becoming.total_pos : ∀ {α : Type} {q : α → Nat} (as : List α), 0 < Becoming.total as q → ∃ a, a ∈ as ∧ 0 < q a
@Becoming.count_le : ∀ {α : Type} (q : α → Nat) (as : List α), Becoming.count as q ≤ Becoming.total as q
@Becoming.total_le_count : ∀ {α : Type} {q : α → Nat} {g : Nat} (as : List α),
  (∀ (a : α), a ∈ as → q a ≤ g) → Becoming.total as q ≤ g * Becoming.count as q
@Becoming.steps_ge : ∀ {q : Nat → Nat} {K : Nat} (T N : Nat),
  (∀ (t : Nat), T ≤ t → K ≤ q t) → K * N ≤ Becoming.total (Becoming.steps T N) q
@Becoming.steps_le : ∀ {q : Nat → Nat} {R : Nat} (T N : Nat),
  (∀ (t : Nat), T ≤ t → q t ≤ R) → Becoming.total (Becoming.steps T N) q ≤ R * N
@Becoming.Flow.ledger : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W → ∀ (cs : List C) (t : Nat), W.stock cs (t + 1) + L.load cs t = W.stock cs t + L.supply cs t
@Becoming.Flow.accumulates : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    ∀ (cs : List C) (T N : Nat),
      W.stock cs (T + N) + Becoming.total (Becoming.steps T N) (L.load cs) =
        W.stock cs T + Becoming.total (Becoming.steps T N) (L.supply cs)
@Becoming.Flow.Balances.renewedBy : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W → L.Acting W → W.RenewedBy fun t f c => f ∈ L.present t ∧ 0 < L.give t f c
@Becoming.Flow.takers_le_load : ∀ {F C : Type} {L : Becoming.Flow F C} (cs : List C) (t : Nat),
  L.takers cs t ≤ L.load cs t
@Becoming.Flow.supply_le : ∀ {F C : Type} {L : Becoming.Flow F C} {cs : List C} {g : Nat},
  L.Capacity cs g → ∀ (t : Nat), L.supply cs t ≤ g * L.renewers cs t
@Becoming.Flow.More.supply_unbounded : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {cs : List C},
  L.Balances W → L.More cs → ∀ (R T₀ : Nat), ¬∀ (t : Nat), T₀ ≤ t → L.supply cs t ≤ R
@Becoming.Flow.More.renewers_unbounded : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {cs : List C}
  {g : Nat}, L.Balances W → L.Capacity cs g → L.More cs → ∀ (M T₀ : Nat), ¬∀ (t : Nat), T₀ ≤ t → L.renewers cs t ≤ M
Becoming.Garden.taken_eq : ∀ (t : Nat), Becoming.Garden.flow.taken t () = t
Becoming.Garden.given_eq : ∀ (t : Nat), Becoming.Garden.flow.given t () = t
Becoming.Garden.takers_eq : ∀ (t : Nat), Becoming.Garden.flow.takers [()] t = t
Becoming.Garden.present_active : ∀ (t : Nat) (f : Becoming.Garden.Kind × Nat), f ∈ Becoming.Garden.present t → f.snd < t
Becoming.Garden.more : Becoming.Garden.flow.Balances Becoming.Garden.web ∧
  Becoming.Garden.flow.Acting Becoming.Garden.web ∧
    Becoming.Garden.flow.Capacity [()] 1 ∧
      Becoming.Garden.web.Dependent ∧
        (∀ (t : Nat), Becoming.Garden.web.Arises t (Becoming.Garden.Kind.renewer, t)) ∧
          Becoming.Garden.web.Unceasing ∧ Becoming.Garden.flow.More [()]
Becoming.Bloom.balances : ∀ (t : Nat),
  Becoming.Bloom.web.level (t + 1) () + Becoming.Bloom.flow.taken t () =
    Becoming.Bloom.web.level t () + Becoming.Bloom.flow.given t ()
Becoming.Bloom.takers_le : ∀ (t : Nat), Becoming.Bloom.flow.takers [()] t ≤ 1
Becoming.Bloom.not_more : Becoming.Bloom.flow.Balances Becoming.Bloom.web ∧
  Becoming.Bloom.flow.Acting Becoming.Bloom.web ∧
    Becoming.Bloom.flow.Capacity [()] 1 ∧ Becoming.Bloom.web.Unceasing ∧ ¬Becoming.Bloom.flow.More [()]
