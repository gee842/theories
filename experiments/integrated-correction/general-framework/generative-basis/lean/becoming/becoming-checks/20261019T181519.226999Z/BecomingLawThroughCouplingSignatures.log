@Becoming.Run.recordUnder_steps : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A} (r : Becoming.Run P)
  {E : S → S → Prop},
  (∀ (x : S), E x x) → ∀ (t n : Nat), n < t → (r.recordUnder E t).step (r.state n) (r.act n) (r.state (n + 1))
@Becoming.Run.recordUnder_goAlike : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A} (r : Becoming.Run P)
  {E : S → S → Prop},
  Equivalence E → ∀ {t : Nat}, r.ConsistentUnder E t → Becoming.GoAlikeUnder (r.recordUnder E t) id E
@Becoming.Run.law_under_iff : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A} (r : Becoming.Run P)
  {E : S → S → Prop},
  Equivalence E →
    ∀ (t : Nat),
      (∃ Q, Becoming.GoAlikeUnder Q id E ∧ ∀ (n : Nat), n < t → Q.step (r.state n) (r.act n) (r.state (n + 1))) ↔
        r.ConsistentUnder E t
@Becoming.Run.ConsistentUnder.earlier : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A}
  {r : Becoming.Run P} {E : S → S → Prop} {t t' : Nat}, r.ConsistentUnder E t' → t ≤ t' → r.ConsistentUnder E t
@Becoming.Run.no_law_under_later : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A} (r : Becoming.Run P)
  {E : S → S → Prop},
  Equivalence E →
    ∀ {t t' : Nat},
      t ≤ t' →
        (¬∃ Q, Becoming.GoAlikeUnder Q id E ∧ ∀ (n : Nat), n < t → Q.step (r.state n) (r.act n) (r.state (n + 1))) →
          ¬∃ Q, Becoming.GoAlikeUnder Q id E ∧ ∀ (n : Nat), n < t' → Q.step (r.state n) (r.act n) (r.state (n + 1))
@Becoming.Run.consistentUnder_of_goAlikeUnder : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A}
  (r : Becoming.Run P) {E : S → S → Prop}, Becoming.GoAlikeUnder P id E → ∀ (t : Nat), r.ConsistentUnder E t
@Becoming.Run.consistentUnder_eq_iff : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A} {D : Type u_3}
  (r : Becoming.Run P) (π : S → D) (t : Nat), r.ConsistentUnder (fun x y => π x = π y) t ↔ r.ConsistentThrough π t
@Becoming.Conditions.alikeAt_equivalence : ∀ {S : Type u_1} {F C : Type} (K : Becoming.Conditions S F C)
  (obs : F → C → Prop) (g : F), Equivalence (K.AlikeAt obs g)
@Becoming.Conditions.alikeThrough_iff : ∀ {S : Type u_1} {A : Type u_2} {F C : Type} (K : Becoming.Conditions S F C)
  {P : Generative.Process S A} (r r' : Becoming.Run P) (obs : F → C → Prop) (g : F) (t : Nat),
  (K.dependence.along r).AlikeThrough obs g (K.dependence.along r).level (K.dependence.along r').level t ↔
    K.AlikeAt obs g (r.state t) (r'.state t)
@Becoming.Conditions.alikeAt_iff_alikeThrough : ∀ {S : Type u_1} {A : Type u_2} {F C : Type}
  (K : Becoming.Conditions S F C) {P : Generative.Process S A} (r : Becoming.Run P) (obs : F → C → Prop) (g : F)
  (n m t : Nat),
  K.AlikeAt obs g (r.state n) (r.state m) ↔
    (K.dependence.along r).AlikeThrough obs g (fun x => K.level (r.state n)) (fun x => K.level (r.state m)) t
@Becoming.Run.law_through_coupling_iff : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A} {F C : Type}
  (K : Becoming.Conditions S F C) (r : Becoming.Run P) (obs : F → C → Prop) (g : F) (t : Nat),
  (∃ Q,
      Becoming.GoAlikeUnder Q id (K.AlikeAt obs g) ∧
        ∀ (n : Nat), n < t → Q.step (r.state n) (r.act n) (r.state (n + 1))) ↔
    r.ConsistentUnder (K.AlikeAt obs g) t
Becoming.Unseen.determined : Becoming.Determined Becoming.Unseen.process
@Becoming.Unseen.admits : ∀ {x : Nat × Nat}, 1 ≤ x.fst → Becoming.Unseen.conditions.AdmitsAt x ()
Becoming.Unseen.not_admits_zero : ¬Becoming.Unseen.conditions.AdmitsAt (0, 0) ()
Becoming.Unseen.inconsistent : ¬Becoming.Unseen.run.ConsistentUnder
    (Becoming.Unseen.conditions.AlikeAt Becoming.thresholdOnly ()) 2
@Becoming.Unseen.no_law : ∀ {t : Nat},
  2 ≤ t →
    ¬∃ Q,
        Becoming.GoAlikeUnder Q id (Becoming.Unseen.conditions.AlikeAt Becoming.thresholdOnly ()) ∧
          ∀ (n : Nat),
            n < t → Q.step (Becoming.Unseen.run.state n) (Becoming.Unseen.run.act n) (Becoming.Unseen.run.state (n + 1))
Becoming.Unseen.first_apart : ∀ (m : Nat),
  ¬Becoming.Unseen.conditions.AlikeAt Becoming.Unseen.observing () (1, 1) (Becoming.Unseen.state (m + 1))
Becoming.Unseen.consistent_observing : ∀ (t : Nat),
  Becoming.Unseen.run.ConsistentUnder (Becoming.Unseen.conditions.AlikeAt Becoming.Unseen.observing ()) t
