        S Becoming.World.Premise.acting = true ∧ S Becoming.World.Premise.transmitting = true)
@Becoming.World.counting_free_parts_counted : ∀ {Q : (Nat → Nat) → (Nat → Nat) → (Nat → Nat) → Prop},
  ((∀ (n c a : Nat → Nat), Becoming.Tally n c a → Q n c a) ↔
      ∀ (w : Becoming.World),
        w.Dependent → w.Balanced → w.Acting → w.Taking → w.Dissipative → w.Transmitting → w.CountsHold Q) ∧
    ((∀ (n c a : Nat → Nat), Becoming.Tally n c a → Q n c a) ↔
      ∀ (w : Becoming.World),
        w.Dependent → w.Acting → w.Taking → w.Dissipative → w.Embodied → w.Transmitting → w.CountsHold Q)
Becoming.World.counting_binds_jointly_counted : (∀ (w : Becoming.World),
    w.Balanced → w.Acting → w.ArisingEmbodied → w.CountsHold fun n x a => ∀ (t : Nat), 0 < a t → 0 < n t) ∧
  (¬(Becoming.World.queue Becoming.Queue.lone fun x => 0).CountsHold fun n x a => ∀ (t : Nat), 0 < a t → 0 < n t) ∧
    ¬(Becoming.World.embodiedQueue Becoming.Queue.lone fun x => 0).CountsHold fun n x a =>
        ∀ (t : Nat), 0 < a t → 0 < n t
@Becoming.World.enclosed_iff_finite_counting_counted : ∀ {Q : (Nat → Nat) → (Nat → Nat) → (Nat → Nat) → Prop},
  (∀ (w : Becoming.World), w.Premised → (∃ T, ∀ (t : Nat), T ≤ t → w.flow.Enclosed t) → w.CountsHold Q) ↔
    ∀ (w : Becoming.World), w.Premised → w.Finite → w.CountsHold Q
Becoming.World.enclosed_iff_finite_counting_under_counted : ∀ (S : Becoming.World.Premise → Bool),
  (∀ (Q : (Nat → Nat) → (Nat → Nat) → (Nat → Nat) → Prop),
      (∀ (w : Becoming.World), w.Meets S → (∃ T, ∀ (t : Nat), T ≤ t → w.flow.Enclosed t) → w.CountsHold Q) ↔
        ∀ (w : Becoming.World), w.Meets S → w.Finite → w.CountsHold Q) ↔
    Becoming.World.BoundsChange S ∧ Becoming.World.BindsCounting S
Becoming.World.standing_iff_counting_counted : ∀ (S : Becoming.World.Premise → Bool)
  {Q : (Nat → Nat) → (Nat → Nat) → (Nat → Nat) → Prop},
  Becoming.Pointwise Q →
    ((∀ (w : Becoming.World), w.Meets S → w.StandsObey Q) ↔ ∀ (w : Becoming.World), w.Meets S → w.CountsHold Q)
