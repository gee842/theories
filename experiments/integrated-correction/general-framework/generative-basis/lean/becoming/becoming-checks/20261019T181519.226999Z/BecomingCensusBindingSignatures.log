@Becoming.World.countsOf_eq : ∀ {w : Becoming.World} [inst : (t : Nat) → (x : w.Relatum) → Decidable (w.web.active t x)]
  {alive : Nat → List w.Relatum} {n c a : Nat → Nat},
  (∀ (t : Nat),
      (alive t).length = n t ∧
        Becoming.ceasings (alive t) (fun x s => w.web.active s x) t = c t ∧
          Becoming.comings (alive (t + 1)) (fun x s => w.web.active s x) t = a t) →
    w.CountsOf alive n c a
@Becoming.World.CountsOf.active_pos : ∀ {w : Becoming.World} {alive : Nat → List w.Relatum} {n c a : Nat → Nat},
  w.CountsOf alive n c a → w.web.Census alive → ∀ {t : Nat} {f : w.Relatum}, w.web.active t f → 0 < n t
@Becoming.World.CountsOf.arising_pos : ∀ {w : Becoming.World} {alive : Nat → List w.Relatum} {n c a : Nat → Nat},
  w.CountsOf alive n c a → w.web.Census alive → ∀ {t : Nat} {x : w.Relatum}, w.web.Arises t x → 0 < a t
@Becoming.World.binds_arising_counted : ∀ {w : Becoming.World},
  Becoming.World.Premise.embodied.Binds w → w.CountsHold fun x x_1 a => ∃ t, 0 < a t
Becoming.World.binds_adds_counted : ¬∀ (w : Becoming.World), w.Premised → w.CountsHold fun x x_1 a => ∃ t, 0 < a t
@Becoming.World.CountsOf.company_binding : ∀ {w : Becoming.World} {S : Becoming.World.Premise → Bool},
  w.Meets S →
    Becoming.World.BindsCounting S →
      ∀ {alive : Nat → List w.Relatum} {n c a : Nat → Nat},
        w.CountsOf alive n c a → w.web.Census alive → ∀ (t : Nat), 0 < a t → 0 < n t
@Becoming.World.CountsOf.acts_of_binding : ∀ {w : Becoming.World} {S : Becoming.World.Premise → Bool},
  w.Meets S →
    (∀ (p : Becoming.World.Premise), S p = true → p.Binds w) →
      ∀ {alive : Nat → List w.Relatum} {n c a : Nat → Nat},
        w.CountsOf alive n c a →
          w.web.Census alive →
            S Becoming.World.Premise.dependent = true ∨
                S Becoming.World.Premise.acting = true ∨ S Becoming.World.Premise.taking = true →
              ∃ t, 0 < n t
@Becoming.World.CountsOf.joint_of_binding : ∀ {w : Becoming.World},
  w.Embodied →
    w.Acting →
      Becoming.World.Premise.transmitting.Binds w →
        ∀ {alive : Nat → List w.Relatum} {n c a : Nat → Nat},
          w.CountsOf alive n c a → w.web.Census alive → ∃ t, 0 < n t ∧ 0 < a t
@Becoming.World.binding_counting_counted : ∀ {Q : (Nat → Nat) → (Nat → Nat) → (Nat → Nat) → Prop},
  (∀ (n c a : Nat → Nat), Becoming.Tally n c a → (∀ (t : Nat), 0 < a t → 0 < n t) → (∃ t, 0 < a t) → Q n c a) ↔
    ∀ (w : Becoming.World), w.Premised → w.Binds → w.CountsHold Q
Becoming.World.binding_counting_under_counted : ∀ (S : Becoming.World.Premise → Bool)
  {Q : (Nat → Nat) → (Nat → Nat) → (Nat → Nat) → Prop},
  (∀ (n c a : Nat → Nat),
      Becoming.Tally n c a →
        (Becoming.World.BindsCounting S → ∀ (t : Nat), 0 < a t → 0 < n t) →
          (S Becoming.World.Premise.dependent = true ∨
                S Becoming.World.Premise.acting = true ∨ S Becoming.World.Premise.taking = true →
              ∃ t, 0 < n t) →
            (S Becoming.World.Premise.embodied = true → ∃ t, 0 < a t) →
              (S Becoming.World.Premise.embodied = true →
                  S Becoming.World.Premise.acting = true →
                    S Becoming.World.Premise.transmitting = true → ∃ t, 0 < n t ∧ 0 < a t) →
                Q n c a) ↔
    ∀ (w : Becoming.World), w.Meets S → (∀ (p : Becoming.World.Premise), S p = true → p.Binds w) → w.CountsHold Q
Becoming.World.binding_activity_iff_counted : ∀ (S : Becoming.World.Premise → Bool),
  (∀ (w : Becoming.World),
      w.Meets S → (∀ (p : Becoming.World.Premise), S p = true → p.Binds w) → w.CountsHold fun n x x_1 => ∃ t, 0 < n t) ↔
    S Becoming.World.Premise.dependent = true ∨
      S Becoming.World.Premise.acting = true ∨
        S Becoming.World.Premise.taking = true ∨ S Becoming.World.Premise.embodied = true
Becoming.World.binding_arising_iff_counted : ∀ (S : Becoming.World.Premise → Bool),
  (∀ (w : Becoming.World),
      w.Meets S → (∀ (p : Becoming.World.Premise), S p = true → p.Binds w) → w.CountsHold fun x x_1 a => ∃ t, 0 < a t) ↔
    S Becoming.World.Premise.embodied = true
Becoming.World.binding_joint_iff_counted : ∀ (S : Becoming.World.Premise → Bool),
  (∀ (w : Becoming.World),
      w.Meets S →
        (∀ (p : Becoming.World.Premise), S p = true → p.Binds w) → w.CountsHold fun n x a => ∃ t, 0 < n t ∧ 0 < a t) ↔
    S Becoming.World.Premise.embodied = true ∧
      (Becoming.World.BindsCounting S ∨
        S Becoming.World.Premise.acting = true ∧ S Becoming.World.Premise.transmitting = true)
@Becoming.World.finite_binding_counting_counted : ∀ {Q : (Nat → Nat) → (Nat → Nat) → (Nat → Nat) → Prop},
  (∀ (n c a : Nat → Nat),
      Becoming.Tally n c a →
        (∀ (t : Nat), 0 < a t → 0 < n t) → (∃ B, Becoming.ChangeBound 0 B n c a) → (∃ t, 0 < a t) → Q n c a) ↔
    ∀ (w : Becoming.World),
      w.Premised →
        w.Finite → (∀ (p : Becoming.World.Premise), p ≠ Becoming.World.Premise.counted → p.Binds w) → w.CountsHold Q
@Becoming.World.enclosed_binding_counting_counted : ∀ {Q : (Nat → Nat) → (Nat → Nat) → (Nat → Nat) → Prop},
  (∀ (n c a : Nat → Nat),
      Becoming.Tally n c a →
        (∀ (t : Nat), 0 < a t → 0 < n t) → (∃ B, Becoming.ChangeBound 0 B n c a) → (∃ t, 0 < a t) → Q n c a) ↔
    ∀ (w : Becoming.World), w.Premised → (∃ T, ∀ (t : Nat), T ≤ t → w.flow.Enclosed t) → w.Binds → w.CountsHold Q
@Becoming.World.finite_binding_census_counted : ∀ {S : Becoming.World.Premise → Bool},
  S Becoming.World.Premise.counted = true →
    ∀ {Q : (Nat → Nat) → (Nat → Nat) → (Nat → Nat) → Prop} (w : Becoming.World),
      w.Meets S → w.Finite → (∀ (p : Becoming.World.Premise), S p = true → p.Binds w) → w.CountsHold Q
Becoming.World.finite_binding_counting_under_counted : ∀ (S : Becoming.World.Premise → Bool),
  S Becoming.World.Premise.counted = false →
    ∀ {Q : (Nat → Nat) → (Nat → Nat) → (Nat → Nat) → Prop},
      (∀ (n c a : Nat → Nat),
          Becoming.Tally n c a →
            (∃ M, ∀ (t : Nat), n t ≤ M) →
              (Becoming.World.BindsCounting S ∨ Becoming.World.BoundsChange S → ∀ (t : Nat), 0 < a t → 0 < n t) →
                (Becoming.World.BoundsChange S → ∃ B, Becoming.ChangeBound 0 B n c a) →
                  (S Becoming.World.Premise.dependent = true ∨
                        S Becoming.World.Premise.acting = true ∨ S Becoming.World.Premise.taking = true →
                      ∃ t, 0 < n t) →
                    (S Becoming.World.Premise.embodied = true → ∃ t, 0 < a t) →
                      (S Becoming.World.Premise.embodied = true →
                          S Becoming.World.Premise.acting = true ∨
                              S Becoming.World.Premise.taking = true ∧ S Becoming.World.Premise.dissipative = true →
                            S Becoming.World.Premise.transmitting = true → ∃ t, 0 < n t ∧ 0 < a t) →
                        Q n c a) ↔
        ∀ (w : Becoming.World),
          w.Meets S → w.Finite → (∀ (p : Becoming.World.Premise), S p = true → p.Binds w) → w.CountsHold Q
Becoming.World.finite_binding_activity_iff_counted : ∀ (S : Becoming.World.Premise → Bool),
  S Becoming.World.Premise.counted = false →
    ((∀ (w : Becoming.World),
        w.Meets S →
          w.Finite →
            (∀ (p : Becoming.World.Premise), S p = true → p.Binds w) → w.CountsHold fun n x x_1 => ∃ t, 0 < n t) ↔
      S Becoming.World.Premise.dependent = true ∨
        S Becoming.World.Premise.acting = true ∨
          S Becoming.World.Premise.taking = true ∨ S Becoming.World.Premise.embodied = true)
Becoming.World.finite_binding_arising_iff_counted : ∀ (S : Becoming.World.Premise → Bool),
  S Becoming.World.Premise.counted = false →
    ((∀ (w : Becoming.World),
        w.Meets S →
          w.Finite →
            (∀ (p : Becoming.World.Premise), S p = true → p.Binds w) → w.CountsHold fun x x_1 a => ∃ t, 0 < a t) ↔
      S Becoming.World.Premise.embodied = true)
Becoming.World.finite_binding_joint_iff_counted : ∀ (S : Becoming.World.Premise → Bool),
  S Becoming.World.Premise.counted = false →
    ((∀ (w : Becoming.World),
        w.Meets S →
          w.Finite →
            (∀ (p : Becoming.World.Premise), S p = true → p.Binds w) →
              w.CountsHold fun n x a => ∃ t, 0 < n t ∧ 0 < a t) ↔
      S Becoming.World.Premise.embodied = true ∧
        (Becoming.World.BindsCounting S ∨
          Becoming.World.BoundsChange S ∨
            (S Becoming.World.Premise.acting = true ∨
                S Becoming.World.Premise.taking = true ∧ S Becoming.World.Premise.dissipative = true) ∧
              S Becoming.World.Premise.transmitting = true))
Becoming.World.enclosed_binding_counting_under_counted : ∀ (S : Becoming.World.Premise → Bool)
  {Q : (Nat → Nat) → (Nat → Nat) → (Nat → Nat) → Prop},
  (∀ (n c a : Nat → Nat),
      Becoming.Tally n c a →
        (Becoming.World.BindsCounting S → ∀ (t : Nat), 0 < a t → 0 < n t) →
          (Becoming.World.BoundsChange S →
              ∃ T B, Becoming.ChangeBound T B n c a ∧ ∀ (t : Nat), T ≤ t → 0 < a t → 0 < n t) →
            (S Becoming.World.Premise.dependent = true ∨
                  S Becoming.World.Premise.acting = true ∨ S Becoming.World.Premise.taking = true →
                ∃ t, 0 < n t) →
              (S Becoming.World.Premise.embodied = true → ∃ t, 0 < a t) →
                (S Becoming.World.Premise.embodied = true →
                    S Becoming.World.Premise.acting = true →
                      S Becoming.World.Premise.transmitting = true → ∃ t, 0 < n t ∧ 0 < a t) →
                  Q n c a) ↔
    ∀ (w : Becoming.World),
      w.Meets S →
        (∃ T, ∀ (t : Nat), T ≤ t → w.flow.Enclosed t) →
          (∀ (p : Becoming.World.Premise), S p = true → p.Binds w) → w.CountsHold Q
Becoming.World.enclosed_binding_activity_iff_counted : ∀ (S : Becoming.World.Premise → Bool),
  (∀ (w : Becoming.World),
      w.Meets S →
        (∃ T, ∀ (t : Nat), T ≤ t → w.flow.Enclosed t) →
          (∀ (p : Becoming.World.Premise), S p = true → p.Binds w) → w.CountsHold fun n x x_1 => ∃ t, 0 < n t) ↔
    S Becoming.World.Premise.dependent = true ∨
      S Becoming.World.Premise.acting = true ∨
        S Becoming.World.Premise.taking = true ∨ S Becoming.World.Premise.embodied = true
Becoming.World.enclosed_binding_arising_iff_counted : ∀ (S : Becoming.World.Premise → Bool),
  (∀ (w : Becoming.World),
      w.Meets S →
        (∃ T, ∀ (t : Nat), T ≤ t → w.flow.Enclosed t) →
