        n t = 0 →
          ∀ (k f : Nat), (Becoming.Budget.flow n c a B).take t f k = 0 ∧ (Becoming.Budget.flow n c a B).give t f k = 0
@Becoming.Budget.quiet_same : ∀ {n c a : Nat → Nat} {B : Nat},
  Becoming.Tally n c a →
    ∀ {t : Nat},
      c t + a t = 0 → ∀ (k : Nat), Becoming.Budget.level n c a B (t + 1) k = Becoming.Budget.level n c a B t k
@Becoming.Budget.within_span : ∀ {n c a : Nat → Nat},
  Becoming.Tally n c a →
    ∀ {t k : Nat}, Becoming.Queue.holds n c k t ∨ Becoming.Queue.holds n c k (t + 1) → k ∈ Becoming.Budget.span n c a t
@Becoming.Budget.moving_within : ∀ {n c a : Nat → Nat} {B : Nat},
  Becoming.Tally n c a →
    ∀ {t k f : Nat},
      0 < (Becoming.Budget.flow n c a B).take t f k ∨ 0 < (Becoming.Budget.flow n c a B).give t f k →
        k ∈ Becoming.Budget.span n c a t
@Becoming.Budget.closed : ∀ {n c a : Nat → Nat} {B : Nat},
  Becoming.Tally n c a → ∀ (t : Nat), (Becoming.Budget.flow n c a B).ClosedAt (Becoming.Budget.span n c a t) t
@Becoming.Budget.span_distinct : ∀ {n c a : Nat → Nat} (t : Nat), Becoming.Distinct (Becoming.Budget.span n c a t)
@Becoming.Budget.busy : ∀ {n c a : Nat → Nat} {B : Nat},
  Becoming.Tally n c a →
    (∀ (t : Nat), 0 < a t → 0 < n t) →
      ∀ {t k f : Nat},
        0 < (Becoming.Budget.flow n c a B).take t f k ∨ 0 < (Becoming.Budget.flow n c a B).give t f k → 0 < n t
Becoming.World.budgetQueue_census : ∀ (n c a : Nat → Nat) (B : Nat),
  (Becoming.World.budgetQueue n c a B).web.Census (Becoming.Queue.line n c)
Becoming.World.budgetQueue_embodied : ∀ (n c a : Nat → Nat) (B : Nat), (Becoming.World.budgetQueue n c a B).Embodied
Becoming.World.budgetQueue_balanced : ∀ (n c a : Nat → Nat) (B : Nat), (Becoming.World.budgetQueue n c a B).Balanced
@Becoming.World.budgetQueue_acting : ∀ {n c a : Nat → Nat} {B : Nat},
  Becoming.Tally n c a → (∀ (t : Nat), 0 < a t → 0 < n t) → (Becoming.World.budgetQueue n c a B).Acting
@Becoming.World.budgetQueue_taking : ∀ {n c a : Nat → Nat} {B : Nat},
  Becoming.Tally n c a → (∀ (t : Nat), 0 < a t → 0 < n t) → (Becoming.World.budgetQueue n c a B).Taking
@Becoming.World.budgetQueue_stock : ∀ {n c a : Nat → Nat} {B t : Nat},
  n t ≤ Becoming.Budget.store c a B t →
    (Becoming.World.budgetQueue n c a B).web.stock (Becoming.Queue.line n c t) t ≤ Becoming.Budget.store c a B t ∧
      (0 < n t →
        (Becoming.World.budgetQueue n c a B).web.stock (Becoming.Queue.line n c t) t = Becoming.Budget.store c a B t)
@Becoming.World.budgetQueue_dissipative : ∀ {n c a : Nat → Nat} {B : Nat},
  Becoming.Tally n c a →
    (∀ (t : Nat), 0 < a t → 0 < n t) → Becoming.Budgeted 0 B n c a → (Becoming.World.budgetQueue n c a B).Dissipative
@Becoming.World.budgetQueue_premised : ∀ {n c a : Nat → Nat} {B : Nat},
  Becoming.Tally n c a →
    (∀ (t : Nat), 0 < a t → 0 < n t) → Becoming.Budgeted 0 B n c a → (Becoming.World.budgetQueue n c a B).Premised
@Becoming.World.budgetQueue_enclosed : ∀ {n c a : Nat → Nat} {B : Nat},
  Becoming.Tally n c a → ∀ (t : Nat), (Becoming.World.budgetQueue n c a B).flow.Enclosed t
@Becoming.World.enclosed_counting : ∀ {Q : (Nat → Nat) → (Nat → Nat) → (Nat → Nat) → Prop},
  Becoming.Pointwise Q →
    ((∀ (n c a : Nat → Nat),
        Becoming.Tally n c a → (∀ (t : Nat), 0 < a t → 0 < n t) → (∃ B, Becoming.Budgeted 0 B n c a) → Q n c a) ↔
      ∀ (w : Becoming.World) [inst : (t : Nat) → (x : w.Relatum) → Decidable (w.web.active t x)],
        w.Premised → (∃ T, ∀ (t : Nat), T ≤ t → w.flow.Enclosed t) → w.CountsObey Q)
@Becoming.mem_placesBelow : ∀ {K : Nat} {i : Fin K} {l : List Nat}, i ∈ Becoming.placesBelow K l ↔ ↑i ∈ l
@Becoming.placesBelow_distinct : ∀ {K : Nat} {l : List Nat},
  Becoming.Distinct l → Becoming.Distinct (Becoming.placesBelow K l)
@Becoming.total_placesBelow : ∀ {K : Nat} {q : Fin K → Nat} {g : Nat → Nat},
  (∀ (i : Fin K), q i = g ↑i) →
    ∀ {l : List Nat}, (∀ (k : Nat), k ∈ l → k < K) → Becoming.total (Becoming.placesBelow K l) q = Becoming.total l g
@Becoming.FiniteQueue.placed : ∀ {n c a : Nat → Nat} {B : Nat},
  Becoming.Tally n c a →
    Becoming.Budgeted 0 B n c a → ∀ {k t : Nat}, Becoming.Queue.holds n c k t → k < Becoming.FiniteQueue.size B
@Becoming.FiniteQueue.front_val : ∀ {n c a : Nat → Nat} {B : Nat},
  Becoming.Tally n c a →
    Becoming.Budgeted 0 B n c a → ∀ (t : Nat), ↑(Becoming.FiniteQueue.front c B t) = Becoming.Queue.gone c t
Becoming.World.finiteQueue_finite : ∀ (n c a : Nat → Nat) (B : Nat), (Becoming.World.finiteQueue n c a B).Finite
Becoming.World.finiteQueue_census : ∀ (n c a : Nat → Nat) (B : Nat),
  (Becoming.World.finiteQueue n c a B).web.Census (Becoming.FiniteQueue.alive n c B)
@Becoming.World.finiteQueue_counts : ∀ {n c a : Nat → Nat} {B : Nat},
  Becoming.Tally n c a →
    Becoming.Budgeted 0 B n c a →
      ∀ (t : Nat),
        (Becoming.FiniteQueue.alive n c B t).length = n t ∧
          Becoming.ceasings (Becoming.FiniteQueue.alive n c B t)
                (fun x s => (Becoming.World.finiteQueue n c a B).web.active s x) t =
              c t ∧
            Becoming.comings (Becoming.FiniteQueue.alive n c B (t + 1))
                (fun x s => (Becoming.World.finiteQueue n c a B).web.active s x) t =
              a t
@Becoming.World.finiteQueue_premised : ∀ {n c a : Nat → Nat} {B : Nat},
  Becoming.Tally n c a →
    (∀ (t : Nat), 0 < a t → 0 < n t) → Becoming.Budgeted 0 B n c a → (Becoming.World.finiteQueue n c a B).Premised
@Becoming.World.finite_counting : ∀ {Q : (Nat → Nat) → (Nat → Nat) → (Nat → Nat) → Prop},
  Becoming.Pointwise Q →
    ((∀ (n c a : Nat → Nat),
        Becoming.Tally n c a → (∀ (t : Nat), 0 < a t → 0 < n t) → (∃ B, Becoming.Budgeted 0 B n c a) → Q n c a) ↔
      ∀ (w : Becoming.World) [inst : (t : Nat) → (x : w.Relatum) → Decidable (w.web.active t x)],
        w.Premised → w.Finite → w.CountsObey Q)
@Becoming.World.enclosed_iff_finite_counting : ∀ {Q : (Nat → Nat) → (Nat → Nat) → (Nat → Nat) → Prop},
  Becoming.Pointwise Q →
    ((∀ (w : Becoming.World) [inst : (t : Nat) → (x : w.Relatum) → Decidable (w.web.active t x)],
        w.Premised → (∃ T, ∀ (t : Nat), T ≤ t → w.flow.Enclosed t) → w.CountsObey Q) ↔
      ∀ (w : Becoming.World) [inst : (t : Nat) → (x : w.Relatum) → Decidable (w.web.active t x)],
        w.Premised → w.Finite → w.CountsObey Q)
Becoming.World.finite_dissipation_binds : ∃ cs t f,
  Becoming.Distinct cs ∧
    Becoming.World.replaced.flow.ClosedAt cs t ∧
      f ∈ Becoming.World.replaced.flow.present t ∧ 0 < Becoming.total cs (Becoming.World.replaced.flow.take t f)
Becoming.World.replaced_attains : Becoming.World.replaced.web.stock
      (Becoming.FiniteQueue.alive (fun x => 1) (Becoming.Swap.change fun x => true) 2 0) 0 =
    2 ∧
  ∀ (t : Nat),
    (Becoming.FiniteQueue.alive (fun x => 1) (Becoming.Swap.change fun x => true) 2 (t + 1)).length +
        Becoming.countSince 0 (fun u => Becoming.Swap.change (fun x => true) u + Becoming.Swap.change (fun x => true) u)
          (t + 1) =
      2
Becoming.World.lpo_of_finite_ends : (∀ (w : Becoming.World)
    [(t : Nat) → (x : w.Relatum) → Decidable (w.web.active t x)],
    w.Premised → w.Finite → ∃ E, ∀ (t : Nat) (x : w.Relatum), E ≤ t → ¬w.web.Arises t x) →
  Becoming.LPO
