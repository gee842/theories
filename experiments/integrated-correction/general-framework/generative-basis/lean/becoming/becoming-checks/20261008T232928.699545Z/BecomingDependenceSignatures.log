@Becoming.Web.static_supported : ∀ {F C : Type} (U : RelationalRenewal.Unfolding F C) (t : Nat) (f : F),
  (Becoming.Web.static U).Supported t f ↔ RelationalRenewal.Supported U t f
@Becoming.Web.static_dependent : ∀ {F C : Type} (U : RelationalRenewal.Unfolding F C),
  (Becoming.Web.static U).Dependent ↔ RelationalRenewal.Dependent U
@Becoming.Web.static_renewed : ∀ {F C : Type} (U : RelationalRenewal.Unfolding F C) (c : C),
  (Becoming.Web.static U).Renewed c ↔ RelationalRenewal.Renewed U c
@Becoming.Web.static_consumed : ∀ {F C : Type} (U : RelationalRenewal.Unfolding F C) (c : C),
  (Becoming.Web.static U).Consumed c ↔ RelationalRenewal.Consumed U c
@Becoming.Web.static_renewingIn : ∀ {F C : Type} (U : RelationalRenewal.Unfolding F C) (f : F),
  (Becoming.Web.static U).RenewingIn f ↔ RelationalRenewal.RenewingIn U f
@Becoming.Web.static_consumingIn : ∀ {F C : Type} (U : RelationalRenewal.Unfolding F C) (f : F),
  (Becoming.Web.static U).ConsumingIn f ↔ RelationalRenewal.ConsumingIn U f
@Becoming.Web.conditions_along : ∀ {S : Type u_1} {A : Type u_2} {F C : Type} (K : Becoming.Conditions S F C)
  {P : Generative.Process S A} (r : Becoming.Run P), K.dependence.along r = Becoming.Web.static (K.along r)
@Becoming.Web.renewed_not_consumed : ∀ {F C : Type} {W : Becoming.Web F C} {c : C}, W.Renewed c → ¬W.Consumed c
@Becoming.Web.renewing_not_consuming : ∀ {F C : Type} {W : Becoming.Web F C} {f : F}, W.RenewingIn f → ¬W.ConsumingIn f
@Becoming.Web.renewing_keeps_support : ∀ {F C : Type} {W : Becoming.Web F C} {f : F},
  W.RenewingIn f → ∀ (t : Nat), W.Supported t f
@Becoming.Web.lost_consumed : ∀ {F C : Type} {W : Becoming.Web F C} {c : C}, W.Lost c → W.Consumed c
@Becoming.Web.kept_or_broken : ∀ {F C : Type} {W : Becoming.Web F C} {t : Nat} {g : F} {c : C},
  W.requires t g c → W.need t g c ≤ W.level t c → W.Kept t g c ∨ W.Broken t g c
@Becoming.Web.continuing_restores : ∀ {F C : Type} {W : Becoming.Web F C},
  W.Dependent →
    ∀ {T t : Nat} {g : F} {c : C},
      W.active t g → W.requires t g c → W.need T g c ≤ W.need t g c → W.need T g c ≤ W.level t c
@Becoming.Web.consumed_continues_transformed : ∀ {F C : Type} {W : Becoming.Web F C},
  W.Dependent →
    ∀ {T : Nat} {g : F} {c : C},
      (∀ (t : Nat), T < t → W.level t c < W.need T g c) →
        ∀ {t : Nat}, T < t → W.active t g → ¬(W.requires t g c ∧ W.need T g c ≤ W.need t g c)
@Becoming.Web.consumed_ends_when_fixed : ∀ {F C : Type} {W : Becoming.Web F C},
  W.Dependent →
    ∀ {T : Nat} {g : F} {c : C},
      (∀ (t : Nat), T < t → W.requires t g c ∧ W.need T g c ≤ W.need t g c) →
        (∀ (t : Nat), T < t → W.level t c < W.need T g c) → ∀ (t : Nat), T < t → ¬W.active t g
@Becoming.Web.renewing_at_active : ∀ {F C : Type} {W : Becoming.Web F C} {f : F},
  W.RenewingIn f → ∀ {t : Nat}, W.active t f → Becoming.Web.RenewingAt t f
@Becoming.Web.not_renewing_at_of_broken : ∀ {F C : Type} {W : Becoming.Web F C} {t : Nat} {f g : F} {c : C},
  W.Participates t f c → W.Broken t g c → ¬Becoming.Web.RenewingAt t f
Becoming.Crossing.ending_dependent : (Becoming.Crossing.dependence.along Becoming.Crossing.ending).Dependent
Becoming.Crossing.transforming_dependent : (Becoming.Crossing.dependence.along Becoming.Crossing.transforming).Dependent
Becoming.Crossing.restoring_dependent : (Becoming.Crossing.dependence.along Becoming.Crossing.restoring).Dependent
Becoming.Crossing.loss_does_not_decide : Becoming.Crossing.ending.state 0 = Becoming.Crossing.transforming.state 0 ∧
  Becoming.Crossing.transforming.state 0 = Becoming.Crossing.restoring.state 0 ∧
    (Becoming.Crossing.dependence.along Becoming.Crossing.ending).Broken 0 () Becoming.Crossing.Source.first ∧
      (Becoming.Crossing.dependence.along Becoming.Crossing.transforming).Broken 0 () Becoming.Crossing.Source.first ∧
        (Becoming.Crossing.dependence.along Becoming.Crossing.restoring).Broken 0 () Becoming.Crossing.Source.first ∧
          (Becoming.Crossing.dependence.along Becoming.Crossing.ending).Lost Becoming.Crossing.Source.first ∧
            (∀ (t : Nat), 0 < t → ¬(Becoming.Crossing.dependence.along Becoming.Crossing.ending).active t ()) ∧
              (Becoming.Crossing.dependence.along Becoming.Crossing.transforming).Lost Becoming.Crossing.Source.first ∧
                (Becoming.Crossing.dependence.along Becoming.Crossing.transforming).Dissolves 0 ()
                    Becoming.Crossing.Source.first ∧
                  (Becoming.Crossing.dependence.along Becoming.Crossing.transforming).Forms 0 ()
                      Becoming.Crossing.Source.second ∧
                    (∀ (t : Nat), (Becoming.Crossing.dependence.along Becoming.Crossing.transforming).active t ()) ∧
                      ¬(Becoming.Crossing.dependence.along Becoming.Crossing.restoring).Consumed
                            Becoming.Crossing.Source.first ∧
                        ∀ (t : Nat),
                          2 ≤ t →
                            (Becoming.Crossing.dependence.along Becoming.Crossing.restoring).active t () ∧
                              (Becoming.Crossing.dependence.along Becoming.Crossing.restoring).requires t ()
                                  Becoming.Crossing.Source.first ∧
                                (Becoming.Crossing.dependence.along Becoming.Crossing.restoring).Kept t ()
                                  Becoming.Crossing.Source.first
Becoming.Commons.stepwise_credits_before_escalation : (Becoming.Commons.conditions.dependence.along
        Becoming.Commons.escalating).ConsumingIn
    Becoming.Commons.Formation.focal ∧
  Becoming.Web.RenewingAt 0 Becoming.Commons.Formation.focal ∧
    ¬Becoming.Web.RenewingAt 1 Becoming.Commons.Formation.focal
Becoming.Commons.dip_breaks_without_consuming : ¬(Becoming.Commons.conditions.dependence.along
          Becoming.Commons.dipping).ConsumingIn
      Becoming.Commons.Formation.focal ∧
  ¬Becoming.Web.RenewingAt 0 Becoming.Commons.Formation.focal
Becoming.Dip.renewing_at_each_step_not_in_run : Becoming.Dip.web.Dependent ∧
  (∀ (t : Nat),
      Becoming.Dip.web.active t Becoming.Dip.Formation.keeper →
        Becoming.Web.RenewingAt t Becoming.Dip.Formation.keeper) ∧
    ¬Becoming.Dip.web.RenewingIn Becoming.Dip.Formation.keeper
