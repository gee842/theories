@Becoming.mem_append_left : ∀ {α : Type} {a : α} {l : List α} (m : List α), a ∈ l → a ∈ l ++ m
@Becoming.mem_append_right : ∀ {α : Type} {a : α} (l : List α) {m : List α}, a ∈ m → a ∈ l ++ m
@Becoming.Web.StandingCensus.coming_of_ceasing : ∀ {F C : Type} {W : Becoming.Web F C} {stand : Nat → List C},
  W.StandingCensus stand →
    (∀ (N : Nat), ∃ t c, N ≤ t ∧ W.CeasesToStand t c) → ∀ (N : Nat), ∃ t c, N ≤ t ∧ W.ComesToStand t c
@Becoming.Web.StandingCensus.coming_iff_ceasing : ∀ {F C : Type} {W : Becoming.Web F C} {stand : Nat → List C},
  W.StandingCensus stand →
    ∀ {T B : Nat},
      (∀ (t : Nat), T ≤ t → (stand t).length ≤ B) →
        ((∀ (N : Nat), ∃ t c, N ≤ t ∧ W.ComesToStand t c) ↔ ∀ (N : Nat), ∃ t c, N ≤ t ∧ W.CeasesToStand t c)
@Becoming.Web.StandingCensus.over_stretch : ∀ {F C : Type} {W : Becoming.Web F C} {stand : Nat → List C},
  W.StandingCensus stand →
    ∀ (S n : Nat),
      ((stand (S + n)).length +
          Becoming.total (Becoming.steps S n) fun t =>
            Becoming.total (stand t) fun c => Becoming.mark (W.CeasesToStand t c)) =
        (stand S).length +
          Becoming.total (Becoming.steps S n) fun t =>
            Becoming.total (stand (t + 1)) fun c => Becoming.mark (W.ComesToStand t c)
@Becoming.Web.StandingCensus.stock_eq : ∀ {F C : Type} {W : Becoming.Web F C} {stand : Nat → List C},
  W.StandingCensus stand →
    ∀ {es : List C},
      Becoming.Distinct es → ∀ {t : Nat}, (∀ (c : C), c ∈ stand t → c ∈ es) → W.stock (stand t) t = W.stock es t
@Becoming.Flow.Enclosed.aroundStanding : ∀ {F C : Type} {L : Becoming.Flow F C} [DecidableEq C] {t : Nat},
  L.Enclosed t → ∀ (stand : Nat → List C), L.AroundStanding stand t
@Becoming.Flow.Enclosed.aroundStanding_not_not : ∀ {F C : Type} {L : Becoming.Flow F C} {t : Nat},
  L.Enclosed t → ∀ (stand : Nat → List C), ¬¬L.AroundStanding stand t
@Becoming.Flow.fall_lowers_on : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    ∀ {ds : List C} {t : Nat}, L.DissipatesOn ds t → ∀ {c : C}, c ∈ ds → W.Falls t c → W.stock ds (t + 1) < W.stock ds t
@Becoming.Flow.standing_runs_down : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {stand : Nat → List C},
  L.Balances W →
    L.Dissipative →
      W.StandingCensus stand →
        ∀ {t : Nat},
          L.AroundStanding stand t → ∃ es, W.stock (stand (t + 1)) (t + 1) + L.takers es t ≤ W.stock (stand t) t
@Becoming.Flow.standing_never_rises : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {stand : Nat → List C},
  L.Balances W →
    L.Dissipative →
      W.StandingCensus stand →
        ∀ {t : Nat}, L.AroundStanding stand t → W.stock (stand (t + 1)) (t + 1) ≤ W.stock (stand t) t
@Becoming.Flow.change_lowers : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {stand : Nat → List C},
  L.Balances W →
    L.Dissipative →
      W.StandingCensus stand →
        ∀ {t : Nat},
          L.AroundStanding stand t →
            ∀ {c : C}, W.Rises t c ∨ W.Falls t c → W.stock (stand (t + 1)) (t + 1) < W.stock (stand t) t
@Becoming.Flow.stills : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {stand : Nat → List C},
  L.Balances W →
    L.Dissipative →
      W.StandingCensus stand →
        ∀ {T : Nat},
          (∀ (t : Nat), T ≤ t → ¬¬L.AroundStanding stand t) → ¬∀ (N : Nat), ∃ t c, N ≤ t ∧ (W.Rises t c ∨ W.Falls t c)
@Becoming.World.arising_of_ceasing : ∀ {w : Becoming.World}
  [(t : Nat) → (x : w.Relatum) → Decidable (w.web.active t x)], w.Counted → w.CeasingRecurs → w.ArisingRecurs
@Becoming.World.CountedWithin.arising_iff_ceasing : ∀ {w : Becoming.World}
  [(t : Nat) → (x : w.Relatum) → Decidable (w.web.active t x)] {B : Nat},
  w.CountedWithin B → (w.ArisingRecurs ↔ w.CeasingRecurs)
@Becoming.World.CountedBy.arising_iff_ceasing : ∀ {w : Becoming.World}
  [(t : Nat) → (x : w.Relatum) → Decidable (w.web.active t x)] {B : Nat → Nat} {K : Nat},
  w.CountedBy B → (∀ (N : Nat), ∃ t, N ≤ t ∧ B t ≤ K) → (w.ArisingRecurs ↔ w.CeasingRecurs)
@Becoming.World.Finite.countedWithin : ∀ {w : Becoming.World}
  [(t : Nat) → (x : w.Relatum) → Decidable (w.web.active t x)], w.Finite → ∃ B, w.CountedWithin B
@Becoming.World.Finite.arising_iff_ceasing : ∀ {w : Becoming.World}
  [(t : Nat) → (x : w.Relatum) → Decidable (w.web.active t x)], w.Finite → (w.ArisingRecurs ↔ w.CeasingRecurs)
@Becoming.Dawn.mem_alive : ∀ {t : Nat} {x : Nat ⊕ Unit}, x ∈ Becoming.Dawn.alive t ↔ Becoming.World.dawn.web.active t x
Becoming.Dawn.alive_distinct : ∀ (t : Nat), Becoming.Distinct (Becoming.Dawn.alive t)
Becoming.Dawn.census : Becoming.World.dawn.web.Census Becoming.Dawn.alive
Becoming.World.census_one_way : (Becoming.World.dawn.Counted ∧
    Becoming.World.dawn.ArisingRecurs ∧ ¬Becoming.World.dawn.CeasingRecurs) ∧
  Becoming.World.dusk.CeasingRecurs ∧ ¬Becoming.World.dusk.ArisingRecurs ∧ ¬Becoming.World.dusk.Counted
Becoming.World.dawn_unbounded : ∀ (B : Nat), ¬Becoming.World.dawn.CountedWithin B
Becoming.Procession.census : Becoming.Procession.web.Census fun t => [t]
Becoming.World.procession_world : Becoming.World.procession.CountedWithin 1 ∧
  Becoming.World.procession.ArisingRecurs ∧ Becoming.World.procession.CeasingRecurs ∧ ¬Becoming.World.procession.Finite
Becoming.World.Slow.length : ∀ (n : Nat), (Becoming.Cycle.present n).length = n
Becoming.World.Slow.census : ∀ (B : Nat → Nat), (Becoming.World.Slow.web B).Census fun t => Becoming.Cycle.present (B t)
@Becoming.World.Slow.grows_between : ∀ {B : Nat → Nat},
  (∀ (t : Nat), B t ≤ B (t + 1)) → ∀ {s t : Nat}, s ≤ t → B s ≤ B t
@Becoming.World.World.slow_world : ∀ {B : Nat → Nat},
  (∀ (t : Nat), B t ≤ B (t + 1)) →
    (∀ (n : Nat), ∃ t, n < B t) →
      (Becoming.World.World.slow B).CountedBy B ∧
        (Becoming.World.World.slow B).ArisingRecurs ∧
          ∀ (t : Nat) (x : (Becoming.World.World.slow B).Relatum), ¬(Becoming.World.World.slow B).web.Ceases t x
@Becoming.World.arising_stops : ∀ {w : Becoming.World} {stand : Nat → List w.Relatum},
  w.web.StandingCensus stand →
    w.ArisingEmbodied →
      w.Balanced → w.Dissipative → ∀ {T : Nat}, (∀ (t : Nat), T ≤ t → w.flow.AroundStanding stand t) → ¬w.ArisingRecurs
@Becoming.World.comes_to_rest : ∀ {w : Becoming.World}
  [decided : (t : Nat) → (x : w.Relatum) → Decidable (w.web.active t x)],
  w.Counted →
    ∀ {stand : Nat → List w.Relatum},
      w.web.StandingCensus stand →
        w.ArisingEmbodied →
          w.Balanced →
            w.Dissipative →
              ∀ {T : Nat}, (∀ (t : Nat), T ≤ t → w.flow.AroundStanding stand t) → ¬w.ArisingRecurs ∧ ¬w.CeasingRecurs
@Becoming.World.Finite.standing : ∀ {w : Becoming.World},
  w.Finite → ∃ stand, w.web.StandingCensus stand ∧ ∀ (t : Nat), w.flow.AroundStanding stand t
@Becoming.World.Finite.comes_to_rest : ∀ {w : Becoming.World}
  [(t : Nat) → (x : w.Relatum) → Decidable (w.web.active t x)],
  w.Finite → w.Balanced → w.Dissipative → w.ArisingEmbodied → ¬w.ArisingRecurs ∧ ¬w.CeasingRecurs
Becoming.World.rest_needs_census : (Becoming.World.dusk.web.StandingCensus fun x => []) ∧
  Becoming.World.dusk.ArisingEmbodied ∧
    Becoming.World.dusk.Balanced ∧
      Becoming.World.dusk.Dissipative ∧
        (∀ (t : Nat), Becoming.World.dusk.flow.AroundStanding (fun x => []) t) ∧
          Becoming.World.dusk.CeasingRecurs ∧ ¬Becoming.World.dusk.Counted
@Becoming.World.standingCensus : ∀ {w : Becoming.World} {alive : Nat → List w.Relatum},
  w.web.Census alive → w.Embodied → w.web.StandingCensus alive
@Becoming.World.rises_of_arises : ∀ {w : Becoming.World},
  w.Embodied → ∀ {t : Nat} {x : w.Relatum}, w.web.Arises t x → w.web.Rises t x
@Becoming.World.falls_of_ceases : ∀ {w : Becoming.World},
  w.Embodied → ∀ {t : Nat} {x : w.Relatum}, w.web.Ceases t x → w.web.Falls t x
@Becoming.World.rests_around : ∀ {w : Becoming.World} {alive : Nat → List w.Relatum},
  w.web.Census alive →
    w.Embodied →
      w.Balanced →
        w.Dissipative →
          ∀ {T : Nat}, (∀ (t : Nat), T ≤ t → w.flow.AroundStanding alive t) → ¬w.ArisingRecurs ∧ ¬w.CeasingRecurs
@Becoming.World.rests_enclosed : ∀ {w : Becoming.World},
  w.Counted →
    w.Embodied →
      w.Balanced →
        w.Dissipative → ∀ {T : Nat}, (∀ (t : Nat), T ≤ t → w.flow.Enclosed t) → ¬w.ArisingRecurs ∧ ¬w.CeasingRecurs
@Becoming.World.arising_opens : ∀ {w : Becoming.World},
  w.Counted →
    w.Embodied → w.Balanced → w.Dissipative → w.ArisingRecurs → ∀ (T : Nat), ¬∀ (t : Nat), T ≤ t → w.flow.Enclosed t
Becoming.Exposed.outside : ∀ (cs : List Becoming.Exposed.Relatum),
  ¬Becoming.Exposed.Relatum.ground (Becoming.beyond (List.map Becoming.Exposed.index cs)) ∈ cs
Becoming.Exposed.open_at : ∀ (t : Nat), ¬Becoming.Exposed.flow.Enclosed t
Becoming.Exposed.stands_iff : ∀ (b : Bool) (t : Nat), 0 < Becoming.Handing.stands b t ↔ b = Becoming.Handing.holder t
Becoming.Exposed.census : Becoming.Exposed.web.Census fun t =>
  [Becoming.Exposed.Relatum.side (Becoming.Handing.holder t)]
Becoming.Exposed.holder_one : ∀ (t : Nat), Becoming.Handing.stands (Becoming.Handing.holder t) t = 1
Becoming.Exposed.holder_after : ∀ (t : Nat), Becoming.Handing.stands (Becoming.Handing.holder t) (t + 1) = 0
Becoming.World.exposed_world : Becoming.World.exposed.Premised ∧
  Becoming.World.exposed.ArisingRecurs ∧ ∀ (t : Nat), ¬Becoming.World.exposed.flow.Enclosed t
Becoming.World.exposed_standing : (Becoming.World.exposed.web.StandingCensus fun t =>
    [Becoming.Exposed.Relatum.side (Becoming.Handing.holder t)]) ∧
  (∀ (t : Nat), Becoming.World.exposed.web.stock [Becoming.Exposed.Relatum.side (Becoming.Handing.holder t)] t = 1) ∧
    (∀ (t : Nat), Becoming.World.exposed.web.Falls t (Becoming.Exposed.Relatum.side (Becoming.Handing.holder t))) ∧
      ¬Becoming.World.exposed.Finite
Becoming.World.openness_contingent : (Becoming.World.exposed.Premised ∧
    (∀ (t : Nat), ¬Becoming.World.exposed.flow.Enclosed t) ∧ Becoming.World.exposed.ArisingRecurs) ∧
  Becoming.World.mutualism.Premised ∧
    (∀ (t : Nat), Becoming.World.mutualism.flow.Enclosed t) ∧ ¬Becoming.World.mutualism.ArisingRecurs
Becoming.World.brood_rests : Becoming.World.brood.web.Arises 0 Becoming.World.Brood.Relatum.child ∧
  Becoming.World.brood.web.Ceases 0 Becoming.World.Brood.Relatum.parent ∧
    ¬Becoming.World.brood.ArisingRecurs ∧ ¬Becoming.World.brood.CeasingRecurs
Becoming.Kindling.fuel_stands : ∀ (n : Nat), 0 < Becoming.Kindling.web.level 0 (Becoming.Kindling.Relatum.fuel n)
Becoming.Kindling.census : Becoming.Kindling.web.Census fun t =>
  [Becoming.Kindling.Relatum.side (Becoming.Handing.holder t)]
@Becoming.Kindling.unlisted : ∀ {holds : Becoming.Kindling.Relatum → Prop} (l : List Becoming.Kindling.Relatum),
  (∀ (x : Becoming.Kindling.Relatum), holds x ↔ x ∈ l) → (∀ (n : Nat), holds (Becoming.Kindling.Relatum.fuel n)) → False
Becoming.World.rest_needs_standing : (Becoming.World.kindling.Counted ∧
    Becoming.World.kindling.ArisingEmbodied ∧
      Becoming.World.kindling.Balanced ∧
        Becoming.World.kindling.Dissipative ∧
          (∀ (t : Nat),
              Becoming.World.kindling.flow.Around
                [Becoming.Kindling.Relatum.side true, Becoming.Kindling.Relatum.side false] t) ∧
            Becoming.World.kindling.ArisingRecurs ∧
              ∀ (stand : Nat → List Becoming.World.kindling.Relatum),
                ¬Becoming.World.kindling.web.StandingCensus stand) ∧
  (∀ (t : Nat), Becoming.World.ember.flow.Enclosed t) ∧
    Becoming.World.ember.Embodied ∧
      Becoming.World.ember.Balanced ∧
        Becoming.World.ember.Dissipative ∧ Becoming.World.ember.ArisingRecurs ∧ ¬Becoming.World.ember.Counted
