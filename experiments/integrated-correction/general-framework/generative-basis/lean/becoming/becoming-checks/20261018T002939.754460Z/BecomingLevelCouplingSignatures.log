@Becoming.ExchangeLaw.RespondsByLevel.respondsTo : ∀ {F C : Type} {law : Becoming.ExchangeLaw F C} {t s : Nat} {h : F}
  {c d : C} {W : Becoming.Web F C}, law.RespondsByLevel W t h c s d → law.RespondsTo t h c s d
@Becoming.ExchangeLaw.respondsWithin_zero_iff : ∀ {F C : Type} {law : Becoming.ExchangeLaw F C} {t s : Nat} {h : F}
  {c d : C}, law.RespondsWithin t h c s d 0 ↔ ¬law.RespondsTo t h c s d
@Becoming.ExchangeLaw.RespondsTo.strength_pos : ∀ {F C : Type} {law : Becoming.ExchangeLaw F C} {t s : Nat} {h : F}
  {c d : C}, law.RespondsTo t h c s d → ∀ {k : Nat}, law.RespondsWithin t h c s d k → 0 < k
@Becoming.ExchangeLaw.RespondsTo.couples : ∀ {F C : Type} {law : Becoming.ExchangeLaw F C} {t s : Nat} {h : F} {c d : C}
  {cs : List C} {part : F → Bool} {present : Nat → List F} {k : Nat → F → C → Nat → C → Nat},
  (∀ (t : Nat) (h : F) (c : C) (s : Nat) (d : C), part h = false → s ≤ t → law.RespondsWithin t h c s d (k t h c s d)) →
    law.RespondsTo t h c s d → h ∈ present t → part h = false → s ≤ t → d ∈ cs → Becoming.Couples cs part k present d c
@Becoming.ExchangeLaw.RespondsTo.upstream : ∀ {F C : Type} {law : Becoming.ExchangeLaw F C} {t s : Nat} {h : F}
  {c d : C} {cs : List C} {part : F → Bool} {present : Nat → List F} {k : Nat → F → C → Nat → C → Nat},
  (∀ (t : Nat) (h : F) (c : C) (s : Nat) (d : C), part h = false → s ≤ t → law.RespondsWithin t h c s d (k t h c s d)) →
    law.RespondsTo t h c s d → h ∈ present t → part h = false → s ≤ t → d ∈ cs → Becoming.Upstream cs part k present d c
@Becoming.ExchangeLaw.Through.respondsWithin_unregistered : ∀ {F C : Type} {law : Becoming.ExchangeLaw F C}
  {W : Becoming.Web F C} {obs : F → C → Prop} {part : F → Bool} {t s : Nat} {h : F} {c d : C},
  law.Through W obs part → part h = false → ¬W.Registers obs h d → law.RespondsWithin t h c s d 0
@Becoming.ExchangeLaw.Through.registers_of_respondsTo : ∀ {F C : Type} {law : Becoming.ExchangeLaw F C}
  {W : Becoming.Web F C} {obs : F → C → Prop} {part : F → Bool} {t s : Nat} {h : F} {c d : C},
  law.Through W obs part → part h = false → law.RespondsTo t h c s d → ¬¬W.Registers obs h d
@Becoming.ExchangeLaw.Through.reads_of_respondsTo : ∀ {F C : Type} {law : Becoming.ExchangeLaw F C}
  {W : Becoming.Web F C} {obs : F → C → Prop} {part : F → Bool} {t s : Nat} {h : F} {c d : C}
  {reads : Nat → F → C → Bool},
  law.Through W obs part →
    (∀ (t : Nat) (h : F) (d : C), part h = false → W.Registers obs h d → reads t h d = true) →
      part h = false → law.RespondsTo t h c s d → reads t h d = true
@Becoming.ExchangeLaw.Through.couples_readCouplings : ∀ {F C : Type} {law : Becoming.ExchangeLaw F C}
  {W : Becoming.Web F C} {obs : F → C → Prop} {part : F → Bool} {t s : Nat} {h : F} {c d : C}
  {reads : Nat → F → C → Bool} {cs : List C} {present : Nat → List F},
  law.Through W obs part →
    (∀ (t : Nat) (h : F) (d : C), part h = false → W.Registers obs h d → reads t h d = true) →
      law.RespondsTo t h c s d →
        h ∈ present t →
          part h = false →
            s ≤ t →
              d ∈ cs → Becoming.Couples cs part (Becoming.readCouplings fun t h x x_1 d => reads t h d) present d c
@Becoming.ExchangeLaw.Through.upstream_restrictInto : ∀ {F C : Type} {law : Becoming.ExchangeLaw F C}
  {W : Becoming.Web F C} {obs : F → C → Prop} {part : F → Bool} {t s : Nat} {h : F} {c d : C}
  {reads : Nat → F → C → Bool} {cs : List C} {present : Nat → List F} {k : Nat → F → C → Nat → C → Nat},
  law.Through W obs part →
    (∀ (t : Nat) (h : F) (d : C), part h = false → W.Registers obs h d → reads t h d = true) →
      (∀ (t : Nat) (h : F) (c : C) (s : Nat) (d : C),
          part h = false → s ≤ t → law.RespondsWithin t h c s d (k t h c s d)) →
        law.RespondsTo t h c s d →
          h ∈ present t →
            part h = false →
              s ≤ t →
                d ∈ cs →
                  Becoming.Upstream cs part (Becoming.restrictInto (fun t h x x_1 d => reads t h d) k) present d c
@Becoming.Web.registersAlike_of_levels : ∀ {F C : Type} {W : Becoming.Web F C} {obs : F → C → Prop} {g : F}
  {l l' : Nat → C → Nat} {s' : Nat}, (∀ (e : C), l s' e = l' s' e) → W.RegistersAlike obs g l l' s'
@Becoming.ExchangeLaw.Through.not_respondsByLevel : ∀ {F C : Type} {law : Becoming.ExchangeLaw F C}
  {W : Becoming.Web F C} {obs : F → C → Prop} {part : F → Bool} {t s : Nat} {h : F} {c d : C} [DecidableEq C],
  law.Through W obs part → part h = false → ¬obs h d → ¬law.RespondsByLevel W t h c s d
@Becoming.levelLaw_through : ∀ {F C : Type} {W : Becoming.Web F C} {obs : F → C → Prop} {part : F → Bool} {d : C}
  {mark : F → Bool}, (∀ (h : F), mark h = true → obs h d) → (Becoming.levelLaw mark d).Through W obs part
@Becoming.levelLaw_respondsByLevel : ∀ {F C : Type} {W : Becoming.Web F C} {d : C} [DecidableEq C] {mark : F → Bool}
  {h : F}, mark h = true → ∀ (t : Nat) (c : C), (Becoming.levelLaw mark d).RespondsByLevel W t h c t d
@Becoming.not_not_obs_iff_respondsByLevel : ∀ {F C : Type} {W : Becoming.Web F C} {obs : F → C → Prop} {part : F → Bool}
  {d : C} [DecidableEq C] [DecidableEq F] {h : F},
  part h = false → (¬¬obs h d ↔ ¬¬∃ law, law.Through W obs part ∧ ∃ t c s, law.RespondsByLevel W t h c s d)
@Becoming.ExchangeLaw.RespondsByCrossing.respondsTo : ∀ {F C : Type} {law : Becoming.ExchangeLaw F C}
  {W : Becoming.Web F C} {t s : Nat} {h : F} {c d : C}, law.RespondsByCrossing W t h c s d → law.RespondsTo t h c s d
@Becoming.ExchangeLaw.Through.crosses_of_unobserved : ∀ {F C : Type} {law : Becoming.ExchangeLaw F C}
  {W : Becoming.Web F C} {obs : F → C → Prop} {part : F → Bool} {t s : Nat} {h : F} {c d : C} [DecidableEq C],
  law.Through W obs part →
    part h = false →
      ¬obs h d →
        ∀ {l l' : Nat → C → Nat},
          (∀ (s' : Nat) (e : C), ¬(s' = s ∧ e = d) → l s' e = l' s' e) →
            0 < law.exchangeGap t h c l l' → ¬¬W.requires s h d ∧ ¬(W.need s h d ≤ l s d ↔ W.need s h d ≤ l' s d)
@Becoming.ble_eq_of_iff : ∀ {a b b' : Nat}, (a ≤ b ↔ a ≤ b') → a.ble b = a.ble b'
@Becoming.Web.admits_iff_of_sole : ∀ {F C : Type} {W : Becoming.Web F C} {h : F} {d : C} {l : C → Nat} {t : Nat},
  (∀ (e : C), W.requires t h e ↔ e = d) → (W.Admits l t h ↔ W.need t h d ≤ l d)
@Becoming.thresholdLaw_through : ∀ {F C : Type} {W : Becoming.Web F C} {obs : F → C → Prop} {part : F → Bool} {d : C}
  {mark : F → Bool} {T : Nat},
  (∀ (h : F), mark h = true → ∀ (e : C), W.requires T h e ↔ e = d) →
    (Becoming.thresholdLaw W mark d T).Through W obs part
@Becoming.thresholdLaw_respondsByCrossing : ∀ {F C : Type} {W : Becoming.Web F C} {t : Nat} {h : F} {d : C}
  [DecidableEq C] {mark : F → Bool},
  mark h = true →
    W.requires t h d → 0 < W.need t h d → ∀ (c : C), (Becoming.thresholdLaw W mark d t).RespondsByCrossing W t h c t d
@Becoming.crossing_passes : ∀ {F C : Type} {W : Becoming.Web F C} {obs : F → C → Prop} {part : F → Bool} {t : Nat}
  {h : F} {d : C} [DecidableEq C] [DecidableEq F],
  (∀ (e : C), W.requires t h e ↔ e = d) →
    0 < W.need t h d → ∃ law, law.Through W obs part ∧ ∀ (c : C), law.RespondsByCrossing W t h c t d
