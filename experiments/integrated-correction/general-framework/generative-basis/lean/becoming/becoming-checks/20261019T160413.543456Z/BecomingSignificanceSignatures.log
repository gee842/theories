@Becoming.bounded_rival : ∀ {F Pos : Type} {region : Pos → F → Prop},
  (Becoming.Within (fun i => region i.fst i.snd.snd) fun i => Becoming.bounded region i.fst i.snd.fst i.snd.snd) ∧
    ((∃ p f, ¬region p f) → ¬Becoming.Unrestricted (Becoming.bounded region))
@Becoming.Web.Retains.refl : ∀ {F C Pos : Type} {W : Becoming.Web F C} (sig : Pos → Nat → F → Prop) (p : Pos)
  (l : Nat → C → Nat), W.Retains sig p l l
@Becoming.Web.Retains.trans : ∀ {F C Pos : Type} {W : Becoming.Web F C} {sig : Pos → Nat → F → Prop} {p : Pos}
  {l l' l'' : Nat → C → Nat}, W.Retains sig p l l' → W.Retains sig p l' l'' → W.Retains sig p l l''
@Becoming.Web.Retains.not_added : ∀ {F C Pos : Type} {W : Becoming.Web F C} {sig : Pos → Nat → F → Prop} {p : Pos}
  {l l' : Nat → C → Nat}, W.Retains sig p l l' → ¬W.Adds sig p l' l
@Becoming.Web.Includes.retains : ∀ {F C Pos : Type} {W : Becoming.Web F C} {l l' : Nat → C → Nat},
  W.Includes l l' → ∀ (sig : Pos → Nat → F → Prop) (p : Pos), W.Retains sig p l l'
@Becoming.Web.Adds.exceeds : ∀ {F C Pos : Type} {W : Becoming.Web F C} {sig : Pos → Nat → F → Prop} {p : Pos}
  {l l' : Nat → C → Nat}, W.Adds sig p l l' → W.Exceeds l l'
@Becoming.Web.retains_iff_includes : ∀ {F C Pos : Type} {W : Becoming.Web F C} {sig : Pos → Nat → F → Prop},
  Becoming.Unrestricted sig → ∀ (p : Pos) {l l' : Nat → C → Nat}, W.Retains sig p l l' ↔ W.Includes l l'
@Becoming.Web.adds_iff_exceeds : ∀ {F C Pos : Type} {W : Becoming.Web F C} {sig : Pos → Nat → F → Prop},
  Becoming.Unrestricted sig → ∀ (p : Pos) {l l' : Nat → C → Nat}, W.Adds sig p l l' ↔ W.Exceeds l l'
@Becoming.Web.retains_agree : ∀ {F C Pos : Type} {W : Becoming.Web F C} {sig : Pos → Nat → F → Prop},
  Becoming.Unrestricted sig → ∀ (p q : Pos) {l l' : Nat → C → Nat}, W.Retains sig p l l' ↔ W.Retains sig q l l'
@Becoming.Web.widens_iff_retains_adds : ∀ {F C Pos : Type} {W : Becoming.Web F C} {sig : Pos → Nat → F → Prop},
  Becoming.Unrestricted sig →
    ∀ (p : Pos) {l l' : Nat → C → Nat}, W.Widens l l' ↔ W.Retains sig p l l' ∧ W.Adds sig p l l'
@Becoming.Web.keeps_iff_retains : ∀ {F C Pos : Type} {W : Becoming.Web F C} {sig : Pos → Nat → F → Prop},
  Becoming.Unrestricted sig →
    ∀ (p : Pos) {l l' : Nat → C → Nat}, W.Keeps l l' ↔ W.Retains sig p l l' ∧ W.Retains sig p l' l
@Becoming.Web.mixed_iff_adds : ∀ {F C Pos : Type} {W : Becoming.Web F C} {sig : Pos → Nat → F → Prop},
  Becoming.Unrestricted sig → ∀ (p : Pos) {l l' : Nat → C → Nat}, W.Mixed l l' ↔ W.Adds sig p l l' ∧ W.Adds sig p l' l
@Becoming.Web.Retains.of_fewer : ∀ {F C Pos : Type} {W : Becoming.Web F C} {sig sig' : Pos → Nat → F → Prop},
  (∀ (p : Pos) (t : Nat) (f : F), sig' p t f → sig p t f) →
    ∀ {p : Pos} {l l' : Nat → C → Nat}, W.Retains sig p l l' → W.Retains sig' p l l'
@Becoming.Web.retains_bounded_iff : ∀ {F C Pos : Type} {W : Becoming.Web F C} {region : Pos → F → Prop} {p : Pos}
  {l l' : Nat → C → Nat},
  W.Retains (Becoming.bounded region) p l l' ↔ ∀ (t : Nat), W.AdmitsWithin (region p) (l t) (l' t) t
@Becoming.Web.Retains.within : ∀ {F C Pos : Type} {W : Becoming.Web F C} {sig : Pos → Nat → F → Prop},
  Becoming.Unrestricted sig →
    ∀ {p : Pos} {l l' : Nat → C → Nat},
      W.Retains sig p l l' → ∀ (region : Pos → F → Prop), W.Retains (Becoming.bounded region) p l l'
@Becoming.Flow.retains_iff_within_margin_at : ∀ {F C Pos : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C} {l : Nat → C → Nat},
  L.WithheldLevels part W l →
    ∀ {sig : Pos → Nat → F → Prop} {p : Pos},
      (∀ (t : Nat) (f : F),
          sig p t f → W.Admits (l t) t f → ∀ (c : C), W.requires t f c → ∀ (s : Nat), s < t → L.BalancesOn W [c] s) →
        (W.Retains sig p W.level l ↔
          ∀ (t : Nat) (f : F),
            sig p t f →
              W.Admits (l t) t f →
                ∀ (c : C),
                  W.requires t f c →
                    (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                      l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c)
@Becoming.Flow.loses_iff_beyond_margin_at : ∀ {F C Pos : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C} {l : Nat → C → Nat},
  L.WithheldLevels part W l →
    ∀ {sig : Pos → Nat → F → Prop} {p : Pos},
      (∀ (t : Nat) (f : F),
          sig p t f → W.Admits (l t) t f → ∀ (c : C), W.requires t f c → ∀ (s : Nat), s < t → L.BalancesOn W [c] s) →
        (W.Adds sig p l W.level ↔
          ∃ t f,
            sig p t f ∧
              W.Admits (l t) t f ∧
                ¬∀ (c : C),
                    W.requires t f c →
                      (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                        l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c)
@Becoming.Flow.adds_iff_within_margin_at : ∀ {F C Pos : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C} {l : Nat → C → Nat},
  L.WithheldLevels part W l →
    ∀ {sig : Pos → Nat → F → Prop} {p : Pos},
      (∀ (t : Nat) (f : F),
          sig p t f → ¬W.Admits (l t) t f → ∀ (c : C), W.requires t f c → ∀ (s : Nat), s < t → L.BalancesOn W [c] s) →
        (W.Adds sig p W.level l ↔
          ∃ t f,
            sig p t f ∧
              (∀ (c : C),
                  W.requires t f c →
                    (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                      l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c) ∧
                ¬W.Admits (l t) t f)
@Becoming.Flow.Balances.retains_iff_within_margin : ∀ {F C Pos : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {sig : Pos → Nat → F → Prop} {p : Pos},
          W.Retains sig p W.level l ↔
            ∀ (t : Nat) (f : F),
              sig p t f →
                W.Admits (l t) t f →
                  ∀ (c : C),
                    W.requires t f c →
                      (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                        l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c
@Becoming.Flow.Balances.loses_iff_beyond_margin : ∀ {F C Pos : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {sig : Pos → Nat → F → Prop} {p : Pos},
          W.Adds sig p l W.level ↔
            ∃ t f,
              sig p t f ∧
                W.Admits (l t) t f ∧
                  ¬∀ (c : C),
                      W.requires t f c →
                        (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                          l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c
@Becoming.Flow.Balances.adds_iff_within_margin : ∀ {F C Pos : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {sig : Pos → Nat → F → Prop} {p : Pos},
          W.Adds sig p W.level l ↔
            ∃ t f,
              sig p t f ∧
                (∀ (c : C),
                    W.requires t f c →
                      (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                        l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c) ∧
                  ¬W.Admits (l t) t f
@Becoming.Flow.widens_iff_within_margin_at : ∀ {F C : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C} {l : Nat → C → Nat},
  L.WithheldLevels part W l →
    (∀ (t : Nat) (f : F) (c : C), W.requires t f c → ∀ (s : Nat), s < t → L.BalancesOn W [c] s) →
      (W.Widens W.level l ↔
        (∀ (t : Nat) (f : F),
            W.Admits (l t) t f →
              ∀ (c : C),
                W.requires t f c →
                  (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                    l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c) ∧
          ∃ t f,
            (∀ (c : C),
                W.requires t f c →
                  (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                    l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c) ∧
              ¬W.Admits (l t) t f)
@Becoming.Flow.Balances.widens_iff_within_margin : ∀ {F C : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        (W.Widens W.level l ↔
          (∀ (t : Nat) (f : F),
              W.Admits (l t) t f →
                ∀ (c : C),
                  W.requires t f c →
                    (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                      l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c) ∧
            ∃ t f,
              (∀ (c : C),
                  W.requires t f c →
                    (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                      l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c) ∧
                ¬W.Admits (l t) t f)
@Becoming.Valuation.premises_of_unrestricted : ∀ {F Pos Q : Type} {V : Becoming.Valuation Pos Q}
  {sig : Pos → Nat → F → Prop},
  Becoming.Unrestricted sig →
    ∀ (formation : Q → F) (step : Q → Nat),
      (∀ (p : Pos) (c : Q), sig p (step c) (formation c) → V.sig p c) →
        V.Significant ∧
          (∀ (p : Pos), V.SelfGood p) ∧
            Becoming.Neutral V.transmits ∧ Becoming.Neutral V.shares ∧ ∀ (c : Q), V.living c → ∀ (a : Pos), V.Seed
@Becoming.Web.significant_of_unrestricted : ∀ {F C Pos : Type} (W : Becoming.Web F C) {sig : Pos → Nat → F → Prop},
  Becoming.Unrestricted sig →
    ∀ (own : Pos → F × Nat → Prop) (own' : Pos → F × C × Nat → Prop),
      (W.valuation own fun p e => sig p e.snd e.fst).Significant ∧
        (W.relations own' fun p e => sig p e.snd.snd e.fst).Significant
@Becoming.Web.significance_undetermined : ∀ {F C Pos : Type} (W : Becoming.Web F C) (own : Pos → F × Nat → Prop)
  (p : Pos) {e : F × Nat},
  W.active e.snd e.fst ∧ ¬Becoming.Web.UnderminingAt e.snd e.fst →
    (∀ (l l' : Nat → C → Nat), W.Retains (fun x x_1 x_2 => False) p l l' ∧ ¬W.Adds (fun x x_1 x_2 => False) p l l') ∧
      (W.valuation own fun x x_1 => True).Significant ∧ ¬(W.valuation own fun x x_1 => False).Significant
