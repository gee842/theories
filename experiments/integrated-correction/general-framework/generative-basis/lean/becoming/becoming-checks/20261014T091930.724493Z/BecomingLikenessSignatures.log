  {G : Becoming.Frame S' A C},
  (∃ l, ∀ (a : A), a ∈ l) →
    (∃ l, ∀ (c : C), c ∈ l) →
      Becoming.FiniteDecided F →
        Becoming.FiniteDecided G → ∀ (s : S) (s' : S'), Becoming.Decided (Becoming.Alike F G s s')
@Becoming.alike_iff_alikeTo : ∀ {S : Type u_1} {S' : Type u_4} {A : Type u_2} {C : Type u_3} {F : Becoming.Frame S A C}
  {G : Becoming.Frame S' A C},
  (∃ l, ∀ (a : A), a ∈ l) →
    (∃ l, ∀ (c : C), c ∈ l) →
      Becoming.FiniteDecided F →
        Becoming.FiniteDecided G →
          ∀ {s : S} {s' : S'}, Becoming.Alike F G s s' ↔ ∀ (k : Nat), Becoming.AlikeTo F G k s s'
@Becoming.alike_iff_alikeTo_pairs : ∀ {S : Type u_1} {S' : Type u_4} {A : Type u_2} {C : Type u_3}
  {F : Becoming.Frame S A C} {G : Becoming.Frame S' A C},
