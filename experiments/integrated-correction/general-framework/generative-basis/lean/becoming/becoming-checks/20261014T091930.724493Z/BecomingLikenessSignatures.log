    Becoming.Choosing.bothOpen ∧
  ¬Becoming.BranchingTest.Holds Becoming.Choosing.early Becoming.Choosing.Pos.p0 Becoming.Choosing.bothOpen
@Becoming.Dependence.dichotomy_of_same_level : ∀ {S : Type u_1} {A : Type u_2} {F C : Type}
  {K : Becoming.Dependence S F C} {P : Generative.Process S A} {withhold : F → S → S} {f : F} {s : S} {a : A} {g : F}
  {c : C},
  (∀ (t t' : S), P.step (withhold f s) a t → P.step (withhold f s) a t' → K.level t c = K.level t' c) →
    K.BreaksBy P s a g c →
      ∀ {t₀ : S},
        P.step (withhold f s) a t₀ →
          K.requires (withhold f s) g c →
            K.need (withhold f s) g c ≤ K.level (withhold f s) c →
              K.MakesDifference P withhold f s a g c ∨ K.BreaksBy P (withhold f s) a g c
