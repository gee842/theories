  (P : Generative.Process S A) (π : S → K) {claims : K → D → Prop} {E : K → K → Prop},
  Equivalence E →
    Becoming.Registers claims E →
      Becoming.GoAlikeUnder P π E →
        ∀ (k : K), Becoming.DeterminedAt { P := Becoming.imageUnder P π E, realized := claims } k
@Becoming.alike_equivalence : ∀ {A : Type u_1} {K : Type u_2} {D : Type u_3} (F : Becoming.Frame K A D),
  Equivalence (Becoming.Alike F F)
@Becoming.alike_registers : ∀ {A : Type u_1} {K : Type u_2} {D : Type u_3} (F : Becoming.Frame K A D),
  Becoming.Registers F.realized (Becoming.Alike F F)
@Becoming.carries_law_alike_iff : ∀ {S : Type u_1} {A : Type u_2} {K : Type u_3} {D : Type u_4}
  {P : Generative.Process S A} {π : S → K} {claims : K → D → Prop},
  (∃ Q, (∀ (k : K), Becoming.DeterminedAt { P := Q, realized := claims } k) ∧ Becoming.FactorsThrough P π Q) ↔
    ∃ E, Equivalence E ∧ Becoming.Registers claims E ∧ Becoming.GoAlikeUnder P π E
@Becoming.eq_equivalence : ∀ {K : Type u_1}, Equivalence fun k k' => k = k'
@Becoming.carries_law_named_iff : ∀ {S : Type u_1} {A : Type u_2} {K : Type u_3} {P : Generative.Process S A}
  {π : S → K},
  (∃ Q,
      (∀ (k : K), Becoming.DeterminedAt { P := Q, realized := fun k k' => k = k' } k) ∧ Becoming.FactorsThrough P π Q) ↔
    Becoming.GoAlike P π
@Becoming.image_determinedAt_iff : ∀ {S : Type u_1} {A : Type u_2} {K : Type u_3} {D : Type u_4}
  {P : Generative.Process S A} {π : S → K} {claims : K → D → Prop},
  (∀ (k : K), Becoming.DeterminedAt { P := Becoming.Image P π, realized := claims } k) ↔
    Becoming.GoAlikeUnder P π
      (Becoming.Alike { P := Becoming.Image P π, realized := claims } { P := Becoming.Image P π, realized := claims })
Becoming.Parting.going_not_stopped : ¬Becoming.Alike
    { P := Becoming.Image Becoming.Parting.process id, realized := Becoming.Parting.claims }
    { P := Becoming.Image Becoming.Parting.process id, realized := Becoming.Parting.claims } Becoming.Parting.Pos.going
    Becoming.Parting.Pos.stopped
Becoming.Parting.image_not_determinedAt : ¬Becoming.DeterminedAt
    { P := Becoming.Image Becoming.Parting.process id, realized := Becoming.Parting.claims } Becoming.Parting.Pos.start
Becoming.Parting.carries : ∃ Q,
  (∀ (k : Becoming.Parting.Pos), Becoming.DeterminedAt { P := Q, realized := Becoming.Parting.claims } k) ∧
    Becoming.FactorsThrough Becoming.Parting.process id Q
@Becoming.Run.not_fixesAlike_other_of_new : ∀ {S : Type u_1} {A : Type u_2} {C : Type u_3} {F : Becoming.Frame S A C},
  (∀ (x : S), Becoming.DeterminedAt F x) →
    ∀ (r : Becoming.Run F.P),
      (∀ (i j : Nat), i < j → ¬Becoming.Alike F F (r.state i) (r.state j)) →
        ∀ {n t : Nat} {b : A},
          b ≠ r.act n →
            ∀ {x y : S} {c : C}, F.realized x c → ¬F.realized y c → ¬∃ u, r.FixesAlike F.realized t (r.state n) b u
