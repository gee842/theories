  (∀ (k : K), Becoming.DeterminedAt { P := Q, realized := claims } k) →
    ∀ {t : Nat},
      r.StepsThrough π Q t →
        ∀ {k : K} {a : A},
          ¬r.TakesThroughAlike π Q claims t k a →
            ∀ {x y : K} {d : D}, claims x d → ¬claims y d → ¬∃ κ, r.FixesThroughAlike π claims t k a κ
@Becoming.Run.not_fixesThroughAlike_of_goAlikeUnder : ∀ {S : Type u_1} {A : Type u_2} {K : Type u_3} {D : Type u_4}
  {P : Generative.Process S A} (r : Becoming.Run P) {π : S → K} {claims : K → D → Prop} {E : K → K → Prop},
  Equivalence E →
    Becoming.Registers claims E →
      Becoming.GoAlikeUnder P π E →
        ∀ {t : Nat} {k : K} {a : A},
          ¬r.TakesThroughAlike π (Becoming.imageUnder P π E) claims t k a →
            ∀ {x y : K} {d : D}, claims x d → ¬claims y d → ¬∃ κ, r.FixesThroughAlike π claims t k a κ
