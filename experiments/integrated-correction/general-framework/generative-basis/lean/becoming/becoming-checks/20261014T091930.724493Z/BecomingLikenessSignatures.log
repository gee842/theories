@Becoming.factors_imageUnder : ∀ {S : Type u_1} {A : Type u_2} {K : Type u_3} (P : Generative.Process S A) (π : S → K)
  {E : K → K → Prop}, Equivalence E → Becoming.FactorsThrough P π (Becoming.imageUnder P π E)
