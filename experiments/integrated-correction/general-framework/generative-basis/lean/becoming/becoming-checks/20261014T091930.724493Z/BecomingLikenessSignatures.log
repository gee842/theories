  (r : Becoming.Run F.P),
  (∀ (i j : Nat), i < j → ¬Becoming.Alike F F (r.state i) (r.state j)) → ∀ (i j : Nat), i < j → r.state i ≠ r.state j
@Becoming.Run.not_fixesThroughAlike_of_untaken : ∀ {S : Type u_1} {A : Type u_2} {K : Type u_3} {D : Type u_4}
