  (Becoming.pairsOf l m).length = m.length * l.length
@Becoming.holds_below : ∀ {X : Type u_1} {P : Nat → X → Prop},
  (∀ (k : Nat) (x : X), P (k + 1) x → P k x) → ∀ {x : X} {b a : Nat}, b ≤ a → P a x → P b x
@Becoming.drops_somewhere : ∀ {X : Type u_1} {P : Nat → X → Prop} {x : X},
