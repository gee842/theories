@Becoming.Web.stock_le : ∀ {F C : Type} (W : Becoming.Web F C) {t : Nat} (cs : List C),
  W.Still cs t → W.stock cs (t + 1) ≤ W.stock cs t
@Becoming.Web.stock_lt : ∀ {F C : Type} (W : Becoming.Web F C) {t : Nat} (cs : List C),
  W.Still cs t → (∃ c, c ∈ cs ∧ W.Falls t c) → W.stock cs (t + 1) < W.stock cs t
@Becoming.Web.paid_finitely : ∀ {F C : Type} (W : Becoming.Web F C) (cs : List C) (T : Nat) (event : Nat → Prop),
  (∀ (t : Nat), T ≤ t → W.Still cs t) → W.Paid cs event → ¬∀ (N : Nat), ∃ t, N ≤ t ∧ event t
@Becoming.Web.Unceasing.rises : ∀ {F C : Type} (W : Becoming.Web F C) {cs : List C},
  (W.Paid cs fun t => ∃ f, W.Arises t f) → W.Unceasing → ∀ (T : Nat), ¬∀ (t : Nat), T ≤ t → W.Still cs t
@Becoming.Web.Unceasing.regeneration_recurs : ∀ {F C : Type} (W : Becoming.Web F C) {renews : Nat → F → C → Prop}
  {cs : List C},
  W.RenewedBy renews →
    (W.Paid cs fun t => ∃ f, W.Arises t f) →
      W.Unceasing → ∀ (T : Nat), ¬∀ (t : Nat), T ≤ t → ∀ (f : F), ¬W.Regenerating renews cs t f
@Becoming.Web.substitution_defers : ∀ {F C : Type} (W : Becoming.Web F C) (cs : List C) (f : F) (T : Nat),
  (∀ (t : Nat), T ≤ t → W.Still cs t) → (W.Paid cs fun t => W.active t f) → ¬∀ (N : Nat), ∃ t, N ≤ t ∧ W.active t f
@Becoming.Web.conserved_ceases : ∀ {F C : Type} (W : Becoming.Web F C) (cs : List C),
  (∀ (t : Nat), W.stock cs (t + 1) ≤ W.stock cs t) →
    (∀ (t : Nat) (f : F), W.Arises t f → W.stock cs (t + 1) < W.stock cs t) → ¬W.Unceasing
Becoming.Commons.renewal_without_generation : (Becoming.Commons.conditions.dependence.along
        Becoming.Commons.sharing).Renewed
    () ∧
  ∀ (t : Nat) (f : Becoming.Commons.Formation),
    ¬(Becoming.Commons.conditions.dependence.along Becoming.Commons.sharing).Arises t f
Becoming.Growth.left_succ_le : ∀ (t : Nat), Becoming.Growth.left (t + 1) ≤ Becoming.Growth.left t
Becoming.Growth.left_late : ∀ (t : Nat), 3 ≤ t → Becoming.Growth.left t = 0
Becoming.Growth.ceases : Becoming.Growth.web.Dependent ∧
  Becoming.Growth.web.Arises 0 0 ∧
    Becoming.Growth.web.Arises 1 1 ∧
      Becoming.Growth.web.ConsumingIn 0 ∧
        (∀ (t : Nat), ¬Becoming.Growth.web.Rises t ()) ∧ ¬Becoming.Growth.web.Unceasing
Becoming.Relay.reserve_succ_le : ∀ (t : Nat) (c : Becoming.Relay.Source),
  Becoming.Relay.reserve (t + 1) c ≤ Becoming.Relay.reserve t c
Becoming.Relay.defers : Becoming.Relay.web.Dependent ∧
  Becoming.Relay.web.active 0 () ∧
    Becoming.Relay.web.active 1 () ∧
      Becoming.Relay.web.Dissolves 0 () Becoming.Relay.Source.first ∧
        Becoming.Relay.web.Forms 0 () Becoming.Relay.Source.second ∧
          Becoming.Relay.web.ConsumingIn () ∧
            (∀ (t : Nat), 2 ≤ t → ¬Becoming.Relay.web.active t ()) ∧
              ¬∀ (N : Nat), ∃ t, N ≤ t ∧ Becoming.Relay.web.active t ()
Becoming.Bloom.glow_even : ∀ (n : Nat), Becoming.Bloom.glow (2 * n) = 2
Becoming.Bloom.glow_odd : ∀ (n : Nat), Becoming.Bloom.glow (2 * n + 1) = 1
Becoming.Bloom.back : ∀ (t : Nat), 2 ≤ Becoming.Bloom.glow (t + 1) ∨ 2 ≤ Becoming.Bloom.glow (t + 2)
Becoming.Bloom.unceasing : Becoming.Bloom.web.Dependent ∧
  Becoming.Bloom.web.RenewedBy Becoming.Bloom.renews ∧
    (Becoming.Bloom.web.Paid [()] fun t => ∃ f, Becoming.Bloom.web.Arises t f) ∧
      Becoming.Bloom.web.Unceasing ∧
        ∀ (T : Nat),
          ¬∀ (t : Nat),
              T ≤ t → ∀ (f : Becoming.Bloom.Formation), ¬Becoming.Bloom.web.Regenerating Becoming.Bloom.renews [()] t f
Becoming.Bloom.readings : (∀ (n : Nat), Becoming.Web.UnderminingAt (2 * n) Becoming.Bloom.Formation.bloom) ∧
  Becoming.Bloom.web.RenewingInWithin 2 Becoming.Bloom.Formation.bloom
