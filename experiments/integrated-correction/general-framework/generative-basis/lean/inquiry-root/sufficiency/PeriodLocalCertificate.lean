import PhaseCycleDerivation
import PeriodWindowPruning

/-! Period-independent local-word certificate. The semantic reduction from the
native knowing-arrival game must be justified separately; these finite kernel
facts alone do not state a theorem about arbitrary cycle lengths. -/

namespace Generative.InquirySufficiency.PeriodLocalCertificate

open PhaseCycleDerivation (upto)

abbrev Mask := Nat

def universeMask : Mask := 2^128 - 1

/-- Fixed-width structural arithmetic avoids the library bitwise recursion's
propositional-extensionality dependency. All masks used here fit in 128 bits. -/
def maskAnd : Nat → Mask → Mask → Mask
  | 0, _, _ => 0
  | fuel + 1, a, b =>
    if a == 0 || b == 0 then 0 else (a % 2 * (b % 2)) + 2 * maskAnd fuel (a / 2) (b / 2)

def maskOr : Nat → Mask → Mask → Mask
  | 0, _, _ => 0
  | fuel + 1, a, b =>
    if a == 0 then b else if b == 0 then a else
      max (a % 2) (b % 2) + 2 * maskOr fuel (a / 2) (b / 2)

def bit (mask index : Nat) : Bool := mask / 2^index % 2 == 1

def subsetBits : Nat → Mask → Mask → Bool
  | 0, _, _ => true
  | fuel + 1, a, b =>
    if a == 0 then true else
      (a % 2 != 1 || b % 2 == 1) && subsetBits fuel (a / 2) (b / 2)

def included (a b : Mask) : Bool := subsetBits 128 a b

def setBit (mask : Mask) (index : Nat) : Mask :=
  if bit mask index then mask else mask + 2^index

def bitMask (position : Nat) : Mask :=
  (upto 128).foldl (fun mask word => if bit word position then setBit mask word else mask) 0

def observedMask (position : Nat) : Mask :=
  (upto 128).foldl (fun mask word =>
    if bit word position != bit word 0 then setBit mask word else mask) 0

/-- Insert a language, retaining only maximal members under inclusion. -/
def insertMax (item : Mask) (items : List Mask) : List Mask :=
  if items.any (included item) then items else item :: items.filter (fun other => !included other item)

def maximal (items : List Mask) : List Mask := items.foldl (fun kept item => insertMax item kept) []

def restrict (mask : Mask) (items : List Mask) : List Mask :=
  maximal (items.map (fun item => maskAnd 128 item mask))

def joined (low high : List Mask) : List Mask :=
  low.flatMap fun left => high.map fun right => maskOr 128 left right

/-- Maximal success languages of the residual strategies after the first read.
Word bits run chronologically from least to most significant. -/
def languages : Nat → Nat → List Mask
  | 0, position => [bitMask position]
  | budget + 1, position =>
    let previous := languages budget position
    let observation := observedMask position
    maximal ([bitMask position] ++ languages budget (position + 1) ++
      joined (restrict (universeMask - observation) previous) (restrict observation previous))

def flipWords (mask : Mask) : Mask :=
  (upto 128).foldl (fun answer word => if bit mask word then setBit answer (127 - word) else answer) 0

/-- Delete edges without an allowed successor or without an allowed predecessor.
Any cyclic factor set contained in the mask is preserved at every round. -/
def trimOnce (mask : Mask) : Mask :=
  (upto 128).foldl (fun answer word =>
    if bit mask word &&
      (bit mask (word / 2) || bit mask (word / 2 + 64)) &&
      (bit mask (word * 2 % 128) || bit mask (word * 2 % 128 + 1))
    then setBit answer word else answer) 0

def trim : Nat → Mask → Mask
  | 0, mask => mask
  | fuel + 1, mask =>
    let next := trimOnce mask
    if next == mask then mask else trim fuel next

def recurrentLanguages : List Mask := maximal ((languages 6 0).map (trim 128))

def jointLanguages : List Mask :=
  maximal (recurrentLanguages.flatMap fun high => recurrentLanguages.map fun low =>
    trim 128 (maskAnd 128 high (flipWords low)))

def sixRecurrent : List Mask := maximal ((languages 5 0).map (trim 128))

def sixJoint : List Mask :=
  maximal (sixRecurrent.flatMap fun high => sixRecurrent.map fun low =>
    trim 128 (maskAnd 128 high (flipWords low)))

def nativeWords : Mask := setBit (setBit (setBit 0 18) 36) 73

def invertedWords : Mask := flipWords nativeWords

