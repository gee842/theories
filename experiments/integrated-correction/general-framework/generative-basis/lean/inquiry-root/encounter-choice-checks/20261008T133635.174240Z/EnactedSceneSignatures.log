Generative.EnactedScene.moving_preserves_binding_records (p : Generative.EnactedScene.Place)
  (s : Generative.EnactedScene.Situation) : (Generative.EnactedScene.move p s).lexicon.records = s.lexicon.records
Generative.EnactedScene.moving_preserves_support_account (p : Generative.EnactedScene.Place)
  (s : Generative.EnactedScene.Situation) :
  (Generative.EnactedScene.move p s).lexicon.percept.machine.support +
      (Generative.EnactedScene.move p s).lexicon.percept.machine.spent =
    s.lexicon.percept.machine.support + s.lexicon.percept.machine.spent
Generative.EnactedScene.unaffordable_movement_preserves_actual_position (p : Generative.EnactedScene.Place)
  (s : Generative.EnactedScene.Situation)
  (short : s.lexicon.percept.machine.support < Generative.EnactedScene.distance s.position p) :
  Generative.EnactedScene.move p s = s
Generative.EnactedScene.same_inputs_preserve_interpretation (s t : Generative.AcquiredBinding.Lexicon)
  (h : Generative.EnactedScene.interpretationInputs s = Generative.EnactedScene.interpretationInputs t)
  (raw : List Generative.AcquiredSegmentation.Sound) :
  Generative.AcquiredBinding.interpret s raw = Generative.AcquiredBinding.interpret t raw
Generative.EnactedScene.movement_changes_accessible_alternatives :
  Generative.EnactedScene.visible (Generative.EnactedScene.start 37) =
      [Generative.CompositionalAcquisition.p0, Generative.CompositionalAcquisition.p1] ∧
    Generative.EnactedScene.visible (Generative.EnactedScene.move (0, 1) (Generative.EnactedScene.start 37)) =
        [Generative.CompositionalAcquisition.p0, Generative.AcquiredBinding.extra] ∧
      Generative.EnactedScene.visible
          (Generative.EnactedScene.move (2, 2)
            (Generative.EnactedScene.move (0, 1) (Generative.EnactedScene.start 37))) =
        [Generative.CompositionalAcquisition.p1, Generative.AcquiredBinding.extra]
Generative.EnactedScene.enacted_scenes_supply_the_previous_binding_inputs :
  Generative.EnactedScene.interpretationInputs (Generative.EnactedScene.coordinated 37).lexicon =
    Generative.EnactedScene.interpretationInputs (Generative.AcquiredBinding.learned 32)
Generative.EnactedScene.enacted_access_enters_all_sequence_interpretation (ws : List Bool) :
  Generative.AcquiredBinding.interpret (Generative.EnactedScene.coordinated 37).lexicon
      (Generative.AcquiredSegmentation.encode ws) =
    Generative.AcquiredSegmentation.assembleMessage (List.map Generative.CompositionalAcquisition.Expr.atom ws)
Generative.EnactedScene.enacted_access_reaches_actual_response :
  Option.map (fun r => (r.fst, r.snd.percept.machine.support, r.snd.percept.machine.spent))
      (Generative.AcquiredBinding.execute Generative.AcquiredSegmentation.utterance
        (Generative.EnactedScene.coordinated 37).lexicon) =
    some ([true, false, true], 0, 30)
Generative.EnactedScene.movement_is_in_the_same_support_history :
  (Generative.EnactedScene.coordinated 37).lexicon.percept.machine.support = 4 ∧
    (Generative.EnactedScene.coordinated 37).lexicon.percept.machine.spent = 26 ∧ 7 + 7 + 10 + 5 + 4 + 4 = 37
Generative.EnactedScene.stationary_repetition_leaves_both_bindings_ambiguous :
  (Generative.EnactedScene.stationary 37).lexicon.records.length = 4 ∧
    Generative.AcquiredBinding.resolve (Generative.EnactedScene.stationary 37).lexicon
          (Generative.AcquiredSegmentation.word false) =
        none ∧
      Generative.AcquiredBinding.resolve (Generative.EnactedScene.stationary 37).lexicon
          (Generative.AcquiredSegmentation.word true) =
        none
Generative.EnactedScene.access_without_recording_does_not_acquire_the_bindings :
  (Generative.EnactedScene.coordinated 37 false).position = (Generative.EnactedScene.coordinated 37).position ∧
    (Generative.EnactedScene.coordinated 37 false).lexicon.percept.machine =
        (Generative.EnactedScene.coordinated 37).lexicon.percept.machine ∧
      (Generative.EnactedScene.coordinated 37 false).lexicon.records = [] ∧
        Generative.AcquiredBinding.interpret (Generative.EnactedScene.coordinated 37 false).lexicon
            Generative.AcquiredSegmentation.utterance =
          none
Generative.EnactedScene.unchanged_position_and_name_counts_do_not_establish_coordination :
  (Generative.EnactedScene.mistimed 37).position = (Generative.EnactedScene.coordinated 37).position ∧
    (Generative.EnactedScene.mistimed 37).lexicon.percept.machine =
        (Generative.EnactedScene.coordinated 37).lexicon.percept.machine ∧
      List.count (Generative.AcquiredSegmentation.word false)
            (List.map Generative.AcquiredBinding.Encounter.form (Generative.EnactedScene.mistimed 37).lexicon.records) =
          2 ∧
        List.count (Generative.AcquiredSegmentation.word true)
              (List.map Generative.AcquiredBinding.Encounter.form
                (Generative.EnactedScene.mistimed 37).lexicon.records) =
            2 ∧
          Generative.AcquiredBinding.resolve (Generative.EnactedScene.mistimed 37).lexicon
                (Generative.AcquiredSegmentation.word false) =
              some Generative.CompositionalAcquisition.p1 ∧
            Generative.AcquiredBinding.resolve (Generative.EnactedScene.mistimed 37).lexicon
                (Generative.AcquiredSegmentation.word true) =
              some Generative.CompositionalAcquisition.p0
Generative.EnactedScene.mistimed_naming_produces_an_actual_inverted_response :
  Option.map Prod.fst
      (Generative.AcquiredBinding.execute Generative.AcquiredSegmentation.utterance
        (Generative.EnactedScene.mistimed 37).lexicon) =
    some [false, true, false]
Generative.EnactedScene.a_clear_view_can_omit_the_named_target :
  Generative.EnactedScene.visible Generative.EnactedScene.narrowWrong = [Generative.AcquiredBinding.extra] ∧
    Generative.AcquiredBinding.resolve Generative.EnactedScene.narrowWrong.lexicon
          (Generative.AcquiredSegmentation.word false) =
        some Generative.AcquiredBinding.extra ∧
      Option.map Prod.fst
          (Generative.AcquiredBinding.execute (Generative.AcquiredSegmentation.word false)
            Generative.EnactedScene.narrowWrong.lexicon) =
        some [false, false]
Generative.EnactedScene.movement_support_can_run_out_before_a_response :
  Generative.AcquiredBinding.interpret (Generative.EnactedScene.coordinated 36).lexicon
        Generative.AcquiredSegmentation.utterance =
      some Generative.AcquiredSegmentation.intended ∧
    Generative.AcquiredBinding.execute Generative.AcquiredSegmentation.utterance
        (Generative.EnactedScene.coordinated 36).lexicon =
      none
Generative.EnactedScene.impossible_movement_does_not_invent_a_new_scene :
  (Generative.EnactedScene.move (2, 2) (Generative.EnactedScene.start 24)).position = (1, 0) ∧
    Generative.EnactedScene.visible (Generative.EnactedScene.move (2, 2) (Generative.EnactedScene.start 24)) =
      [Generative.CompositionalAcquisition.p0, Generative.CompositionalAcquisition.p1]
