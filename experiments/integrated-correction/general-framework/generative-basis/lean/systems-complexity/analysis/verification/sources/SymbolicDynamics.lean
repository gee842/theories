import Std

set_option autoImplicit false

/-!
Finite autonomous dynamics and an infinite symbolic chaos witness.

Only Std is imported. `PrefixOpen` is explicitly the topology generated by
agreement on finitely many initial binary coordinates. Sensitivity below uses
its prefix uniformity: one fixed finite observation separates arbitrarily
close initial streams after iteration. No finite learner, Lorenz flow, ethical
direction, or physical realization is asserted to satisfy these definitions.
-/

namespace SystemsComplexity.SymbolicDynamics

def iterate {α : Type} (f : α → α) : Nat → α → α
  | 0, x => x
  | n + 1, x => f (iterate f n x)

theorem iterate_add {α : Type} (f : α → α) (a b : Nat) (x : α) :
    iterate f (a + b) x = iterate f b (iterate f a x) := by
  induction b with
  | zero => simp [iterate]
  | succ b ih => simp [iterate, ih]

def eraseValue {n : Nat} (c x : Fin (n + 1)) (hne : x ≠ c) : Fin n :=
  ⟨if x.val < c.val then x.val else x.val - 1, by
    have hxc : x.val ≠ c.val := fun h => hne (Fin.ext h)
    have hx := x.isLt
    have hc := c.isLt
    split <;> omega⟩

theorem eraseValue_injective {n : Nat} (c x y : Fin (n + 1))
    (hx : x ≠ c) (hy : y ≠ c)
    (h : eraseValue c x hx = eraseValue c y hy) : x = y := by
  apply Fin.ext
  have hval := congrArg Fin.val h
  have hxc : x.val ≠ c.val := fun h => hx (Fin.ext h)
  have hyc : y.val ≠ c.val := fun h => hy (Fin.ext h)
  simp only [eraseValue] at hval
  split at hval <;> split at hval <;> omega

/-- A genuine pigeonhole argument: among the first n+1 values in Fin n,
    two positions i<j≤n coincide. No collision is assumed as a premise. -/
theorem finite_collision (n : Nat) (f : Nat → Fin n) :
    ∃ i j, i < j ∧ j ≤ n ∧ f i = f j := by
  induction n with
  | zero => have h := (f 0).isLt; omega
  | succ n ih =>
    classical
    by_cases h : ∃ i, i ≤ n ∧ f i = f (n + 1)
    · obtain ⟨i, hi, he⟩ := h
      exact ⟨i, n + 1, by omega, by omega, he⟩
    · have avoid : ∀ i, i ≤ n → f i ≠ f (n + 1) := by
        intro i hi he
        exact h ⟨i, hi, he⟩
      let g : Nat → Fin n := fun i =>
        eraseValue (f (n + 1)) (f (min i n)) (avoid _ (Nat.min_le_right _ _))
      obtain ⟨i, j, hij, hj, he⟩ := ih g
      have hi : i ≤ n := by omega
      have eqval : f (min i n) = f (min j n) :=
        eraseValue_injective _ _ _ _ _ he
      simp only [Nat.min_eq_left hi, Nat.min_eq_left hj] at eqval
      exact ⟨i, j, hij, by omega, eqval⟩

def EventuallyPeriodic {α : Type} (f : α → α) (x : α) : Prop :=
  ∃ a p, 0 < p ∧ ∀ t,
    iterate f (a + t + p) x = iterate f (a + t) x

/-- An injective finite encoding is enough: the complete state may have any
    type. The bound is on the beginning plus period, not just existence. -/
theorem finite_eventually_periodic {α : Type} (f : α → α) (x : α)
    (n : Nat) (encode : α → Fin n)
    (hinj : ∀ a b, encode a = encode b → a = b) :
    ∃ a p, 0 < p ∧ a + p ≤ n ∧ ∀ t,
      iterate f (a + t + p) x = iterate f (a + t) x := by
  obtain ⟨i, j, hij, hj, he⟩ := finite_collision n (fun t => encode (iterate f t x))
  have hstate : iterate f i x = iterate f j x := hinj _ _ he
  refine ⟨i, j - i, by omega, by omega, ?_⟩
  intro t
  have hidx : i + t + (j - i) = j + t := by omega
  rw [hidx, iterate_add, iterate_add, hstate]

theorem finite_eventuallyPeriodic {α : Type} (f : α → α) (x : α)
    (n : Nat) (encode : α → Fin n)
    (hinj : ∀ a b, encode a = encode b → a = b) :
    EventuallyPeriodic f x := by
  obtain ⟨a, p, hp, _, ht⟩ := finite_eventually_periodic f x n encode hinj
  exact ⟨a, p, hp, ht⟩

abbrev Stream := Nat → Bool

def PrefixEq (n : Nat) (x y : Stream) : Prop :=
  ∀ i, i < n → x i = y i

def PrefixOpen (u : Stream → Prop) : Prop :=
  ∀ x, u x → ∃ n, ∀ y, PrefixEq n x y → u y

theorem prefix_refl (n : Nat) (x : Stream) : PrefixEq n x x := by
  intro i hi
  rfl

theorem prefix_symm {n : Nat} {x y : Stream} (h : PrefixEq n x y) :
    PrefixEq n y x := by
  intro i hi
  exact (h i hi).symm

theorem prefix_trans {n : Nat} {x y z : Stream}
    (hxy : PrefixEq n x y) (hyz : PrefixEq n y z) : PrefixEq n x z := by
  intro i hi
  exact (hxy i hi).trans (hyz i hi)

theorem prefix_mono {m n : Nat} {x y : Stream}
    (hmn : m ≤ n) (h : PrefixEq n x y) : PrefixEq m x y := by
  intro i hi
  exact h i (by omega)

theorem prefix_open_empty : PrefixOpen (fun _ => False) := by
  intro x hx
  exact False.elim hx

theorem prefix_open_univ : PrefixOpen (fun _ => True) := by
  intro x hx
  exact ⟨0, fun _ _ => True.intro⟩

theorem prefix_open_inter {u v : Stream → Prop}
    (hu : PrefixOpen u) (hv : PrefixOpen v) : PrefixOpen (fun x => u x ∧ v x) := by
  intro x hx
  obtain ⟨n, hn⟩ := hu x hx.1
  obtain ⟨m, hm⟩ := hv x hx.2
  refine ⟨max n m, ?_⟩
  intro y hy
  exact ⟨hn y (prefix_mono (Nat.le_max_left _ _) hy),
    hm y (prefix_mono (Nat.le_max_right _ _) hy)⟩

theorem prefix_open_union {ι : Type} (u : ι → Stream → Prop)
    (h : ∀ i, PrefixOpen (u i)) : PrefixOpen (fun x => ∃ i, u i x) := by
  intro x hx
  obtain ⟨i, hi⟩ := hx
  obtain ⟨n, hn⟩ := h i x hi
  exact ⟨n, fun y hy => ⟨i, hn y hy⟩⟩

theorem cylinder_open (n : Nat) (x : Stream) : PrefixOpen (PrefixEq n x) := by
  intro y hy
  exact ⟨n, fun z hz => prefix_trans hy hz⟩

/-- Basic product neighborhoods fix an arbitrary finite list of coordinates,
    rather than necessarily an initial interval. -/
def CoordinateOpen (u : Stream → Prop) : Prop :=
  ∀ x, u x → ∃ coordinates : List Nat, ∀ y,
    (∀ i, i ∈ coordinates → x i = y i) → u y

def coordinateBound : List Nat → Nat
  | [] => 0
  | i :: rest => max (i + 1) (coordinateBound rest)

theorem member_lt_coordinateBound (coordinates : List Nat) (i : Nat)
    (hi : i ∈ coordinates) : i < coordinateBound coordinates := by
  induction coordinates with
  | nil => simp at hi
  | cons j rest ih =>
    simp only [List.mem_cons] at hi
    simp only [coordinateBound]
    rcases hi with rfl | hi
    · have h := Nat.le_max_left (i + 1) (coordinateBound rest)
      omega
    · have h := ih hi
      have hm := Nat.le_max_right (j + 1) (coordinateBound rest)
      omega

/-- The cylinder-open definition is exactly the finite-coordinate product
    topology of discrete Bool; it is not a topology chosen after the witness. -/
theorem prefix_open_iff_coordinate_open (u : Stream → Prop) :
    PrefixOpen u ↔ CoordinateOpen u := by
  constructor
  · intro hu x hx
    obtain ⟨n, hn⟩ := hu x hx
    refine ⟨List.range n, ?_⟩
    intro y hy
    apply hn y
    intro i hi
    exact hy i (List.mem_range.mpr hi)
  · intro hu x hx
    obtain ⟨coordinates, hc⟩ := hu x hx
    refine ⟨coordinateBound coordinates, ?_⟩
    intro y hy
    exact hc y (fun i hi => hy i (member_lt_coordinateBound coordinates i hi))

def shift (x : Stream) : Stream := fun i => x (i + 1)

theorem iterate_shift (n : Nat) (x : Stream) (i : Nat) :
    iterate shift n x i = x (i + n) := by
  induction n generalizing i with
  | zero => simp [iterate]
  | succ n ih =>
    change iterate shift n x (i + 1) = x (i + (n + 1))
    rw [ih]
    congr 1
    omega

def PrefixContinuous (f : Stream → Stream) : Prop :=
  ∀ u, PrefixOpen u → PrefixOpen (fun x => u (f x))

theorem shift_continuous : PrefixContinuous shift := by
  intro u hu x hx
  obtain ⟨n, hn⟩ := hu (shift x) hx
  refine ⟨n + 1, ?_⟩
  intro y hy
  apply hn (shift y)
  intro i hi
  exact hy (i + 1) (by omega)

def splice (x y : Stream) (cut : Nat) : Stream :=
  fun i => if i < cut then x i else y (i - cut)

theorem splice_prefix (x y : Stream) (cut : Nat) :
    PrefixEq cut x (splice x y cut) := by
  intro i hi
  simp [splice, hi]

theorem splice_shift (x y : Stream) (cut : Nat) :
    iterate shift cut (splice x y cut) = y := by
  funext i
  rw [iterate_shift]
  simp [splice, show ¬ i + cut < cut by omega]

def TopologicallyTransitive (f : Stream → Stream) : Prop :=
  ∀ u v, PrefixOpen u → PrefixOpen v → (∃ x, u x) → (∃ y, v y) →
    ∃ x n, u x ∧ v (iterate f n x)

theorem shift_transitive : TopologicallyTransitive shift := by
  intro u v hu hv hux hvy
  obtain ⟨x, hx⟩ := hux
  obtain ⟨y, hy⟩ := hvy
  obtain ⟨n, hn⟩ := hu x hx
  refine ⟨splice x y n, n, hn _ (splice_prefix x y n), ?_⟩
  rw [splice_shift]
  exact hy

def repeatPrefix (x : Stream) (n : Nat) : Stream :=
  fun i => x (i % (n + 1))

theorem repeat_agrees (x : Stream) (n : Nat) :
    PrefixEq n x (repeatPrefix x n) := by
  intro i hi
  simp [repeatPrefix, Nat.mod_eq_of_lt (show i < n + 1 by omega)]

theorem repeat_periodic (x : Stream) (n : Nat) :
    iterate shift (n + 1) (repeatPrefix x n) = repeatPrefix x n := by
  funext i
  rw [iterate_shift]
  simp [repeatPrefix]

def DensePeriodic (f : Stream → Stream) : Prop :=
  ∀ u, PrefixOpen u → (∃ x, u x) →
    ∃ y p, u y ∧ 0 < p ∧ iterate f p y = y

theorem shift_dense_periodic : DensePeriodic shift := by
  intro u hu hux
  obtain ⟨x, hx⟩ := hux
  obtain ⟨n, hn⟩ := hu x hx
  exact ⟨repeatPrefix x n, n + 1, hn _ (repeat_agrees x n),
    by omega, repeat_periodic x n⟩

def flipAt (x : Stream) (position : Nat) : Stream :=
  fun i => if i = position then !(x i) else x i

theorem flip_agrees (x : Stream) (n : Nat) : PrefixEq n x (flipAt x n) := by
  intro i hi
  simp [flipAt, show i ≠ n by omega]

theorem flip_separates (x : Stream) (n : Nat) :
    ¬ PrefixEq 1 (iterate shift n x) (iterate shift n (flipAt x n)) := by
  intro h
  have hz := h 0 (by omega)
  simp [iterate_shift, flipAt] at hz

theorem no_isolated_stream (x : Stream) (n : Nat) :
    ∃ y, PrefixEq n x y ∧ y ≠ x := by
  refine ⟨flipAt x n, flip_agrees x n, ?_⟩
  intro h
  have hn := congrFun h n
  simp [flipAt] at hn

theorem singleton_not_open (x : Stream) : ¬ PrefixOpen (fun y => y = x) := by
  intro h
  obtain ⟨n, hn⟩ := h x rfl
  obtain ⟨y, hy, hne⟩ := no_isolated_stream x n
  exact hne (hn y hy)

def spike (position : Nat) : Stream := flipAt (fun _ => false) position

theorem spike_injective (i j : Nat) (h : spike i = spike j) : i = j := by
  by_cases he : i = j
  · exact he
  · have hi := congrFun h i
    simp [spike, flipAt, he] at hi

theorem stream_not_finitely_encoded (n : Nat) (encode : Stream → Fin n) :
    ¬ (∀ x y, encode x = encode y → x = y) := by
  intro hinj
  obtain ⟨i, j, hij, _, he⟩ := finite_collision n (fun t => encode (spike t))
  have heq : i = j := spike_injective i j (hinj _ _ he)
  omega

/-- Uniform prefix sensitivity: the same observation length d works for
    every stream and every finite-prefix neighborhood. -/
def PrefixSensitive (f : Stream → Stream) : Prop :=
  ∃ d, 0 < d ∧ ∀ x n, ∃ y t,
    PrefixEq n x y ∧ ¬ PrefixEq d (iterate f t x) (iterate f t y)

theorem shift_sensitive : PrefixSensitive shift := by
  exact ⟨1, by omega, fun x n => ⟨flipAt x n, n, flip_agrees x n, flip_separates x n⟩⟩

def PrefixDevaneyChaotic (f : Stream → Stream) : Prop :=
  PrefixContinuous f ∧ TopologicallyTransitive f ∧ DensePeriodic f ∧ PrefixSensitive f

theorem binary_shift_chaotic : PrefixDevaneyChaotic shift :=
  ⟨shift_continuous, shift_transitive, shift_dense_periodic, shift_sensitive⟩

end SystemsComplexity.SymbolicDynamics

