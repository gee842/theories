Generative.SelectiveRevision.learned_reading (r : Bool) (a : Option Bool) :
  Generative.FormedGrounds.interpret (Generative.FormedGrounds.observations (Generative.FormedGrounds.trained r))
      (Option.map (Generative.FormedGrounds.encode r) a) =
    a
Generative.SelectiveRevision.prepared_outcome (r : Bool) (a b : Option Bool) (u v g : Bool) :
  Generative.SelectiveRevision.outcome (Generative.SelectiveRevision.prepared r a b u v g) =
    have assessment :=
      Generative.SelectiveRevision.combine (if u = true then a else none) (if v = true then b else none);
    { judgment := assessment.fst, ground := assessment.snd,
      choice := Generative.SelectiveRevision.choose g assessment.fst }
Generative.SelectiveRevision.purpose_preserves_assessment (s : Generative.SelectiveRevision.State) (g : Bool) :
  (Generative.SelectiveRevision.outcome
          (Generative.SelectiveRevision.step (Generative.SelectiveRevision.Event.setPurpose g) s)).judgment =
      (Generative.SelectiveRevision.outcome s).judgment ∧
    (Generative.SelectiveRevision.outcome
          (Generative.SelectiveRevision.step (Generative.SelectiveRevision.Event.setPurpose g) s)).ground =
      (Generative.SelectiveRevision.outcome s).ground
Generative.SelectiveRevision.withdrawal_retains_claim_records (s : Generative.SelectiveRevision.State) (source : Bool) :
  (Generative.SelectiveRevision.step (Generative.SelectiveRevision.Event.withdraw source) s).first = s.first ∧
    (Generative.SelectiveRevision.step (Generative.SelectiveRevision.Event.withdraw source) s).second = s.second ∧
      (Generative.SelectiveRevision.step (Generative.SelectiveRevision.Event.withdraw source) s).calibration =
          s.calibration ∧
        (Generative.SelectiveRevision.step (Generative.SelectiveRevision.Event.withdraw source) s).purpose = s.purpose
Generative.SelectiveRevision.sole_ground_withdrawn (r b g : Bool) :
  Generative.SelectiveRevision.outcome
      (Generative.SelectiveRevision.step (Generative.SelectiveRevision.Event.withdraw false)
        (Generative.SelectiveRevision.prepared r (some b) none true true g)) =
    { judgment := none, ground := Generative.SelectiveRevision.Ground.empty,
      choice := Generative.SelectiveRevision.Choice.check }
Generative.SelectiveRevision.redundant_ground_survives (r b g : Bool) :
  Generative.SelectiveRevision.outcome
      (Generative.SelectiveRevision.step (Generative.SelectiveRevision.Event.withdraw false)
        (Generative.SelectiveRevision.prepared r (some b) (some b) true true g)) =
    { judgment := some b, ground := Generative.SelectiveRevision.Ground.supported,
      choice := Generative.SelectiveRevision.choose g (some b) }
Generative.SelectiveRevision.contrary_reports_conflict (r b g : Bool) :
  Generative.SelectiveRevision.outcome (Generative.SelectiveRevision.prepared r (some b) (some !b) true true g) =
    { judgment := none, ground := Generative.SelectiveRevision.Ground.conflict,
      choice := Generative.SelectiveRevision.Choice.check }
Generative.SelectiveRevision.withdrawing_conflicting_ground (r b g : Bool) :
  Generative.SelectiveRevision.outcome
      (Generative.SelectiveRevision.step (Generative.SelectiveRevision.Event.withdraw false)
        (Generative.SelectiveRevision.prepared r (some b) (some !b) true true g)) =
    { judgment := some !b, ground := Generative.SelectiveRevision.Ground.supported,
      choice := Generative.SelectiveRevision.choose g (some !b) }
Generative.SelectiveRevision.changed_purpose_changes_choice (r b : Bool) :
  Generative.SelectiveRevision.outcome (Generative.SelectiveRevision.prepared r (some b) none true true b) =
      { judgment := some b, ground := Generative.SelectiveRevision.Ground.supported,
        choice := Generative.SelectiveRevision.Choice.select } ∧
    Generative.SelectiveRevision.outcome
        (Generative.SelectiveRevision.step (Generative.SelectiveRevision.Event.setPurpose !b)
          (Generative.SelectiveRevision.prepared r (some b) none true true b)) =
      { judgment := some b, ground := Generative.SelectiveRevision.Ground.supported,
        choice := Generative.SelectiveRevision.Choice.decline }
Generative.SelectiveRevision.joint_recoding_preserves_outcome (r : Bool) (a b : Option Bool) (u v g : Bool) :
  Generative.SelectiveRevision.outcome (Generative.SelectiveRevision.prepared r a b u v g) =
    Generative.SelectiveRevision.outcome (Generative.SelectiveRevision.prepared (!r) a b u v g)
Generative.SelectiveRevision.rails_equal_combine (a b : Option Bool) :
  Generative.SelectiveRevision.rails a b = Generative.SelectiveRevision.combine a b
Generative.SelectiveRevision.conventional_matches_all_states (s : Generative.SelectiveRevision.State) :
  Generative.SelectiveRevision.conventional s = Generative.SelectiveRevision.outcome s
Generative.SelectiveRevision.conventional_matches_every_history (events : List Generative.SelectiveRevision.Event)
  (s : Generative.SelectiveRevision.State) :
  Generative.SelectiveRevision.conventional (Generative.SelectiveRevision.run events s) =
    Generative.SelectiveRevision.outcome (Generative.SelectiveRevision.run events s)
Generative.SelectiveRevision.suspension_hides_different_grounds (r g : Bool) :
  (Generative.SelectiveRevision.outcome (Generative.SelectiveRevision.prepared r none none true true g)).judgment =
      (Generative.SelectiveRevision.outcome
          (Generative.SelectiveRevision.prepared r (some true) (some false) true true g)).judgment ∧
    (Generative.SelectiveRevision.outcome (Generative.SelectiveRevision.prepared r none none true true g)).ground ≠
      (Generative.SelectiveRevision.outcome
          (Generative.SelectiveRevision.prepared r (some true) (some false) true true g)).ground
Generative.SelectiveRevision.supported_copied_mistake (r g : Bool) :
  (Generative.SelectiveRevision.outcome (Generative.SelectiveRevision.copiedMistake r g)).judgment = some true ∧
    (Generative.SelectiveRevision.outcome (Generative.SelectiveRevision.copiedMistake r g)).ground =
        Generative.SelectiveRevision.Ground.supported ∧
      Generative.NormativeActivity.target (Generative.FormedGrounds.mistaken r).native = false
Generative.SelectiveRevision.raw_shape_fails_recoding (b g : Bool) :
  Generative.SelectiveRevision.rawShape (Generative.SelectiveRevision.prepared true (some b) none true true g) ≠
    (Generative.SelectiveRevision.outcome
        (Generative.SelectiveRevision.prepared true (some b) none true true g)).judgment
