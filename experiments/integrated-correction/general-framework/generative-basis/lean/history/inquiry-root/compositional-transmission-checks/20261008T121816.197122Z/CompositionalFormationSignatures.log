Generative.CompositionalFormation.equal_primitive_effects_preserve_extent (c : Generative.CompositionalAcquisition.Code)
  (same : c.second = c.first) (e : Generative.CompositionalAcquisition.Expr) :
  Generative.CompositionalAcquisition.eval c e = List.replicate (Generative.CompositionalFormation.extent e) c.first
Generative.CompositionalFormation.indistinguishable_reversal_preserves_every_expression (b r : Bool)
  (e : Generative.CompositionalAcquisition.Expr) :
  Generative.CompositionalAcquisition.eval { first := b, second := b, reversed := r } e =
    Generative.CompositionalAcquisition.eval { first := b, second := b, reversed := !r } e
