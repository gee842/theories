Generative.CompositionalFormation.accepted_generated_program_transfers (c : Generative.CompositionalAcquisition.Code)
  (route : Generative.CompositionalFormation.Route) (distinct : c.first ≠ c.second)
  (generated : route ∈ Generative.CompositionalFormation.generatedRoutes 2)
  (accepted :
