Generative.CompositionalFormation.old_record_can_admit_wrong_constructed_operation :
  Generative.CompositionalFormation.fits Generative.CompositionalFormation.duplicated
        (Generative.CompositionalAcquisition.trialRecords Generative.CompositionalFormation.collapsed) =
      true ∧
    Generative.CompositionalFormation.operate Generative.CompositionalFormation.duplicated
        Generative.CompositionalAcquisition.novel ≠
      Generative.CompositionalAcquisition.eval Generative.CompositionalFormation.collapsed
        Generative.CompositionalAcquisition.novel
