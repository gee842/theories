FaultTolerantCorrection.certificate_witness (roster : List FaultTolerantCorrection.Domain)
  (faults : FaultTolerantCorrection.Envelope) (supports : FaultTolerantCorrection.Domain → Bool)
  (accepted : FaultTolerantCorrection.certificate roster faults supports = true)
  (bad : List FaultTolerantCorrection.Domain) (admitted : bad ∈ faults) : ∃ d, d ∈ roster ∧ supports d = true ∧ ¬d ∈ bad
FaultTolerantCorrection.certificate_sound (roster : List FaultTolerantCorrection.Domain)
  (faults : FaultTolerantCorrection.Envelope) (supports : FaultTolerantCorrection.Domain → Bool)
  (bad : List FaultTolerantCorrection.Domain) (admitted : bad ∈ faults) (P : Prop)
  (reliable : ∀ (d : FaultTolerantCorrection.Domain), d ∈ roster → ¬d ∈ bad → supports d = true → P)
  (accepted : FaultTolerantCorrection.certificate roster faults supports = true) : P
FaultTolerantCorrection.certificate_available (roster : List FaultTolerantCorrection.Domain)
  (faults : FaultTolerantCorrection.Envelope) (bad : List FaultTolerantCorrection.Domain) (admitted : bad ∈ faults)
  (apart : FaultTolerantCorrection.separated roster faults) (supports : FaultTolerantCorrection.Domain → Bool)
  (responsive : ∀ (d : FaultTolerantCorrection.Domain), d ∈ roster → ¬d ∈ bad → supports d = true) :
  FaultTolerantCorrection.certificate roster faults supports = true
FaultTolerantCorrection.support_contained_in_fault_rejected (roster : List FaultTolerantCorrection.Domain)
  (faults : FaultTolerantCorrection.Envelope) (supports : FaultTolerantCorrection.Domain → Bool)
  (bad : List FaultTolerantCorrection.Domain) (admitted : bad ∈ faults)
  (contained : ∀ (d : FaultTolerantCorrection.Domain), d ∈ roster → supports d = true → d ∈ bad) :
  FaultTolerantCorrection.certificate roster faults supports = false
FaultTolerantCorrection.two_fault_sets_cover_prevents_availability (roster : List FaultTolerantCorrection.Domain)
  (faults : FaultTolerantCorrection.Envelope) (actual possible : List FaultTolerantCorrection.Domain)
  (admitted : possible ∈ faults)
  (cover : ∀ (d : FaultTolerantCorrection.Domain), d ∈ roster → d ∈ actual ∨ d ∈ possible) :
  (FaultTolerantCorrection.certificate roster faults fun d => !actual.contains d) = false
FaultTolerantCorrection.availability_iff_separated (roster : List FaultTolerantCorrection.Domain)
  (faults : FaultTolerantCorrection.Envelope) :
  (∀ (actual : List FaultTolerantCorrection.Domain),
      actual ∈ faults → (FaultTolerantCorrection.certificate roster faults fun d => !actual.contains d) = true) ↔
    FaultTolerantCorrection.separated roster faults
FaultTolerantCorrection.duplicating_roster_gives_no_extra_warrant (roster : List FaultTolerantCorrection.Domain)
  (faults : FaultTolerantCorrection.Envelope) (supports : FaultTolerantCorrection.Domain → Bool) :
  FaultTolerantCorrection.certificate (roster ++ roster) faults supports =
    FaultTolerantCorrection.certificate roster faults supports
FaultTolerantCorrection.no_fault_model_never_certifies (roster : List FaultTolerantCorrection.Domain)
  (supports : FaultTolerantCorrection.Domain → Bool) : FaultTolerantCorrection.certificate roster [] supports = false
