RenewalComparison.consumer_events_not_grounds {W F C : Type} (U : W → RelationalRenewal.Unfolding F C) {w : W} {f : F}
  (consuming : RelationalRenewal.ConsumingIn (U w) f) (t : Nat) :
  ¬(RenewalComparison.relationalInventory U).realized w (f, t)
RenewalComparison.g0_relational {W F C : Type} (U : W → RelationalRenewal.Unfolding F C)
  (PositiveRelevant : W → F × Nat → Prop) :
  GenerativeComparison.G0 (RenewalComparison.relationalInventory U) PositiveRelevant ↔
    ∀ (w : W) (f : F) (t : Nat), (U w).active t f → ¬RelationalRenewal.ConsumingIn (U w) f → PositiveRelevant w (f, t)
RenewalComparison.undisturbed_sustains (L : RelationalRenewal.Law) (gStart : L.needG ≤ L.start) (t : Nat) :
  L.start ≤ RenewalComparison.undisturbed L t
RenewalComparison.absent_dependent (L : RelationalRenewal.Law) :
  RelationalRenewal.Dependent (RenewalComparison.absent L)
RenewalComparison.absent_not_consuming (L : RelationalRenewal.Law) (p : RelationalRenewal.Law.Part) :
  ¬RelationalRenewal.ConsumingIn (RenewalComparison.absent L) p
RenewalComparison.absent_grounds (L : RelationalRenewal.Law) (gStart : L.needG ≤ L.start) (t : Nat) :
  (RenewalComparison.relationalInventory (RenewalComparison.course L)).realized RenewalComparison.Growth.absent
    (RelationalRenewal.Law.Part.sustaining, t)
RenewalComparison.overdraw_relational_extension (L : RelationalRenewal.Law) (positive : 0 < L.needG)
  (fWithin : L.needF ≤ L.needG) (gStart : L.needG ≤ L.start) {T0 : Nat}
  (over : ∀ (t : Nat), T0 ≤ t → L.renew + L.contrib t < L.draw t) :
  GenerativeComparison.GenerativeExtension (RenewalComparison.relationalInventory (RenewalComparison.course L))
    RenewalComparison.Growth.occurs RenewalComparison.Growth.absent
RenewalComparison.overdraw_broad_incomparable (L : RelationalRenewal.Law) (positive : 0 < L.needG)
  (fWithin : L.needF ≤ L.needG) (gStart : L.needG ≤ L.start) {T0 : Nat}
  (over : ∀ (t : Nat), T0 ≤ t → L.renew + L.contrib t < L.draw t) :
  ¬GenerativeComparison.Extends (RenewalComparison.broadInventory (RenewalComparison.course L))
        RenewalComparison.Growth.occurs RenewalComparison.Growth.absent ∧
    ¬GenerativeComparison.Extends (RenewalComparison.broadInventory (RenewalComparison.course L))
        RenewalComparison.Growth.absent RenewalComparison.Growth.occurs
RenewalComparison.overdraw_comparison_ranks (L : RelationalRenewal.Law) (positive : 0 < L.needG)
  (fWithin : L.needF ≤ L.needG) (gStart : L.needG ≤ L.start) {T0 : Nat}
  (over : ∀ (t : Nat), T0 ≤ t → L.renew + L.contrib t < L.draw t)
  (Better : RenewalComparison.Growth → RenewalComparison.Growth → Prop)
  (comparison :
    GenerativeComparison.ComparisonPrinciple (RenewalComparison.relationalInventory (RenewalComparison.course L))
      Better) :
  Better RenewalComparison.Growth.occurs RenewalComparison.Growth.absent ∧
    ((∀ (a b : RenewalComparison.Growth), Better a b → ¬Better b a) →
      ¬Better RenewalComparison.Growth.absent RenewalComparison.Growth.occurs)
RenewalComparison.preferOccurs_only (L : RelationalRenewal.Law) (positive : 0 < L.needG) (fWithin : L.needF ≤ L.needG)
  (gStart : L.needG ≤ L.start) {T0 : Nat} (over : ∀ (t : Nat), T0 ≤ t → L.renew + L.contrib t < L.draw t)
  {a b : RenewalComparison.Growth} (better : RenewalComparison.preferOccurs L a b) :
  a = RenewalComparison.Growth.absent ∧ b = RenewalComparison.Growth.occurs
RenewalComparison.broad_comparison_admits_overdraw (L : RelationalRenewal.Law) (positive : 0 < L.needG)
  (fWithin : L.needF ≤ L.needG) (gStart : L.needG ≤ L.start) {T0 : Nat}
  (over : ∀ (t : Nat), T0 ≤ t → L.renew + L.contrib t < L.draw t) :
  GenerativeComparison.ComparisonPrinciple (RenewalComparison.broadInventory (RenewalComparison.course L))
      (RenewalComparison.preferOccurs L) ∧
    RenewalComparison.preferOccurs L RenewalComparison.Growth.absent RenewalComparison.Growth.occurs ∧
      ¬RenewalComparison.preferOccurs L RenewalComparison.Growth.occurs RenewalComparison.Growth.absent ∧
        (∀ (a : RenewalComparison.Growth), ¬RenewalComparison.preferOccurs L a a) ∧
          ∀ (a b c : RenewalComparison.Growth),
            RenewalComparison.preferOccurs L a b →
              RenewalComparison.preferOccurs L b c → RenewalComparison.preferOccurs L a c
RenewalComparison.malignant_comparison :
  (∀ (Better : RenewalComparison.Growth → RenewalComparison.Growth → Prop),
      GenerativeComparison.ComparisonPrinciple
          (RenewalComparison.relationalInventory (RenewalComparison.course RelationalRenewal.Law.malignant)) Better →
        Better RenewalComparison.Growth.occurs RenewalComparison.Growth.absent) ∧
    GenerativeComparison.ComparisonPrinciple
        (RenewalComparison.broadInventory (RenewalComparison.course RelationalRenewal.Law.malignant))
        (RenewalComparison.preferOccurs RelationalRenewal.Law.malignant) ∧
      RenewalComparison.preferOccurs RelationalRenewal.Law.malignant RenewalComparison.Growth.absent
          RenewalComparison.Growth.occurs ∧
        ¬RenewalComparison.preferOccurs RelationalRenewal.Law.malignant RenewalComparison.Growth.occurs
            RenewalComparison.Growth.absent
RenewalComparison.sharing_grounds (e : RelationalRenewal.Law.Part × Nat) :
  (RenewalComparison.relationalInventory RenewalComparison.contest).realized RenewalComparison.Contest.shares e
RenewalComparison.winning_persists :
  (∀ (t : Nat), RelationalRenewal.Law.winning.unfolding.active t RelationalRenewal.Law.Part.focal) ∧
    (∀ (t : Nat), RelationalRenewal.Law.winning.formed t = t) ∧
      RelationalRenewal.ConsumingIn RelationalRenewal.Law.winning.unfolding RelationalRenewal.Law.Part.focal
RenewalComparison.contest_comparison :
  GenerativeComparison.GenerativeExtension (RenewalComparison.relationalInventory RenewalComparison.contest)
      RenewalComparison.Contest.wins RenewalComparison.Contest.shares ∧
    GenerativeComparison.GenerativeExtension (RenewalComparison.broadInventory RenewalComparison.contest)
        RenewalComparison.Contest.wins RenewalComparison.Contest.shares ∧
      (∀ (t : Nat),
          (RenewalComparison.broadInventory RenewalComparison.contest).realized RenewalComparison.Contest.wins
            (RelationalRenewal.Law.Part.focal, t)) ∧
        ∀ (t : Nat),
          ¬(RenewalComparison.relationalInventory RenewalComparison.contest).realized RenewalComparison.Contest.wins
              (RelationalRenewal.Law.Part.focal, t)
