@Becoming.MachineInstances.segments_of_groups : ∀ {log : List (Option Generative.AcquiredSegmentation.Sound)},
  Becoming.MachineInstances.Groups log →
    ∀ (ws : List Bool),
      Generative.AcquiredSegmentation.chunks (Generative.AcquiredSegmentation.bond log)
          (Generative.AcquiredSegmentation.encode ws) =
        List.map Generative.AcquiredSegmentation.word ws
Becoming.MachineInstances.readForms_eq : ∀ (s : Generative.AcquiredBinding.Lexicon)
  (fs : List (List Generative.AcquiredSegmentation.Sound)),
  Generative.AcquiredBinding.readForms s fs = Becoming.Segmentation.readAll (Generative.AcquiredBinding.resolve s) fs
Becoming.MachineInstances.interprets_every_iff : ∀ (s : Generative.AcquiredBinding.Lexicon),
  Becoming.MachineInstances.Groups s.percept.log →
    ((∀ (ws : List Bool),
        Generative.AcquiredBinding.interpret s (Generative.AcquiredSegmentation.encode ws) =
          Generative.AcquiredSegmentation.assembleMessage (List.map Generative.CompositionalAcquisition.Expr.atom ws)) ↔
      ∀ (b : Bool),
        Generative.AcquiredBinding.resolve s (Generative.AcquiredSegmentation.word b) =
          some (Generative.CompositionalAcquisition.Expr.atom b))
