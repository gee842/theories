ChanceAdequacy.mass_monotone {Ω : Type} (domain : List Ω) (weight : Ω → Nat) (before after : Ω → Bool)
  (included : ChanceAdequacy.IncludedOn domain before after) :
  ChanceAdequacy.mass domain weight before ≤ ChanceAdequacy.mass domain weight after
ChanceAdequacy.positive_added_event_strictly_increases_mass {Ω : Type} (domain : List Ω) (weight : Ω → Nat)
  (before after : Ω → Bool) (included : ChanceAdequacy.IncludedOn domain before after) (h : Ω) (member : h ∈ domain)
  (positive : 0 < weight h) (absent : before h = false) (present : after h = true) :
  ChanceAdequacy.mass domain weight before < ChanceAdequacy.mass domain weight after
ChanceAdequacy.dirac_mass_positive_iff {Ω : Type} [DecidableEq Ω] (domain : List Ω) (h : Ω) (event : Ω → Bool) :
  0 < ChanceAdequacy.mass domain (fun x => if x = h then 1 else 0) event ↔ h ∈ domain ∧ event h = true
ChanceAdequacy.all_weights_preserve_mass_iff {Ω : Type} [DecidableEq Ω] (domain : List Ω) (before after : Ω → Bool) :
  (∀ (weight : Ω → Nat), ChanceAdequacy.mass domain weight before ≤ ChanceAdequacy.mass domain weight after) ↔
    ChanceAdequacy.IncludedOn domain before after
ChanceAdequacy.fulfillment_gives_chance_floor {Ω : Type} (domain : List Ω) (weight : Ω → Nat)
  (demand oldWorks newWorks : Ω → Bool) (positive : 0 < ChanceAdequacy.total domain weight)
  (fulfilled : ChanceAdequacy.Fulfilled domain demand oldWorks newWorks) :
  0 < ChanceAdequacy.total domain weight ∧
    ChanceAdequacy.mass domain weight (ChanceAdequacy.target demand oldWorks) ≤
        ChanceAdequacy.mass domain weight newWorks ∧
      ChanceAdequacy.mass domain weight newWorks ≤ ChanceAdequacy.total domain weight
ChanceAdequacy.repair_covers_target_and_candidate {Ω : Type} (domain : List Ω) (demand oldWorks candidate : Ω → Bool) :
  ChanceAdequacy.Fulfilled domain demand oldWorks (ChanceAdequacy.repair demand oldWorks candidate) ∧
    ChanceAdequacy.IncludedOn domain candidate (ChanceAdequacy.repair demand oldWorks candidate)
ChanceAdequacy.repair_adds_positive_new_protection {Ω : Type} (domain : List Ω) (weight : Ω → Nat)
  (demand oldWorks candidate : Ω → Bool) (h : Ω) (member : h ∈ domain) (positive : 0 < weight h)
  (notOldTarget : ChanceAdequacy.target demand oldWorks h = false) (added : candidate h = true) :
  ChanceAdequacy.mass domain weight (ChanceAdequacy.target demand oldWorks) <
    ChanceAdequacy.mass domain weight (ChanceAdequacy.repair demand oldWorks candidate)
ChanceAdequacy.positive_chance_can_miss_due_protection :
  (ChanceAdequacy.total [false, true] fun x => 1) = 2 ∧
    ChanceAdequacy.mass [false, true] (fun x => 1) (ChanceAdequacy.target (fun x => true) not) = 1 ∧
      (ChanceAdequacy.mass [false, true] (fun x => 1) fun h => h) = 1 ∧
        (¬ChanceAdequacy.Fulfilled [false, true] (fun x => true) not fun h => h) ∧
          ChanceAdequacy.target (fun x => true) not false = true ∧ (fun h => h) false = false ∧ 0 < (fun x => 1) false
