GoalRevision.acquired_selection_evidence_matters :
  (GoalRevision.run GoalRevision.initial (GoalRevision.fullHistory GoalRevision.Meter.creditInflated true true)).goal =
      some GoalRevision.Goal.capacity ∧
    (GoalRevision.run GoalRevision.initial
            (GoalRevision.fullHistory GoalRevision.Meter.creditInflated true true)).judgment =
        some GoalRevision.Goal.capacity ∧
      (GoalRevision.run GoalRevision.initial
              (GoalRevision.fullHistory GoalRevision.Meter.creditInflated true true)).rule =
          GoalRevision.Rule.volume ∧
        (GoalRevision.run GoalRevision.initial
                (GoalRevision.fullHistory GoalRevision.Meter.creditInflated true true)).fulfilled =
            7 ∧
          GoalRevision.success.fulfilled = 8
