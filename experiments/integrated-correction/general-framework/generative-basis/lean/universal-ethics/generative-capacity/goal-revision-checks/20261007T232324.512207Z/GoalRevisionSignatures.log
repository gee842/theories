GoalRevision.unnecessary_reform_is_not_forced :
  (GoalRevision.run GoalRevision.initial
          (GoalRevision.preparation GoalRevision.Meter.faithful true ++ [GoalRevision.Event.reform 3] ++
            GoalRevision.continuation 3)).rule =
      GoalRevision.Rule.volume ∧
    (GoalRevision.run GoalRevision.initial
          (GoalRevision.preparation GoalRevision.Meter.faithful true ++ [GoalRevision.Event.reform 3] ++
            GoalRevision.continuation 3)).fulfilled =
      3
