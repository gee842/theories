+DNS_KINDS = {'non-implication', 'converse', 'correspondence', 'scope'}
+V2_LISTS = ('does_not_show', 'not_required', 'progress', 'laws', 'standard_boundaries', 'text_versions')
+
+
+def standard_boundaries():
+    """Shared boundary sentences, defined once and referenced by key."""
+    config = json.loads((ROOT / '_process/research-config.json').read_text())
+    path = config.get('standard_boundaries')
+    return json.loads((ROOT / path).read_text())['boundaries'] if path else {}
+
+
+def validate_v2(r):
+    """Structure of schema 2; readability rules come from style.lint (errors for v2)."""
+    from tools.research import style
+    errors = []
+    if 'limitations' in r:
+        errors.append('schema 2 replaces limitations with does_not_show / hypotheses / standard_boundaries')
+    if 'claim' in r and not pair(r['claim']):
+        errors.append('claim, when present, requires nonempty Chinese and English')
+    for key in V2_LISTS:
+        if not isinstance(r.get(key, []), list):
+            errors.append(f'{key} must be a list')
+            return errors
+    for key in ('does_not_show', 'not_required', 'progress', 'laws'):
+        for item in r.get(key, []):
+            if not pair(item):
+                errors.append(f'{key} items require nonempty Chinese and English')
+    paths = {x.get('path') for x in r.get('references', []) if isinstance(x, dict)}
+    declared = {d for x in r.get('references', []) if isinstance(x, dict) for d in x.get('declarations', [])}
+    for item in r.get('does_not_show', []):
+        if item.get('kind', 'non-implication') not in DNS_KINDS:
+            errors.append(f'does_not_show kind must be one of {sorted(DNS_KINDS)}')
+        if 'witness' in item and item['witness'] not in declared | set(r.get('aliases', [])):
+            errors.append(f'does_not_show witness is not a declared reference: {item["witness"]}')
+    for item in r.get('progress', []):
+        source, _, anchor = item.get('source', '').partition('#')
+        if source not in paths:
+            errors.append(f'progress source must be a hashed reference: {source}')
+        elif anchor:
+            from tools.research.reading_catalogue import anchors
+            if anchor not in anchors(ROOT / source):
+                errors.append(f'progress anchor missing: {item["source"]}')
+    for item in r.get('laws', []):
+        unknown = [d for d in item.get('declarations', []) if d not in declared]
+        if unknown:
+            errors.append('law names undeclared references: ' + ', '.join(unknown))
+    known = standard_boundaries()
+    for key in r.get('standard_boundaries', []):
+        if key not in known:
+            errors.append(f'unknown standard boundary {key}')
+    for version in r.get('text_versions', []):
+        p = path_in_repo(version.get('path'))
+        if p is None or digest(p) != version.get('sha256'):
+            errors.append(f'text version missing or changed: {version.get("path")}')
+    errors += [f'{f["field"]}: {f["rule"]}: {f["detail"]}' for f in style.lint(r) if f['severity'] == 'error']
+    return errors
+
+
+def render_record_v2(r):
+    """Result first, then exact conditions; logs and sources collapsed."""
+    base = record_path(r).parent
+    def result_link(ident):
+        target = r.get('_record_links', {}).get(ident)
